# Copie este arquivo para .env (ignorado pelo Git) e preencha os segredos reais
IMAGE_TAG=1.0.0
ALLOWED_HOSTS=bi.jtecsistemas.com.br;localhost;127.0.0.1
JT_BASE_API_URL=https://api.jtecsistemas.com.br

# IMPORTANTE: Nunca use o login 'sa'. Use um login dedicado somente-leitura no EDW/BI
JT_SQL_CONNECTION_STRING=Server=IP_INTERNO_OU_VPS;Database=JTSis_Sistemas;User Id=jt_bi_reader;Password=SENHA_FORTE_AQUI;TrustServerCertificate=True;

# Configuração Firebase (restringir API Key por domínio no Google Cloud Console)
JT_FIREBASE_PROJECT_ID=controlefinanceiro-35e2a
JT_FIREBASE_API_KEY=SUA_FIREBASE_API_KEY_AQUI

