<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="new[] { typeof(JT_UserInterface.Shared._Imports).Assembly }"
        NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @{
            var pageName = routeData.PageType.Name;
            var effectiveRouteData = (pageName == "OrigensDados" || pageName == "IndicadoresDashboard" || pageName == "Dashboard")
                ? new RouteData(typeof(Pages.BIDashboardPage), new Dictionary<string, object?>())
                : routeData;
        }
        <RouteView RouteData="effectiveRouteData" DefaultLayout="typeof(JT_BI.Components.Layout.BILayout)" />
        <FocusOnNavigate RouteData="effectiveRouteData" Selector="h1" />
    </Found>
</Router>
