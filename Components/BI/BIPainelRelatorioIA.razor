@using System.Text.Json
@using System.Text.RegularExpressions
@using JT_BI.Models
@using JT_BI.Services
@using JT_Classes.IA
@using JT_Servicos.IA
@inject ConfiguracaoIAService ConfigIAService
@inject IBIMineracaoAgenteService MineracaoAgenteService
@inject IBIDataMiningService MiningService
@inject IHttpClientFactory HttpClientFactory

<div class="painel-relatorio-ia card border-0 shadow mb-4" style="border-radius: 20px; overflow: hidden; border: 1px solid rgba(226, 232, 240, 0.8) !important;">
    <!-- 1. Cabeçalho Executivo Ultra Premium (Estilo JT_Food Insights) -->
    <div class="card-header p-4 position-relative text-white"
         style="background: linear-gradient(135deg, #090d16 0%, #1e1b4b 45%, #312e81 80%, #2563eb 100%); border-bottom: none;">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="ai-spark-box shadow">
                    <i class="bi bi-stars"></i>
                </div>
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h4 class="mb-0 fw-bold ai-title" style="color: #ffffff !important; letter-spacing: -0.02em;">
                            Consultor Executivo IA <span class="ai-brand-badge">— @(string.IsNullOrWhiteSpace(Dashboard?.Nome) ? "JT_BI Insights" : $"{Dashboard.Nome} Insights")</span>
                        </h4>
                        <span class="badge rounded-pill ai-status-badge">
                            <span class="ai-pulse-dot"></span> Motor Ativo
                        </span>
                    </div>
                    <p class="mb-0 small ai-subtitle" style="color: rgba(226, 232, 240, 0.9) !important;">
                        Diagnósticos inteligentes, segmentação de clientes e detecção em tempo real de padrões e oportunidades analíticas
                    </p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-ai-refresh shadow-sm"
                        @onclick='() => ExecutarGeracaoAsync(abaAtiva)'
                        disabled="@gerando"
                        title="Atualizar análise com dados em tempo real">
                    @if (gerando)
                    {
                        <span class="spinner-border spinner-border-sm me-1.5" role="status"></span>
                        <span>Processando Dados...</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-repeat me-1.5"></i>
                        <span>Atualizar Diagnóstico</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- 2. Barra de Abas Estratégicas -->
    <div class="ai-tabs-bar p-3 d-flex flex-wrap gap-2.5 align-items-center border-bottom">
        <button class="ai-tab-btn @(abaAtiva == "geral" ? "active-geral" : "inactive")"
                @onclick='() => ExecutarGeracaoAsync("geral")'
                disabled="@gerando">
            <i class="bi bi-pie-chart-fill"></i>
            <span>Diagnóstico 360°</span>
        </button>

        <button class="ai-tab-btn @(abaAtiva == "segmentacao" ? "active-combos" : "inactive")"
                @onclick='() => ExecutarGeracaoAsync("segmentacao")'
                disabled="@gerando">
            <i class="bi bi-fire"></i>
            <span>Segmentação &amp; Pareto (K-Means/ABC)</span>
        </button>

        <button class="ai-tab-btn @(abaAtiva == "churn" ? "active-kds" : "inactive")"
                @onclick='() => ExecutarGeracaoAsync("churn")'
                disabled="@gerando">
            <i class="bi bi-shield-exclamation"></i>
            <span>Previsão de Riscos &amp; Churn</span>
        </button>

        <div class="ms-auto d-none d-md-flex align-items-center text-muted small">
            <i class="bi bi-shield-check text-success me-1"></i>
            <span>Dados protegidos e consolidados localmente</span>
        </div>
    </div>

    <!-- 3. Área de Conteúdo / Relatório -->
    <div class="card-body p-4">
        @if (!string.IsNullOrEmpty(erroGeracao))
        {
            <div class="alert alert-info border-0 shadow-sm rounded-3 p-3 mb-4 d-flex align-items-center justify-content-between" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                    <span class="small fw-medium">@erroGeracao</span>
                </div>
                <button type="button" class="btn-close btn-close-sm" @onclick="() => erroGeracao = null"></button>
            </div>
        }

        @if (gerando)
        {
            <div class="text-center py-5">
                <div class="ai-loading-pulse mb-3">
                    <div class="pulse-ring ring-1"></div>
                    <div class="pulse-ring ring-2"></div>
                    <div class="pulse-core">
                        <i class="bi bi-stars fs-3 text-white"></i>
                    </div>
                </div>
                <h5 class="fw-bold mt-3 mb-1 text-body">A IA está processando os indicadores do painel...</h5>
                <p class="text-muted small mb-0">Cruzando dados de KPIs, segmentação de grupos, curva de Pareto e probabilidades preditivas.</p>
            </div>
        }
        else if (string.IsNullOrEmpty(conteudoRelatorio))
        {
            <div class="text-center py-5 text-muted">
                <div class="rounded-circle bg-light d-inline-flex p-4 mb-3">
                    <i class="bi bi-robot fs-1 text-primary opacity-50"></i>
                </div>
                <h6 class="fw-bold text-body mb-1">Nenhum diagnóstico gerado ainda</h6>
                <p class="small text-muted mb-3">Clique no botão abaixo para gerar uma análise executiva completa dos dados deste painel.</p>
                <button class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm" @onclick='() => ExecutarGeracaoAsync("geral")'>
                    <i class="bi bi-stars me-1.5"></i> Gerar Primeiro Relatório
                </button>
            </div>
        }
        else
        {
            <div class="relatorio-conteudo-wrapper">
                @((MarkupString)ConverterMarkdownParaHtml(conteudoRelatorio))
            </div>
        }
    </div>
</div>

