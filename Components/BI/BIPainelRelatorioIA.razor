    private string ConverterMarkdownParaHtml(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return "";

        var lines = markdown.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
        var sb = new System.Text.StringBuilder();
        bool inList = false;
        bool inSection = false;

        foreach (var rawLine in lines)
        {
            var line = rawLine.Trim();

            if (string.IsNullOrWhiteSpace(line))
            {
                if (inList)
                {
                    sb.AppendLine("</ul>");
                    inList = false;
                }
                continue;
            }

            if (line.StartsWith("### "))
            {
                if (inList) { sb.AppendLine("</ul>"); inList = false; }
                if (inSection) { sb.AppendLine("</div>"); }

                string title = FormatarTextoInline(line.Substring(4));
                sb.AppendLine("<div class=\"ai-section-box\">");
                sb.AppendLine($"<div class=\"ai-section-title\"><i class=\"bi bi-stars text-primary\"></i><span>{title}</span></div>");
                inSection = true;
            }
            else if (line.StartsWith("#### "))
            {
                if (inList) { sb.AppendLine("</ul>"); inList = false; }
                string subtitle = FormatarTextoInline(line.Substring(5));
                sb.AppendLine($"<div class=\"ai-category-title\"><i class=\"bi bi-arrow-right-short text-primary fs-5\"></i><span>{subtitle}</span></div>");
            }
            else if (line.StartsWith("- ") || line.StartsWith("* "))
            {
                if (!inList)
                {
                    sb.AppendLine("<ul class=\"ai-insight-list\">");
                    inList = true;
                }
                string item = FormatarTextoInline(line.Substring(2));
                sb.AppendLine($"<li class=\"ai-insight-item\"><i class=\"bi bi-check-circle-fill text-primary me-2 opacity-75\"></i>{item}</li>");
            }
            else
            {
                if (inList) { sb.AppendLine("</ul>"); inList = false; }
                string p = FormatarTextoInline(line);
                if (p.StartsWith("<em>") && p.EndsWith("</em>"))
                {
                    sb.AppendLine($"<span class=\"ai-meta-tag\"><i class=\"bi bi-clock-history me-1\"></i>{p}</span>");
                }
                else
                {
                    sb.AppendLine($"<p class=\"mb-2 text-body\">{p}</p>");
                }
            }
        }

        if (inList)
        {
            sb.AppendLine("</ul>");
        }
        if (inSection)
        {
            sb.AppendLine("</div>");
        }

        return sb.ToString();
    }

    private string FormatarTextoInline(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";

        // Negrito: **texto**
        var rxBold = new Regex(@"\*\*(.+?)\*\*");
        text = rxBold.Replace(text, "<strong>$1</strong>");

        // Itálico: *texto*
        var rxItalic = new Regex(@"(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)");
        text = rxItalic.Replace(text, "<em>$1</em>");

        return text;
    }
