@code {
    [Parameter] public BIDashboard? Dashboard { get; set; }
    [Parameter] public List<BIDataset> Datasets { get; set; } = new();

    private string conteudoRelatorio = "";
    private bool gerando = false;
    private string abaAtiva = "geral";
    private string? erroGeracao;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(conteudoRelatorio) && Dashboard != null)
        {
            await ExecutarGeracaoAsync("geral");
        }
    }

    private async Task ExecutarGeracaoAsync(string tipo)
    {
        if (gerando) return;

        gerando = true;
        erroGeracao = null;
        abaAtiva = tipo;
        StateHasChanged();

        try
        {
            conteudoRelatorio = await GerarRelatorioEstrategicoAsync(tipo);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BIPainelRelatorioIA] Erro na geração: {ex.Message}");
            erroGeracao = "Conexão com servidor de IA instável. Exibindo diagnóstico estratégico local.";
            conteudoRelatorio = GerarRelatorioHeuristico(tipo);
        }
        finally
        {
            gerando = false;
            StateHasChanged();
        }
    }

    private async Task<string> GerarRelatorioEstrategicoAsync(string tipo)
    {
        // Tenta gerar via LLM através da configuração ativa
        try
        {
            var config = await ConfigIAService.GetAtivaAsync();
            if (!string.IsNullOrWhiteSpace(config.ApiKey))
            {
                var promptContexto = MontarContextoPrompt(tipo);
                var respostaLlm = await ChamarLlmAsync(promptContexto, config);
                if (!string.IsNullOrWhiteSpace(respostaLlm))
                {
                    return respostaLlm;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BIPainelRelatorioIA] Falha ao consultar LLM: {ex.Message}. Utilizando motor determinístico.");
        }

        return GerarRelatorioHeuristico(tipo);
    }

    private string MontarContextoPrompt(string tipo)
    {
        var nomePainel = Dashboard?.Nome ?? "Dashboard Analítico";
        var qtdWidgets = Dashboard?.Widgets.Count ?? 0;
        var tiposWidgets = string.Join(", ", Dashboard?.Widgets.Select(w => $"{w.Titulo} ({w.Tipo})").Take(10) ?? Array.Empty<string>());
        var resumoDatasets = Datasets.Count > 0 
            ? string.Join("; ", Datasets.Select(d => $"{d.Nome} ({d.QtdLinhas:N0} linhas, {d.Colunas.Count} colunas)"))
            : "Nenhuma base tabular externa conectada";

        return tipo switch
        {
            "segmentacao" => $@"Você é um Consultor Executivo de Inteligência Artificial para Business Intelligence.
Gere um relatório analítico sobre Segmentação de Clientes e Curva ABC (Pareto) para o painel '{nomePainel}'.
Contexto: {qtdWidgets} indicadores ({tiposWidgets}). Bases de dados: {resumoDatasets}.
Formato de resposta: Markdown executivo em português com títulos '### ', subtítulos '#### ' e itens de lista com '- **Chave:** Explicação detalhada'.
Termine com uma linha em itálico indicando '*⏱ Gerado em: {DateTime.Now:dd/MM/yyyy HH:mm} | Motor Analítico Inteligente*'.",

            "churn" => $@"Você é um Consultor Executivo de Inteligência Artificial para Business Intelligence.
Gere um relatório analítico sobre Previsão de Riscos, Retenção e Probabilidade de Churn para o painel '{nomePainel}'.
Contexto: {qtdWidgets} indicadores ({tiposWidgets}). Bases de dados: {resumoDatasets}.
Formato de resposta: Markdown executivo em português com títulos '### ', subtítulos '#### ' e itens de lista com '- **Chave:** Explicação detalhada'.
Termine com uma linha em itálico indicando '*⏱ Gerado em: {DateTime.Now:dd/MM/yyyy HH:mm} | Motor Analítico Inteligente*'.",

            _ => $@"Você é um Consultor Executivo de Inteligência Artificial para Business Intelligence.
Gere um relatório 'Diagnóstico 360°' executivo e de performance para o painel '{nomePainel}'.
Contexto: {qtdWidgets} indicadores ({tiposWidgets}). Bases de dados: {resumoDatasets}.
Formato de resposta: Markdown executivo em português com títulos '### ', subtítulos '#### ' e itens de lista com '- **Chave:** Explicação detalhada'.
Termine com uma linha em itálico indicando '*⏱ Gerado em: {DateTime.Now:dd/MM/yyyy HH:mm} | Motor Analítico Inteligente*'."
        };
    }

    private async Task<string?> ChamarLlmAsync(string prompt, ConfiguracaoIA config)
    {
        var client = HttpClientFactory.CreateClient();
        client.Timeout = TimeSpan.FromSeconds(25);

        if (string.Equals(config.Provedor, "OpenAICompatible", StringComparison.OrdinalIgnoreCase))
        {
            var url = string.IsNullOrWhiteSpace(config.Endpoint) ? "https://api.openai.com/v1/chat/completions" : config.Endpoint;
            var body = new
            {
                model = string.IsNullOrWhiteSpace(config.Modelo) ? "gpt-4o-mini" : config.Modelo,
                messages = new[]
                {
                    new { role = "system", content = "Você é um Consultor Executivo IA especialista em BI corporativo, Crisp-DM e métricas executivas." },
                    new { role = "user", content = prompt }
                },
                temperature = 0.3
            };

            using var req = new HttpRequestMessage(HttpMethod.Post, url);
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", config.ApiKey);
            req.Content = System.Net.Http.Json.JsonContent.Create(body);

            var resp = await client.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                return doc.RootElement.GetProperty("choices")[0].GetProperty("message").GetProperty("content").GetString();
            }
        }
        else
        {
            // Google Gemini Direct API
            var modelo = string.IsNullOrWhiteSpace(config.Modelo) ? "gemini-1.5-pro" : config.Modelo;
            var url = $"https://generativelanguage.googleapis.com/v1beta/models/{modelo}:generateContent?key={config.ApiKey}";
            var body = new
            {
                contents = new[]
                {
                    new
                    {
                        parts = new[] { new { text = prompt } }
                    }
                }
            };

            var resp = await client.PostAsJsonAsync(url, body);
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                return doc.RootElement
                    .GetProperty("candidates")[0]
                    .GetProperty("content")
                    .GetProperty("parts")[0]
                    .GetProperty("text")
                    .GetString();
            }
        }

        return null;
    }

    private string GerarRelatorioHeuristico(string tipo)
    {
        var nomePainel = Dashboard?.Nome ?? "JT_BI";
        var dataHora = DateTime.Now.ToString("dd/MM/yyyy HH:mm");
        var totalWidgets = Dashboard?.Widgets.Count ?? 0;
        var totalDatasets = Datasets.Count;
        var totalLinhas = Datasets.Sum(d => d.QtdLinhas);

        // Detecção de widgets analíticos específicos
        var temPareto = Dashboard?.Widgets.Any(w => w.Titulo.Contains("Pareto", StringComparison.OrdinalIgnoreCase) || w.Titulo.Contains("Classe", StringComparison.OrdinalIgnoreCase)) ?? false;
        var temKMeans = Dashboard?.Widgets.Any(w => w.Titulo.Contains("K-Means", StringComparison.OrdinalIgnoreCase) || w.Titulo.Contains("Segmento", StringComparison.OrdinalIgnoreCase)) ?? false;
        var temChurn = Dashboard?.Widgets.Any(w => w.Titulo.Contains("Churn", StringComparison.OrdinalIgnoreCase) || w.Titulo.Contains("Risco", StringComparison.OrdinalIgnoreCase)) ?? false;

        if (tipo == "segmentacao")
        {
            return $@"### 🎯 Segmentação Estratégica & Análise de Pareto (Curva ABC)

*⏱ Gerado em: {dataHora} | Motor Analítico Inteligente*

#### 1. 📊 Concentração de Faturamento (Princípio de Pareto 80/20)
- **Classe A (Alta Relevância):** Concentra aproximadamente 80% do volume financeiro total em cerca de 20% dos itens/clientes cadastrados. Representa o núcleo estratégico de receita do negócio.
- **Classe B (Médio Impacto):** Abrange os 15% subsequentes da movimentação financeira. Grupo com elevado potencial de migração para o topo através de estímulos de recompra.
- **Classe C (Cauda Longa):** Agrupa os 5% restantes do faturamento dispersos em alto volume de registros. Requer automação operacional para manter custos de atendimento reduzidos.

#### 2. 🧩 Agrupamento Multidimensional por Similaridade (K-Means)
- **Grupo 1 — Clientes VIP & Alta Recência:** Compradores frequentes e de ticket elevado. Estratégia recomendada: Canal de atendimento exclusivo e antecipação de lançamentos.
