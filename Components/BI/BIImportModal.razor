@using System.Text
@using JT_BI.Models
@using JT_BI.Services
@using JT_Classes.Acessos
@using Microsoft.AspNetCore.Components.Forms
@inject IBIImportService ImportService
@inject IBIDashboardService DashboardService
@inject CurrentUserState UserState
@inject IHttpClientFactory HttpClientFactory

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); z-index: 1055;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-2xl rounded-4 overflow-hidden">
                <div class="modal-header bg-gradient bg-primary text-white p-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 bg-white bg-opacity-20 rounded-3">
                            <i class="bi bi-file-earmark-arrow-up fs-5 text-white"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">Importar Dados Externos</h5>
                            <small class="text-white-50">Envie um arquivo, informe um link ou cole os dados</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="Fechar"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label class="form-label fw-semibold small text-muted">Nome do Conjunto de Dados:</label>
                            <input type="text" class="form-control form-control-sm" @bind="nomeDataset" placeholder="Ex: Vendas 2026, Clientes, Despesas Mensais..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small text-muted">Formato dos Dados:</label>
                            <select class="form-select form-select-sm" @bind="formato">
                                <option value="CSV">CSV / TSV</option>
                                <option value="JSON">JSON (array de objetos)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <ul class="nav nav-pills nav-fill gap-1 bg-body-tertiary p-1 rounded-3 small">
                                <li class="nav-item">
                                    <button type="button" class="nav-link py-1 @(abaOrigem == "arquivo" ? "active" : "")" @onclick='() => abaOrigem = "arquivo"'>
                                        <i class="bi bi-upload me-1"></i> Arquivo
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button type="button" class="nav-link py-1 @(abaOrigem == "link" ? "active" : "")" @onclick='() => abaOrigem = "link"'>
                                        <i class="bi bi-link-45deg me-1"></i> Link (URL)
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button type="button" class="nav-link py-1 @(abaOrigem == "colar" ? "active" : "")" @onclick='() => abaOrigem = "colar"'>
                                        <i class="bi bi-clipboard-data me-1"></i> Colar
                                    </button>
                                </li>
                            </ul>
                        </div>

                        @if (abaOrigem == "arquivo")
                        {
                            <div class="col-12">
                                <label class="form-label fw-semibold small text-muted">Selecione um arquivo CSV ou JSON (até 10 MB):</label>
                                <InputFile OnChange="AoSelecionarArquivo" accept=".csv,.tsv,.txt,.json,text/csv,application/json" class="form-control form-control-sm" disabled="@carregandoArquivo" />
                                @if (carregandoArquivo)
                                {
                                    <div class="small text-muted mt-1">
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span> Lendo arquivo...
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(arquivoNome))
                                {
                                    <div class="small text-success mt-1">
                                        <i class="bi bi-check-circle-fill me-1"></i>@arquivoNome
                                    </div>
                                }
                                <div class="small text-muted mt-1">
                                    O formato é detectado automaticamente e o nome do arquivo sugere o nome do dataset.
                                </div>
                            </div>
                        }
                        else if (abaOrigem == "link")
                        {
                            <div class="col-12">
                                <label class="form-label fw-semibold small text-muted">URL pública do CSV ou JSON:</label>
                                <div class="input-group input-group-sm">
                                    <input type="url" class="form-control" @bind="urlOrigem" placeholder="https://exemplo.com/dados.csv" disabled="@baixandoUrl" />
                                    <button type="button" class="btn btn-outline-primary" @onclick="BaixarUrlAsync" disabled="@(baixandoUrl || string.IsNullOrWhiteSpace(urlOrigem))">
                                        @if (baixandoUrl)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-cloud-arrow-down me-1"></i>
                                            <span>Baixar</span>
                                        }
                                    </button>
                                </div>
                                <div class="small text-muted mt-1">
                                    Aceita apenas HTTP/HTTPS. Limite de 10 MB. Links que exigem autenticação não são suportados.
                                </div>
                                @if (linkCarregado)
                                {
                                    <div class="small text-success mt-1">
                                        <i class="bi bi-check-circle-fill me-1"></i>Conteúdo baixado de @urlOrigem
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="col-12">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <label class="form-label fw-semibold small text-muted mb-0">Cole os dados brutos (até 500 KB; para arquivos até 10 MB use a aba Arquivo):</label>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="CarregarExemplo">
                                        <i class="bi bi-magic me-1"></i> Preencher Exemplo de Vendas
                                    </button>
                                </div>
                                <textarea class="form-control font-monospace" rows="7" maxlength="500000" @bind="conteudoBruto" @bind:after="DetectarFormato" placeholder="Cole aqui o conteúdo CSV ou JSON..." style="font-size: 0.82rem;"></textarea>
                            </div>
                        }

                        @if (datasetPreview != null && datasetPreview.Linhas.Count > 0)
                        {
                            <div class="col-12">
                                <div class="card border border-success border-opacity-25 bg-success bg-opacity-10 rounded-3 p-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                            <span class="fw-bold text-success">Dados identificados com sucesso!</span>
                                            <span class="badge bg-success">@datasetPreview.QtdLinhas linhas</span>
                                            <span class="badge bg-secondary">@datasetPreview.Colunas.Count colunas</span>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var col in datasetPreview.Colunas)
                                        {
                                            <span class="badge bg-body-secondary text-body border">
                                                <i class="bi @(col.TipoDado == "Numero" ? "bi-123 text-primary" : "bi-fonts text-muted") me-1"></i>
                                                @col.Nome (@col.TipoDado)
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(mensagemErro))
                        {
                            <div class="col-12">
                                <div class="alert alert-danger py-2 small mb-0">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @mensagemErro
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer bg-light p-3 border-0 d-flex justify-content-between">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Fechar">Cancelar</button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ProcessarPreview" disabled="@(string.IsNullOrWhiteSpace(conteudoBruto))">
                            <i class="bi bi-eye me-1"></i> Pré-visualizar
                        </button>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="SalvarEGerarDashboardAsync" disabled="@(string.IsNullOrWhiteSpace(conteudoBruto))">
                            <i class="bi bi-speedometer2 me-1"></i> Gerar Dashboard Automático
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const long LimiteBytes = 10 * 1024 * 1024;

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<BIDashboard> OnDashboardCriado { get; set; }

    private string abaOrigem = "arquivo";
    private string nomeDataset = "Dataset Vendas 2026";
    private string formato = "CSV";
    private string conteudoBruto = "";
    private string urlOrigem = "";
    private string arquivoNome = "";
    private bool linkCarregado;
    private bool carregandoArquivo;
    private bool baixandoUrl;
    private string? mensagemErro = null;
    private BIDataset? datasetPreview = null;

    private void CarregarExemplo()
    {
        abaOrigem = "colar";
        nomeDataset = "Vendas Filiais 2026";
        formato = "CSV";
        conteudoBruto = "Mes;Canal;Faturamento;QtdVendas;TicketMedio\r\n" +
            "Janeiro;Loja Fisica;84500;940;89.89\r\n" +
            "Janeiro;Ecommerce;52100;620;84.03\r\n" +
            "Fevereiro;Loja Fisica;91200;1020;89.41\r\n" +
            "Fevereiro;Ecommerce;63400;710;89.29\r\n" +
            "Marco;Loja Fisica;98400;1090;90.27\r\n" +
            "Marco;Ecommerce;74100;830;89.27\r\n" +
            "Abril;Loja Fisica;104500;1150;90.86\r\n" +
            "Abril;Ecommerce;81200;890;91.23";
        ProcessarPreview();
    }

    private void DetectarFormato()
    {
        if (string.IsNullOrWhiteSpace(conteudoBruto)) return;

        var inicio = conteudoBruto.TrimStart();
        formato = inicio.StartsWith("[") || inicio.StartsWith("{") ? "JSON" : "CSV";
    }

    private async Task AoSelecionarArquivo(InputFileChangeEventArgs e)
    {
        mensagemErro = null;
        datasetPreview = null;
        linkCarregado = false;
        arquivoNome = "";

        var arquivo = e.File;
        if (arquivo == null) return;

        if (arquivo.Size > LimiteBytes)
        {
            mensagemErro = "O arquivo excede o limite de 10 MB.";
            return;
        }

        carregandoArquivo = true;
        try
        {
            await using var stream = arquivo.OpenReadStream(LimiteBytes);
            using var reader = new StreamReader(stream);
            conteudoBruto = await reader.ReadToEndAsync();

            arquivoNome = arquivo.Name;
            if (string.IsNullOrWhiteSpace(nomeDataset) || nomeDataset.StartsWith("Dataset ", StringComparison.OrdinalIgnoreCase))
            {
                var baseNome = System.IO.Path.GetFileNameWithoutExtension(arquivo.Name);
                if (!string.IsNullOrWhiteSpace(baseNome))
                    nomeDataset = baseNome;
            }

            DetectarFormato();
            ProcessarPreview();
        }
        catch (Exception ex)
        {
            mensagemErro = $"Não foi possível ler o arquivo: {ex.Message}";
        }
        finally
        {
            carregandoArquivo = false;
        }
    }

    private async Task BaixarUrlAsync()
    {
        mensagemErro = null;
        datasetPreview = null;
        linkCarregado = false;
        urlOrigem = urlOrigem?.Trim() ?? string.Empty;

        if (!Uri.TryCreate(urlOrigem, UriKind.Absolute, out var uri) ||
            (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            mensagemErro = "Informe uma URL válida começando com http:// ou https://.";
            return;
        }

        baixandoUrl = true;
        try
        {
            var client = HttpClientFactory.CreateClient();
            using var resposta = await client.GetAsync(uri, HttpCompletionOption.ResponseHeadersRead);

            if (!resposta.IsSuccessStatusCode)
            {
                mensagemErro = $"O servidor retornou {(int)resposta.StatusCode} ({resposta.ReasonPhrase}).";
                return;
            }

            var tamanho = resposta.Content.Headers.ContentLength;
            if (tamanho.HasValue && tamanho.Value > LimiteBytes)
            {
                mensagemErro = "O conteúdo do link excede o limite de 10 MB.";
                return;
            }

            await using var stream = await resposta.Content.ReadAsStreamAsync();
            conteudoBruto = await LerTextoLimitadoAsync(stream);

            linkCarregado = true;
            arquivoNome = "";

            if (string.IsNullOrWhiteSpace(nomeDataset) || nomeDataset.StartsWith("Dataset ", StringComparison.OrdinalIgnoreCase))
            {
                var nomeArquivo = System.IO.Path.GetFileName(uri.LocalPath);
                var baseNome = System.IO.Path.GetFileNameWithoutExtension(nomeArquivo);
                if (!string.IsNullOrWhiteSpace(baseNome))
                    nomeDataset = baseNome;
            }

            DetectarFormato();
            ProcessarPreview();
        }
        catch (InvalidOperationException ex)
        {
            mensagemErro = ex.Message;
        }
        catch (Exception ex)
        {
            mensagemErro = $"Falha ao baixar o link: {ex.Message}";
        }
        finally
        {
            baixandoUrl = false;
        }
    }

    private static async Task<string> LerTextoLimitadoAsync(Stream stream)
    {
        using var reader = new StreamReader(stream);
        var buffer = new char[8192];
        var builder = new StringBuilder();

        int lidos;
        while ((lidos = await reader.ReadAsync(buffer, 0, buffer.Length)) > 0)
        {
            if (builder.Length + lidos > LimiteBytes)
                throw new InvalidOperationException("O conteúdo do link excede o limite de 10 MB.");

            builder.Append(buffer, 0, lidos);
        }

        return builder.ToString();
    }

    private void ProcessarPreview()
    {
        mensagemErro = null;
        try
        {
            if (formato == "CSV")
            {
                datasetPreview = ImportService.ImportarCsv(nomeDataset, conteudoBruto);
            }
            else
            {
                datasetPreview = ImportService.ImportarJson(nomeDataset, conteudoBruto);
            }

            if (datasetPreview.QtdLinhas == 0)
            {
                mensagemErro = "Nenhum dado pôde ser extraído. Verifique o formato informado.";
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao processar dados: {ex.Message}";
        }
    }

    private async Task SalvarEGerarDashboardAsync()
    {
        if (datasetPreview == null)
            ProcessarPreview();

        if (datasetPreview != null && datasetPreview.QtdLinhas > 0)
        {
            await DashboardService.SalvarDatasetAsync(datasetPreview, BIUsuarioContexto.De(UserState));
            var dash = ImportService.GerarDashboardAutomatico(datasetPreview);
            await DashboardService.SalvarAsync(dash, BIUsuarioContexto.De(UserState));
            await Fechar();
            await OnDashboardCriado.InvokeAsync(dash);
        }
    }

    private async Task Fechar()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
