@using System.Diagnostics
@using System.Globalization
@using System.Text
@using JT_BI.Models
@using JT_BI.Services
@using JT_Classes.Acessos
@using JT_Classes.DW
@using Microsoft.AspNetCore.Components.Forms
@inject IBIImportService ImportService
@inject IBIDashboardService DashboardService
@inject IBIDataSourceService DataSourceService
@inject CurrentUserState UserState
@inject IHttpClientFactory HttpClientFactory

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.72); backdrop-filter: blur(4px); z-index: 1060;">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-2xl rounded-4 overflow-hidden">
                <div class="modal-header bi-modal-header p-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 bg-primary rounded-3 text-white">
                            <i class="bi bi-file-earmark-arrow-up fs-5 text-white"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0 text-white" style="color: #ffffff !important;">Importar Dados Externos</h5>
                            <small style="color: rgba(241, 245, 249, 0.88) !important;">Envie um arquivo CSV/JSON (até 5 GB), informe um link público ou cole os dados para criar uma Fonte de Dados</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="Fechar"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label class="form-label fw-semibold small text-muted">Nome da Fonte / Conjunto de Dados:</label>
                            <input type="text" class="form-control form-control-sm" @bind="nomeDataset" placeholder="Ex: clientes_para_power_bi, Vendas 2026..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small text-muted">Formato dos Dados:</label>
                            <select class="form-select form-select-sm" @bind="formato">
                                <option value="CSV">CSV / TSV</option>
                                <option value="JSON">JSON (array de objetos)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <ul class="nav nav-pills nav-fill gap-1 bg-body-tertiary p-1 rounded-3 small">
                                <li class="nav-item">
                                    <button type="button" class="nav-link py-1 @(abaOrigem == "arquivo" ? "active" : "")" @onclick='() => abaOrigem = "arquivo"'>
                                        <i class="bi bi-upload me-1"></i> Arquivo
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button type="button" class="nav-link py-1 @(abaOrigem == "link" ? "active" : "")" @onclick='() => abaOrigem = "link"'>
                                        <i class="bi bi-link-45deg me-1"></i> Link (URL)
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button type="button" class="nav-link py-1 @(abaOrigem == "colar" ? "active" : "")" @onclick='() => abaOrigem = "colar"'>
                                        <i class="bi bi-clipboard-data me-1"></i> Colar
                                    </button>
                                </li>
                            </ul>
                        </div>

                        @if (abaOrigem == "arquivo")
                        {
                            <div class="col-12">
                                <label class="form-label fw-semibold small text-muted">Selecione um arquivo CSV ou JSON (até 5 GB):</label>
                                <InputFile OnChange="AoSelecionarArquivo" accept=".csv,.tsv,.txt,.json,text/csv,application/json" class="form-control form-control-sm" disabled="@carregandoArquivo" />

                                @if (carregandoArquivo)
                                {
                                    <div class="mt-2 p-2 bg-body-tertiary rounded-3 border">
                                        <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                                            <span>
                                                <span class="spinner-border spinner-border-sm me-1 text-primary" role="status"></span>
                                                @progressoUploadTexto
                                            </span>
                                            <span class="fw-semibold text-primary">@progressoUploadPorcentagem%</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                                                 role="progressbar"
                                                 style="width: @progressoUploadPorcentagem%;"
                                                 aria-valuenow="@progressoUploadPorcentagem"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(arquivoNome))
                                {
                                    <div class="small text-success mt-1 d-flex align-items-center gap-1">
                                        <i class="bi bi-check-circle-fill"></i>
                                        <strong>@arquivoNome</strong>
                                        @if (datasetPreview?.TamanhoBytes > 0)
                                        {
                                            <span class="text-muted">(@FormatarBytes(datasetPreview.TamanhoBytes))</span>
                                        }
                                    </div>
                                }
                                <div class="small text-muted mt-1">
                                    O formato é detectado automaticamente e o arquivo ficará salvo como Fonte de Dados gerenciável no BI.
                                </div>
                            </div>
                        }
                        else if (abaOrigem == "link")
                        {
                            <div class="col-12">
                                <label class="form-label fw-semibold small text-muted">URL pública do CSV ou JSON:</label>
                                <div class="input-group input-group-sm">
                                    <input type="url" class="form-control" @bind="urlOrigem" placeholder="https://exemplo.com/dados.csv" disabled="@baixandoUrl" />
                                    <button type="button" class="btn btn-outline-primary" @onclick="BaixarUrlAsync" disabled="@(baixandoUrl || string.IsNullOrWhiteSpace(urlOrigem))">
                                        @if (baixandoUrl)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-cloud-arrow-down me-1"></i>
                                            <span>Baixar</span>
                                        }
                                    </button>
                                </div>
                                @if (baixandoUrl)
                                {
                                    <div class="mt-2 p-2 bg-body-tertiary rounded-3 border">
                                        <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                                            <span>
                                                <span class="spinner-border spinner-border-sm me-1 text-primary" role="status"></span>
                                                @progressoUploadTexto
                                            </span>
                                            <span class="fw-semibold text-primary">@progressoUploadPorcentagem%</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                                                 role="progressbar"
                                                 style="width: @progressoUploadPorcentagem%;"
                                                 aria-valuenow="@progressoUploadPorcentagem"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                }
                                <div class="small text-muted mt-1">
                                    Aceita apenas HTTP/HTTPS. Limite de 5 GB. Links que exigem autenticação não são suportados.
                                </div>
                                @if (linkCarregado)
                                {
                                    <div class="small text-success mt-1">
                                        <i class="bi bi-check-circle-fill me-1"></i>Conteúdo baixado de @urlOrigem
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="col-12">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <label class="form-label fw-semibold small text-muted mb-0">Cole os dados brutos (até 500 KB; para arquivos até 5 GB use a aba Arquivo):</label>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="CarregarExemplo">
                                        <i class="bi bi-magic me-1"></i> Preencher Exemplo de Vendas
                                    </button>
                                </div>
                                <textarea class="form-control font-monospace" rows="6" maxlength="500000" @bind="conteudoBruto" @bind:after="DetectarFormato" placeholder="Cole aqui o conteúdo CSV ou JSON..." style="font-size: 0.82rem;"></textarea>
                            </div>
                        }

                        @if (datasetPreview != null && (datasetPreview.Linhas.Count > 0 || datasetPreview.QtdLinhas > 0))
                        {
                            <div class="col-12">
                                <div class="card border border-success border-opacity-25 bg-success bg-opacity-10 rounded-3 p-3">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                            <span class="fw-bold text-success">Dados identificados com sucesso!</span>
                                            <span class="badge bg-success">@datasetPreview.QtdLinhas.ToString("N0") linhas</span>
                                            <span class="badge bg-secondary">@datasetPreview.Colunas.Count colunas</span>
                                            @if (datasetPreview.TamanhoBytes > 0)
                                            {
                                                <span class="badge bg-info text-dark">@FormatarBytes(datasetPreview.TamanhoBytes)</span>
                                            }
                                            @if (datasetPreview.Linhas.Count < datasetPreview.QtdLinhas)
                                            {
                                                <span class="badge bg-light text-dark border" title="Amostra mantida em memória para visualização e gráficos instantâneos">
                                                    Amostra ativa: @datasetPreview.Linhas.Count.ToString("N0") registros
                                                </span>
                                            }
                                        </div>
                                        @if (datasetPreview.Linhas.Count > 0)
                                        {
                                            <button type="button" class="btn btn-xs btn-link text-decoration-none p-0 small"
                                                    @onclick="() => exibirAmostraTabela = !exibirAmostraTabela">
                                                <i class="bi @(exibirAmostraTabela ? "bi-chevron-up" : "bi-table") me-1"></i>
                                                @(exibirAmostraTabela ? "Ocultar amostra de linhas" : "Ver amostra de linhas")
                                            </button>
                                        }
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var col in datasetPreview.Colunas)
                                        {
                                            <span class="badge bg-body-secondary text-body border">
                                                <i class="bi @(col.TipoDado == "Numero" ? "bi-123 text-primary" : col.TipoDado == "Data" ? "bi-calendar text-info" : "bi-fonts text-muted") me-1"></i>
                                                @col.Nome (@col.TipoDado)
                                            </span>
                                        }
                                    </div>

                                    @if (exibirAmostraTabela && datasetPreview.Linhas.Count > 0)
                                    {
                                        <div class="table-responsive mt-3 bg-body rounded-3 border" style="max-height: 170px;">
                                            <table class="table table-sm table-striped small mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        @foreach (var col in datasetPreview.Colunas)
                                                        {
                                                            <th>@col.Nome</th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var row in datasetPreview.Linhas.Take(5))
                                                    {
                                                        <tr>
                                                            @foreach (var col in datasetPreview.Colunas)
                                                            {
                                                                <td>@(row.TryGetValue(col.Nome, out var v) ? v : "")</td>
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(mensagemErro))
                        {
                            <div class="col-12">
                                <div class="alert alert-danger py-2 small mb-0">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @mensagemErro
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer bg-light p-3 border-0 d-flex justify-content-between flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-3" @onclick="Fechar">Cancelar</button>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-3"
                                @onclick="AlternarPreviewAmostra"
                                disabled="@(datasetPreview == null || datasetPreview.Linhas.Count == 0)">
                            <i class="bi bi-eye me-1"></i> Pré-visualizar
                        </button>
                        <button type="button" class="btn btn-sm btn-success rounded-3 fw-semibold"
                                @onclick="SalvarApenasComoFonteAsync"
                                disabled="@(salvando || carregandoArquivo || baixandoUrl || !TemDadosProntosParaSalvar)">
                            @if (salvando)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            else
                            {
                                <i class="bi bi-database-fill-add me-1"></i>
                            }
                            <span>Salvar como Fonte de Dados</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-primary rounded-3 fw-semibold"
                                @onclick="SalvarEGerarDashboardAsync"
                                disabled="@(salvando || carregandoArquivo || baixandoUrl || !TemDadosProntosParaSalvar)">
                            @if (salvando)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            else
                            {
                                <i class="bi bi-speedometer2 me-1"></i>
                            }
                            <span>Salvar Fonte e Gerar Painel</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const long LimiteBytes = 5L * 1024 * 1024 * 1024; // 5 GB

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<BIDashboard> OnDashboardCriado { get; set; }
    [Parameter] public EventCallback<MOrigemDados> OnFonteSalva { get; set; }

    private string abaOrigem = "arquivo";
    private string nomeDataset = "Dataset Vendas 2026";
    private string formato = "CSV";
    private string conteudoBruto = "";
    private string urlOrigem = "";
    private string arquivoNome = "";
    private bool linkCarregado;
    private bool carregandoArquivo;
    private bool baixandoUrl;
    private bool salvando;
    private bool exibirAmostraTabela;
    private string? mensagemErro = null;
    private BIDataset? datasetPreview = null;

    private int progressoUploadPorcentagem;
    private string progressoUploadTexto = "";

    private bool TemDadosProntosParaSalvar
        => (datasetPreview != null && (datasetPreview.Linhas.Count > 0 || datasetPreview.QtdLinhas > 0)) ||
           !string.IsNullOrWhiteSpace(conteudoBruto);

    private void CarregarExemplo()
    {
        abaOrigem = "colar";
        nomeDataset = "Vendas Filiais 2026";
        formato = "CSV";
        conteudoBruto = "Mes;Canal;Faturamento;QtdVendas;TicketMedio\r\n" +
            "Janeiro;Loja Fisica;84500;940;89.89\r\n" +
            "Janeiro;Ecommerce;52100;620;84.03\r\n" +
            "Fevereiro;Loja Fisica;91200;1020;89.41\r\n" +
            "Fevereiro;Ecommerce;63400;710;89.29\r\n" +
            "Marco;Loja Fisica;98400;1090;90.27\r\n" +
            "Marco;Ecommerce;74100;830;89.27\r\n" +
            "Abril;Loja Fisica;104500;1150;90.86\r\n" +
            "Abril;Ecommerce;81200;890;91.23";
        ProcessarPreview();
        exibirAmostraTabela = true;
    }

    private void DetectarFormato()
    {
        if (string.IsNullOrWhiteSpace(conteudoBruto)) return;

        var inicio = conteudoBruto.TrimStart();
        formato = inicio.StartsWith("[") || inicio.StartsWith("{") ? "JSON" : "CSV";
        ProcessarPreview();
    }

    private async Task AoSelecionarArquivo(InputFileChangeEventArgs e)
    {
        mensagemErro = null;
        datasetPreview = null;
        linkCarregado = false;
        exibirAmostraTabela = false;
        arquivoNome = "";
        conteudoBruto = "";

        var arquivo = e.File;
        if (arquivo == null) return;

        if (arquivo.Size > LimiteBytes)
        {
            mensagemErro = $"O arquivo excede o limite máximo de 5 GB ({FormatarBytes(arquivo.Size)}).";
            return;
        }

        carregandoArquivo = true;
        progressoUploadPorcentagem = 0;
        progressoUploadTexto = "Iniciando upload...";
        arquivoNome = arquivo.Name;

        var baseNome = Path.GetFileNameWithoutExtension(arquivo.Name);
        if (!string.IsNullOrWhiteSpace(baseNome))
            nomeDataset = baseNome;

        var ext = Path.GetExtension(arquivo.Name).ToLowerInvariant();
        formato = (ext == ".json") ? "JSON" : "CSV";

        try
        {
            await using var stream = arquivo.OpenReadStream(maxAllowedSize: LimiteBytes);

            var dataset = await ImportService.ImportarStreamAsync(
                stream: stream,
                nome: nomeDataset,
                formato: formato,
                tamanhoBytes: arquivo.Size,
                nomeArquivoOriginal: arquivo.Name,
                onProgresso: (lidos, total) =>
                {
                    if (total > 0)
                    {
                        progressoUploadPorcentagem = Math.Clamp((int)((double)lidos / total * 100), 0, 100);
                        progressoUploadTexto = $"Transferindo {FormatarBytes(lidos)} de {FormatarBytes(total)}";
                    }
                    else
                    {
                        progressoUploadTexto = $"Transferido {FormatarBytes(lidos)}...";
                    }
                    _ = InvokeAsync(StateHasChanged);
                });

            datasetPreview = dataset;
            progressoUploadPorcentagem = 100;
            progressoUploadTexto = "Concluído com sucesso!";
            exibirAmostraTabela = true;
        }
        catch (Exception ex)
        {
            mensagemErro = $"Não foi possível ler o arquivo: {ex.Message}";
        }
        finally
        {
            carregandoArquivo = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task BaixarUrlAsync()
    {
        mensagemErro = null;
        datasetPreview = null;
        linkCarregado = false;
        exibirAmostraTabela = false;
        conteudoBruto = "";
        urlOrigem = urlOrigem?.Trim() ?? string.Empty;

        if (!Uri.TryCreate(urlOrigem, UriKind.Absolute, out var uri) ||
            (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            mensagemErro = "Informe uma URL válida começando com http:// ou https://.";
            return;
        }

        baixandoUrl = true;
        progressoUploadPorcentagem = 0;
        progressoUploadTexto = "Conectando ao servidor...";
        try
        {
            var client = HttpClientFactory.CreateClient();
            using var resposta = await client.GetAsync(uri, HttpCompletionOption.ResponseHeadersRead);

            if (!resposta.IsSuccessStatusCode)
            {
                mensagemErro = $"O servidor retornou {(int)resposta.StatusCode} ({resposta.ReasonPhrase}).";
                return;
            }

            var tamanho = resposta.Content.Headers.ContentLength ?? 0L;
            if (tamanho > LimiteBytes)
            {
                mensagemErro = "O conteúdo do link excede o limite de 5 GB.";
                return;
            }

            var nomeArquivo = Path.GetFileName(uri.LocalPath);
            if (string.IsNullOrWhiteSpace(nomeArquivo))
                nomeArquivo = "dataset_url.csv";

            var baseNome = Path.GetFileNameWithoutExtension(nomeArquivo);
            if (!string.IsNullOrWhiteSpace(baseNome))
                nomeDataset = baseNome;

            var ext = Path.GetExtension(nomeArquivo).ToLowerInvariant();
            formato = (ext == ".json") ? "JSON" : "CSV";

            await using var stream = await resposta.Content.ReadAsStreamAsync();
            var dataset = await ImportService.ImportarStreamAsync(
                stream: stream,
                nome: nomeDataset,
                formato: formato,
                tamanhoBytes: tamanho,
                nomeArquivoOriginal: nomeArquivo,
                onProgresso: (lidos, total) =>
                {
                    if (total > 0)
                    {
                        progressoUploadPorcentagem = Math.Clamp((int)((double)lidos / total * 100), 0, 100);
                        progressoUploadTexto = $"Baixando {FormatarBytes(lidos)} de {FormatarBytes(total)}";
                    }
                    _ = InvokeAsync(StateHasChanged);
                });

            datasetPreview = dataset;
            linkCarregado = true;
            arquivoNome = nomeArquivo;
            exibirAmostraTabela = true;
        }
        catch (Exception ex)
        {
            mensagemErro = $"Falha ao baixar o link: {ex.Message}";
        }
        finally
        {
            baixandoUrl = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AlternarPreviewAmostra()
    {
        if (datasetPreview == null && !string.IsNullOrWhiteSpace(conteudoBruto))
            ProcessarPreview();

        if (datasetPreview != null && datasetPreview.Linhas.Count > 0)
        {
            exibirAmostraTabela = !exibirAmostraTabela;
        }
    }

    private void ProcessarPreview()
    {
        mensagemErro = null;
        try
        {
            if (formato == "CSV")
            {
                datasetPreview = ImportService.ImportarCsv(nomeDataset, conteudoBruto);
            }
            else
            {
                datasetPreview = ImportService.ImportarJson(nomeDataset, conteudoBruto);
            }

            if (datasetPreview.QtdLinhas == 0)
            {
                mensagemErro = "Nenhum dado pôde ser extraído. Verifique o formato informado.";
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao processar dados: {ex.Message}";
        }
    }

    private async Task SalvarApenasComoFonteAsync()
    {
        if (datasetPreview == null && !string.IsNullOrWhiteSpace(conteudoBruto))
            ProcessarPreview();

        if (datasetPreview == null || (datasetPreview.Linhas.Count == 0 && datasetPreview.QtdLinhas == 0))
            return;

        salvando = true;
        try
        {
            datasetPreview.Nome = string.IsNullOrWhiteSpace(nomeDataset) ? datasetPreview.Nome : nomeDataset.Trim();
            await DashboardService.SalvarDatasetAsync(datasetPreview, BIUsuarioContexto.De(UserState));
            var origem = await DataSourceService.RegistrarDatasetComoFonteAsync(datasetPreview);
            await Fechar();
            if (OnFonteSalva.HasDelegate)
                await OnFonteSalva.InvokeAsync(origem);
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao salvar fonte de dados: {ex.Message}";
        }
        finally
        {
            salvando = false;
        }
    }

    private async Task SalvarEGerarDashboardAsync()
    {
        if (datasetPreview == null && !string.IsNullOrWhiteSpace(conteudoBruto))
            ProcessarPreview();

        if (datasetPreview == null || (datasetPreview.Linhas.Count == 0 && datasetPreview.QtdLinhas == 0))
            return;

        salvando = true;
        try
        {
            datasetPreview.Nome = string.IsNullOrWhiteSpace(nomeDataset) ? datasetPreview.Nome : nomeDataset.Trim();
            await DashboardService.SalvarDatasetAsync(datasetPreview, BIUsuarioContexto.De(UserState));
            var origem = await DataSourceService.RegistrarDatasetComoFonteAsync(datasetPreview);
            var dash = ImportService.GerarDashboardAutomatico(datasetPreview);
            await DashboardService.SalvarAsync(dash, BIUsuarioContexto.De(UserState));
            await Fechar();
            if (OnFonteSalva.HasDelegate)
                await OnFonteSalva.InvokeAsync(origem);
            await OnDashboardCriado.InvokeAsync(dash);
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao gerar painel: {ex.Message}";
        }
        finally
        {
            salvando = false;
        }
    }

    private async Task Fechar()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private static string FormatarBytes(long bytes)
    {
        if (bytes >= 1024L * 1024L * 1024L)
            return $"{bytes / (1024.0 * 1024.0 * 1024.0):F2} GB";
        if (bytes >= 1024L * 1024L)
            return $"{bytes / (1024.0 * 1024.0):F1} MB";
        if (bytes >= 1024L)
            return $"{bytes / 1024.0:F0} KB";
        return $"{bytes} B";
    }
}
