@using JT_BI.Services
@using JT_Classes.DW
@inject JT_Servicos.DW.OrigemDadosService OrigemService
@inject NavigationManager Nav

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); z-index: 1055;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-2xl rounded-4 overflow-hidden">
                <div class="modal-header bg-dark text-white p-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 bg-primary rounded-3 text-white">
                            <i class="bi bi-database-gear"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">Fontes de Dados (EDW)</h5>
                            <small class="text-white-50">Crie, carregue e gerencie as conexões usadas no BI</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="Fechar"></button>
                </div>

                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(mensagem))
                    {
                        <div class="alert @classeMensagem alert-dismissible fade show py-2 small rounded-3" role="alert">
                            <i class="bi bi-info-circle me-1"></i> @mensagem
                            <button type="button" class="btn-close btn-sm" @onclick="() => mensagem = null"></button>
                        </div>
                    }

                    <div class="row g-4">
                        <div class="col-12 col-lg-7">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="card-header bg-body-tertiary border-0 py-3 d-flex align-items-center justify-content-between">
                                    <div>
                                        <span class="fw-bold text-body">Origens conectadas</span>
                                        <span class="badge bg-body-secondary text-body-secondary border ms-1">@origens.Count</span>
                                    </div>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary rounded-3" @onclick="CarregarAsync" disabled="@carregando" title="Recarregar lista e modelo EDW">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </button>
                                        <button class="btn btn-sm btn-primary rounded-3" @onclick="IniciarNova" disabled="@carregando">
                                            <i class="bi bi-plus-lg me-1"></i> Nova
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    @if (carregando)
                                    {
                                        <div class="text-center p-5">
                                            <div class="spinner-border text-primary" role="status"></div>
                                            <p class="text-muted small mt-2 mb-0">Carregando origens e modelo de entidades...</p>
                                        </div>
                                    }
                                    else if (origens.Count == 0)
                                    {
                                        <div class="text-center p-5">
                                            <i class="bi bi-database-add text-muted" style="font-size: 2.5rem;"></i>
                                            <p class="fw-semibold mt-2 mb-1">Nenhuma origem EDW cadastrada</p>
                                            <p class="text-muted small">Use o formulário ao lado para criar a primeira fonte em poucos cliques.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm align-middle mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th class="ps-3">Fonte</th>
                                                        <th>Tabela</th>
                                                        <th class="text-center">Linhas</th>
                                                        <th class="text-end pe-3">Ações</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var origem in origens)
                                                    {
                                                        <tr class="@(editando?.Id == origem.Id ? "table-primary" : "")">
                                                            <td class="ps-3">
                                                                <div class="fw-semibold small">@origem.Nome</div>
                                                                <div class="text-muted" style="font-size: 0.72rem;">
                                                                    @(string.IsNullOrWhiteSpace(origem.Descricao) ? "Sem descrição" : origem.Descricao)
                                                                </div>
                                                                <div class="small mt-1">
                                                                    @if (origem.UltimaExecucao.HasValue)
                                                                    {
                                                                        <span class="text-muted" style="font-size: 0.72rem;">
                                                                            <i class="bi bi-clock-history me-1"></i>@origem.UltimaExecucao.Value.ToString("dd/MM/yyyy HH:mm")
                                                                        </span>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(origem.UltimaMensagem))
                                                                    {
                                                                        <span class="d-block @(origem.UltimaMensagem.StartsWith("Erro", StringComparison.OrdinalIgnoreCase) ? "text-danger" : "text-success")" style="font-size: 0.72rem;">
                                                                            @origem.UltimaMensagem
                                                                        </span>
                                                                    }
                                                                </div>
                                                            </td>
                                                            <td><code class="small">@origem.TabelaOrigem</code></td>
                                                            <td class="text-center small">@origem.LinhasCarregadas</td>
                                                            <td class="text-end pe-3">
                                                                <div class="btn-group btn-group-sm">
                                                                    <button class="btn btn-outline-success" title="Executar carga ETL"
                                                                            disabled="@(executandoId == origem.Id)" @onclick="() => ExecutarAsync(origem)">
                                                                        @if (executandoId == origem.Id)
                                                                        {
                                                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <i class="bi bi-play-fill"></i>
                                                                        }
                                                                    </button>
                                                                    <button class="btn btn-outline-primary" title="Editar origem" @onclick="() => IniciarEdicao(origem)">
                                                                        <i class="bi bi-pencil-fill"></i>
                                                                    </button>
                                                                    <button class="btn @(pendenteExclusaoId == origem.Id ? "btn-danger" : "btn-outline-danger")"
                                                                            title="@(pendenteExclusaoId == origem.Id ? "Confirmar exclusão" : "Excluir origem")"
                                                                            @onclick="() => SolicitarExclusaoAsync(origem)">
                                                                        <i class="bi @(pendenteExclusaoId == origem.Id ? "bi-check-lg" : "bi-trash")"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-5">
                            <div class="card border-0 shadow-sm rounded-4">
                                <div class="card-header bg-body-tertiary border-0 py-3">
                                    <span class="fw-bold text-body">
                                        @(editando == null ? "Criar fonte rápida" : "Editar fonte")
                                    </span>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        @(editando == null ? "Selecione a entidade e nós montamos as colunas e relacionamentos." : "Ajuste nome, descrição e relacionamentos. Para colunas específicas use o gerenciador avançado.")
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small text-muted">Entidade / tabela de origem</label>
                                        <select class="form-select form-select-sm" @bind="classeSelecionada" @bind:after="AoSelecionarClasse" disabled="@(editando != null)">
                                            <option value="">Selecione uma entidade...</option>
                                            @foreach (var entidade in modelo.OrderBy(m => m.Tabela))
                                            {
                                                <option value="@entidade.Classe">@entidade.Tabela · @BIOrigemFactory.NomeSimples(entidade.Classe)</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small text-muted">Nome da fonte</label>
                                        <input class="form-control form-control-sm" @bind="nome" placeholder="Ex: Contas a Pagar" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small text-muted">Descrição (opcional)</label>
                                        <input class="form-control form-control-sm" @bind="descricao" placeholder="Resumo do que esta fonte representa" />
                                    </div>

                                    @if (entidadeSelecionada != null)
                                    {
                                        <div class="border rounded-3 bg-body-tertiary p-3 mb-3">
                                            <div class="d-flex flex-wrap gap-2 mb-2">
                                                <span class="badge bg-primary-subtle text-primary border">
                                                    <i class="bi bi-columns-gap me-1"></i>@entidadeSelecionada.Colunas.Count colunas
                                                </span>
                                                <span class="badge bg-info-subtle text-info border">
                                                    <i class="bi bi-diagram-3 me-1"></i>@entidadeSelecionada.Relacionamentos.Count relacionamentos
                                                </span>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="chkRelacoes" @bind="incluirRelacionamentos" />
                                                <label class="form-check-label small" for="chkRelacoes">
                                                    Incluir relacionamentos automaticamente (LEFT JOINs com todas as colunas)
                                                </label>
                                            </div>
                                        </div>
                                    }

                                    @if (editando != null)
                                    {
                                        <p class="text-muted mb-2" style="font-size: 0.75rem;">
                                            <i class="bi bi-info-circle me-1"></i>
                                            A seleção atual de colunas será preservada. Desmarque relacionamentos para removê-los.
                                        </p>
                                    }

                                    @if (modelo.Count == 0 && !carregando)
                                    {
                                        <div class="alert alert-warning py-2 small mb-3">
                                            Nenhuma entidade disponível no modelo. Verifique a conexão com a API/banco de dados.
                                        </div>
                                    }

                                    <div class="d-flex flex-wrap gap-2">
                                        <button class="btn btn-sm btn-primary rounded-3" @onclick="() => SalvarAsync(false)" disabled="@(salvando || !PodeSalvar)">
                                            @if (salvando)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            }
                                            <i class="bi bi-save me-1"></i>@(editando == null ? "Criar fonte" : "Salvar alterações")
                                        </button>
                                        @if (editando == null)
                                        {
                                            <button class="btn btn-sm btn-success rounded-3" @onclick="() => SalvarAsync(true)" disabled="@(salvando || !PodeSalvar)">
                                                <i class="bi bi-lightning-charge me-1"></i> Criar e carregar
                                            </button>
                                        }
                                        @if (editando != null)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary rounded-3" @onclick="CancelarEdicao">Cancelar</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-0 p-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-3" @onclick="AbrirGerenciadorAvancado">
                        <i class="bi bi-sliders me-1"></i> Gerenciador avançado
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary rounded-3" @onclick="Fechar">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<MOrigemDados> origens = new();
    private List<EntidadeModeloDto> modelo = new();
    private bool carregando;
    private bool salvando;
    private bool _carregado;
    private int executandoId;
    private int? pendenteExclusaoId;
    private string? mensagem;
    private string classeMensagem = "alert-info";

    private MOrigemDados? editando;
    private string classeSelecionada = string.Empty;
    private string nome = string.Empty;
    private string descricao = string.Empty;
    private bool incluirRelacionamentos = true;

    private EntidadeModeloDto? entidadeSelecionada
        => modelo.FirstOrDefault(m => string.Equals(m.Classe, classeSelecionada, StringComparison.Ordinal));

    private bool PodeSalvar
        => !string.IsNullOrWhiteSpace(classeSelecionada)
           && !string.IsNullOrWhiteSpace(nome)
           && entidadeSelecionada != null;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen)
        {
            _carregado = false;
            return;
        }

        if (!_carregado)
        {
            _carregado = true;
            IniciarNova();
            await CarregarAsync();
        }
    }

    private async Task CarregarAsync()
    {
        carregando = true;
        try
        {
            origens = await OrigemService.GetAll();
            modelo = await OrigemService.ObterModeloEntidadesAsync();
        }
        catch (Exception ex)
        {
            DefinirMensagem($"Falha ao carregar fontes: {ex.Message}", "alert-danger");
        }
        finally
        {
            carregando = false;
        }
    }

    private void IniciarNova()
    {
        editando = null;
        classeSelecionada = string.Empty;
        nome = string.Empty;
        descricao = string.Empty;
        incluirRelacionamentos = true;
        pendenteExclusaoId = null;
    }

    private void IniciarEdicao(MOrigemDados origem)
    {
        editando = origem;
        classeSelecionada = origem.ClasseOrigem;
        nome = origem.Nome;
        descricao = origem.Descricao ?? string.Empty;
        incluirRelacionamentos = origem.Configuracao?.Relacionamentos.Count > 0;
        pendenteExclusaoId = null;
    }

    private void CancelarEdicao()
    {
        IniciarNova();
    }

    private void AoSelecionarClasse()
    {
        var entidade = entidadeSelecionada;
        if (entidade == null) return;

        if (string.IsNullOrWhiteSpace(nome))
            nome = BIOrigemFactory.NomeSugerido(entidade);

        if (string.IsNullOrWhiteSpace(descricao))
            descricao = $"Fonte EDW baseada em {entidade.Tabela}.";
    }

    private async Task SalvarAsync(bool executarAgora)
    {
        var entidade = entidadeSelecionada;
        if (entidade == null)
        {
            DefinirMensagem("Selecione a entidade de origem.", "alert-warning");
            return;
        }

        salvando = true;
        try
        {
            var origem = editando ?? new MOrigemDados();
            origem.Nome = nome.Trim();
            origem.Descricao = string.IsNullOrWhiteSpace(descricao) ? null : descricao.Trim();
            origem.ClasseOrigem = entidade.Classe;
            origem.TabelaOrigem = entidade.Tabela;
            origem.Configuracao = editando == null
                ? BIOrigemFactory.ConstruirConfiguracao(entidade, incluirRelacionamentos)
                : BIOrigemFactory.ComRelacionamentos(entidade, editando.Configuracao, incluirRelacionamentos);

            if (!await OrigemService.Save(origem))
            {
                DefinirMensagem("Não foi possível salvar a fonte. Verifique a conexão e tente novamente.", "alert-danger");
                return;
            }

            DefinirMensagem(editando == null ? $"Fonte '{origem.Nome}' criada." : $"Fonte '{origem.Nome}' atualizada.", "alert-success");
            IniciarNova();
            await CarregarAsync();
            await NotificarAlteracaoAsync();

            if (executarAgora)
                await ExecutarInternoAsync(origem.Id, origem.Nome);
        }
        catch (Exception ex)
        {
            DefinirMensagem($"Erro ao salvar fonte: {ex.Message}", "alert-danger");
        }
        finally
        {
            salvando = false;
        }
    }

    private async Task ExecutarAsync(MOrigemDados origem)
    {
        await ExecutarInternoAsync(origem.Id, origem.Nome);
    }

    private async Task ExecutarInternoAsync(int origemId, string nomeOrigem)
    {
        executandoId = origemId;
        try
        {
            var resultado = await OrigemService.ExecutarCargaAsync(origemId);
            var prefixo = resultado.Sucesso ? "Carga concluída" : "Falha na carga";
            var detalhe = string.IsNullOrWhiteSpace(resultado.Mensagem) ? string.Empty : $" — {resultado.Mensagem}";
            DefinirMensagem(
                $"{prefixo} de '{nomeOrigem}': {resultado.LinhasCarregadas} linha(s){detalhe}",
                resultado.Sucesso ? "alert-success" : "alert-danger");

            await CarregarAsync();
            await NotificarAlteracaoAsync();
        }
        catch (Exception ex)
        {
            DefinirMensagem($"Erro ao executar carga: {ex.Message}", "alert-danger");
        }
        finally
        {
            executandoId = 0;
        }
    }

    private async Task SolicitarExclusaoAsync(MOrigemDados origem)
    {
        if (pendenteExclusaoId != origem.Id)
        {
            pendenteExclusaoId = origem.Id;
            DefinirMensagem($"Clique novamente na lixeira para confirmar a exclusão de '{origem.Nome}'.", "alert-warning");
            return;
        }

        try
        {
            var removido = await OrigemService.Delete(origem.Id);
            DefinirMensagem(
                removido ? $"Fonte '{origem.Nome}' excluída." : "Não foi possível excluir a fonte.",
                removido ? "alert-success" : "alert-danger");

            pendenteExclusaoId = null;
            if (editando?.Id == origem.Id)
                IniciarNova();

            await CarregarAsync();
            await NotificarAlteracaoAsync();
        }
        catch (Exception ex)
        {
            DefinirMensagem($"Erro ao excluir fonte: {ex.Message}", "alert-danger");
        }
    }

    private async Task NotificarAlteracaoAsync()
    {
        if (OnChanged.HasDelegate)
            await OnChanged.InvokeAsync();
    }

    private void AbrirGerenciadorAvancado()
    {
        _ = Fechar();
        Nav.NavigateTo("/gestao/edw");
    }

    private async Task Fechar()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private void DefinirMensagem(string texto, string classe)
    {
        mensagem = texto;
        classeMensagem = classe;
    }
}
