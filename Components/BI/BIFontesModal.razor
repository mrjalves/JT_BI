@using JT_BI.Models
@using JT_BI.Services
@using JT_Classes.Acessos
@using JT_Classes.DW
@inject IBIDataSourceService DataSourceService
@inject IBIDashboardService DashboardService
@inject BIImportUiService ImportUi
@inject CurrentUserState UserState

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.72); backdrop-filter: blur(4px); z-index: 1055;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-2xl rounded-4 overflow-hidden">
                <div class="modal-header bi-modal-header p-3 border-0">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 bg-primary rounded-3 text-white d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                            <i class="bi bi-hdd-network-fill fs-5 text-white"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <h5 class="modal-title fw-bold mb-0 text-white" style="color: #ffffff !important;">
                                    Fontes de Dados &amp; Conexão no Servidor
                                </h5>
                                <span class="badge bg-success text-white rounded-pill px-2 py-1" style="font-size: 0.7rem;">
                                    <i class="bi bi-broadcast me-1"></i>CONEXÃO NO SERVIDOR ATIVA
                                </span>
                            </div>
                            <small class="d-block" style="color: rgba(241, 245, 249, 0.88) !important;">
                                Gerencie tabelas conectadas no banco do servidor e arquivos CSV/JSON importados como fontes de dados
                            </small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="Fechar"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Indicador explícito de conexão no banco do servidor -->
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 p-3 mb-3 rounded-3 border"
                         style="background: linear-gradient(90deg, rgba(16, 185, 129, 0.10) 0%, rgba(37, 99, 235, 0.08) 100%); border-color: rgba(16, 185, 129, 0.35) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success rounded-circle p-2 d-inline-flex align-items-center justify-content-center">
                                <i class="bi bi-hdd-network text-white"></i>
                            </span>
                            <div>
                                <div class="fw-bold small text-body">
                                    Busca Conectada ao Banco de Dados no Servidor
                                    <span class="badge bg-primary-subtle text-primary border ms-1">SERVIDOR JT</span>
                                </div>
                                <div class="text-muted" style="font-size: 0.75rem;">
                                    Servidor ativo: <code class="fw-semibold">@DataSourceService.ObterUrlServidorAtivo()</code> · Catálogo com <strong>@modelo.Count</strong> tabelas mapeadas em <strong>@ModulosDisponiveis.Count</strong> módulos
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-success rounded-3 fw-semibold" @onclick="AbrirImportacaoPlanilhaAsync" title="Importar arquivo CSV, JSON ou Link externo como Fonte de Dados">
                                <i class="bi bi-file-earmark-arrow-up me-1"></i> Importar CSV / JSON
                            </button>
                            <button class="btn btn-sm btn-outline-secondary rounded-3 bg-body" @onclick="CarregarAsync" disabled="@carregando" title="Recarregar catálogo do servidor">
                                <i class="bi bi-arrow-clockwise me-1"></i> Atualizar
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(mensagem))
                    {
                        <div class="alert @classeMensagem alert-dismissible fade show py-2 px-3 small rounded-3 mb-3" role="alert">
                            <i class="bi bi-info-circle-fill me-1"></i> @mensagem
                            <button type="button" class="btn-close btn-sm" @onclick="() => mensagem = null"></button>
                        </div>
                    }

                    <!-- Seletor de Módulos da Busca no Banco no Servidor -->
                    <div class="mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="form-label fw-bold small text-uppercase mb-0" style="letter-spacing: 0.4px; color: var(--text-color, #0f172a);">
                                <i class="bi bi-grid-1x2-fill text-primary me-1"></i> 1. Selecione o Módulo da Busca no Banco do Servidor:
                            </label>
                            @if (!string.IsNullOrEmpty(moduloSelecionado))
                            {
                                <button type="button" class="btn btn-xs btn-link text-decoration-none p-0 small" @onclick='() => SelecionarModulo("")'>
                                    Mostrar todos os módulos (@modelo.Count tabelas)
                                </button>
                            }
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button"
                                    class="bi-module-chip @(string.IsNullOrEmpty(moduloSelecionado) ? "active" : "")"
                                    @onclick='() => SelecionarModulo("")'>
                                <i class="bi bi-collection me-1"></i> Todos os Módulos
                                <span class="badge bg-secondary bg-opacity-25 text-reset ms-1">@modelo.Count</span>
                            </button>
                            @foreach (var mod in ModulosDisponiveis)
                            {
                                var ativo = string.Equals(moduloSelecionado, mod.Nome, StringComparison.OrdinalIgnoreCase);
                                <button type="button"
                                        class="bi-module-chip @(ativo ? "active" : "")"
                                        @onclick="() => SelecionarModulo(mod.Nome)">
                                    <i class="bi @mod.Icone me-1"></i> @mod.Nome
                                    <span class="badge bg-secondary bg-opacity-25 text-reset ms-1">@mod.QuantidadeTabelas</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Coluna Esquerda: Fontes Conectadas (Tabelas do Servidor + Arquivos CSV/JSON Importados + Módulos) -->
                        <div class="col-12 col-lg-7">
                            <div class="card border shadow-xs rounded-4 h-100">
                                <div class="card-header bg-body-tertiary border-bottom py-2 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold text-body">Fontes Vinculadas ao BI</span>
                                        <span class="badge bg-primary text-white rounded-pill">@(fontesServidorPadrao.Count + origens.Count)</span>
                                    </div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-hdd-network me-1"></i> Servidor + CSV/JSON
                                    </span>
                                </div>

                                <div class="card-body p-3">
                                    @if (carregando)
                                    {
                                        <div class="text-center p-5">
                                            <div class="spinner-border text-primary" role="status"></div>
                                            <p class="text-muted small mt-2 mb-0">Consultando fontes conectadas e módulos no servidor...</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Fontes de Dados Ativas (Tabelas do Servidor + Arquivos CSV/JSON Importados) -->
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="small fw-bold text-uppercase text-secondary" style="font-size: 0.74rem;">
                                                <i class="bi bi-database-fill-check me-1 text-primary"></i> Fontes de Dados Sincronizadas (@origens.Count)
                                            </div>
                                            @if (!string.IsNullOrEmpty(moduloSelecionado))
                                            {
                                                <button class="btn btn-xs btn-outline-primary rounded-3 py-0 px-2 small"
                                                        disabled="@conectandoModulo"
                                                        @onclick="ConectarTabelasDoModuloAtualAsync"
                                                        title="Conectar automaticamente as principais tabelas deste módulo no servidor">
                                                    @if (conectandoModulo)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-lightning-charge me-1"></i>
                                                    }
                                                    Conectar Tabelas de @moduloSelecionado
                                                </button>
                                            }
                                        </div>

                                        @if (origens.Count == 0)
                                        {
                                            <div class="p-3 border border-dashed rounded-3 mb-3 bg-body-tertiary d-flex align-items-center justify-content-between flex-wrap gap-2">
                                                <div>
                                                    <div class="fw-semibold small text-body">
                                                        <i class="bi bi-database-add text-primary me-1"></i> Nenhuma tabela ou CSV adicionado ainda
                                                    </div>
                                                    <div class="text-muted" style="font-size: 0.75rem;">
                                                        Escolha uma tabela do servidor à direita ou clique em <strong>Importar CSV / JSON</strong> acima para gerenciar suas fontes aqui.
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="table-responsive mb-3">
                                                <table class="table table-sm align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th class="ps-2">Fonte de Dados</th>
                                                            <th>Origem</th>
                                                            <th class="text-center">Registros</th>
                                                            <th class="text-end pe-2">Ações</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var origem in origens)
                                                        {
                                                            var ehImportada = BIDataSourceService.EhOrigemImportada(origem);
                                                            <tr class="@(editando?.Id == origem.Id ? "table-primary" : "")">
                                                                <td class="ps-2">
                                                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                                                        <span class="fw-semibold small text-body">@origem.Nome</span>
                                                                        @if (ehImportada)
                                                                        {
                                                                            <span class="badge bg-info-subtle text-info border" style="font-size: 0.65rem;">
                                                                                <i class="bi bi-file-earmark-spreadsheet me-1"></i>CSV / JSON
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-success-subtle text-success border" style="font-size: 0.65rem;">
                                                                                <i class="bi bi-hdd-network me-1"></i>SERVIDOR
                                                                            </span>
                                                                        }
                                                                    </div>
                                                                    <div class="text-muted" style="font-size: 0.72rem;">
                                                                        @(string.IsNullOrWhiteSpace(origem.UltimaMensagem) ? (origem.Descricao ?? "Pronta para consulta") : origem.UltimaMensagem)
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <code class="small">@origem.TabelaOrigem</code>
                                                                    <div class="text-muted" style="font-size: 0.68rem;">
                                                                        @((origem.Configuracao?.Colunas?.Count ?? 0)) coluna(s)
                                                                    </div>
                                                                </td>
                                                                <td class="text-center small">
                                                                    <span class="badge bg-body-secondary text-body border">@origem.LinhasCarregadas</span>
                                                                </td>
                                                                <td class="text-end pe-2">
                                                                    <div class="btn-group btn-group-sm">
                                                                        <button class="btn btn-outline-secondary" title="Visualizar amostra de registros desta fonte"
                                                                                @onclick="() => VisualizarAmostraFonteAsync(origem)">
                                                                            <i class="bi bi-table"></i>
                                                                        </button>
                                                                        <button class="btn btn-outline-success" title="Sincronizar / Revalidar dados da fonte"
                                                                                disabled="@(executandoId == origem.Id)" @onclick="() => ExecutarAsync(origem)">
                                                                            @if (executandoId == origem.Id)
                                                                            {
                                                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <i class="bi bi-arrow-repeat"></i>
                                                                            }
                                                                        </button>
                                                                        <button class="btn btn-outline-primary" title="Editar nome, descrição e colunas ativas"
                                                                                @onclick="() => IniciarEdicao(origem)">
                                                                            <i class="bi bi-pencil-fill"></i>
                                                                        </button>
                                                                        <button class="btn @(pendenteExclusaoId == origem.Id ? "btn-danger" : "btn-outline-danger")"
                                                                                title="@(pendenteExclusaoId == origem.Id ? "Confirmar exclusão" : "Remover fonte de dados")"
                                                                                @onclick="() => SolicitarExclusaoAsync(origem)">
                                                                            <i class="bi @(pendenteExclusaoId == origem.Id ? "bi-check-lg" : "bi-trash")"></i>
                                                                        </button>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }

                                        <!-- Pré-visualização de Amostra da Fonte Selecionada -->
                                        @if (origemAmostraAberta != null)
                                        {
                                            <div class="border rounded-3 p-2 mb-3 bg-body-tertiary">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="fw-bold small text-primary">
                                                        <i class="bi bi-table me-1"></i>Amostra de Dados: @origemAmostraAberta.Nome (@linhasAmostra.Count exibida(s))
                                                    </span>
                                                    <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" @onclick="() => origemAmostraAberta = null">
                                                        Fechar amostra
                                                    </button>
                                                </div>
                                                @if (linhasAmostra.Count == 0)
                                                {
                                                    <div class="text-muted small">Nenhum registro retornado na amostra.</div>
                                                }
                                                else
                                                {
                                                    var colsAmostra = (origemAmostraAberta.Configuracao?.Colunas?.Count > 0
                                                        ? origemAmostraAberta.Configuracao.Colunas
                                                        : linhasAmostra.First().Keys.ToList()).Take(6).ToList();
                                                    <div class="table-responsive" style="max-height: 150px;">
                                                        <table class="table table-sm table-striped small mb-0">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    @foreach (var c in colsAmostra)
                                                                    {
                                                                        <th>@c</th>
                                                                    }
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var l in linhasAmostra.Take(5))
                                                                {
                                                                    <tr>
                                                                        @foreach (var c in colsAmostra)
                                                                        {
                                                                            <td>@(l.TryGetValue(c, out var v) ? v : "")</td>
                                                                        }
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <!-- Módulos Integrados do Servidor -->
                                        <div class="small fw-bold text-uppercase text-secondary mb-2" style="font-size: 0.74rem;">
                                            <i class="bi bi-hdd-stack me-1 text-success"></i> Módulos Integrados no Servidor (@fontesServidorPadrao.Count)
                                        </div>
                                        <div class="row g-2">
                                            @foreach (var modFonte in fontesServidorPadrao)
                                            {
                                                <div class="col-12 col-md-6">
                                                    <div class="p-2 rounded-3 border bg-body-tertiary d-flex align-items-center justify-content-between gap-2 h-100">
                                                        <div class="d-flex align-items-center gap-2 overflow-hidden">
                                                            <div class="p-2 bg-@modFonte.Cor-subtle text-@modFonte.Cor rounded-3 flex-shrink-0">
                                                                <i class="bi @modFonte.Icone"></i>
                                                            </div>
                                                            <div class="overflow-hidden">
                                                                <div class="fw-semibold small text-body text-truncate" title="@modFonte.Nome">@modFonte.Nome</div>
                                                                <div class="d-flex align-items-center gap-1">
                                                                    <span class="badge bg-success-subtle text-success border" style="font-size: 0.62rem;">
                                                                        <i class="bi bi-hdd-network me-1"></i>SERVIDOR
                                                                    </span>
                                                                    <small class="text-muted" style="font-size: 0.68rem;">@modFonte.Metricas.Count métricas</small>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <button type="button"
                                                                class="btn btn-xs btn-outline-primary rounded-3 flex-shrink-0 py-1 px-2"
                                                                style="font-size: 0.72rem;"
                                                                @onclick="() => SelecionarModulo(modFonte.Modulo)"
                                                                title="Filtrar tabelas deste módulo no banco do servidor">
                                                            <i class="bi bi-search me-1"></i>Tabelas
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Coluna Direita: Busca por Módulo / Conexão de Tabela no Servidor ou Edição de Fonte (Servidor ou CSV) -->
                        <div class="col-12 col-lg-5">
                            <div class="card border shadow-xs rounded-4 h-100">
                                <div class="card-header bg-body-tertiary border-bottom py-2 px-3 d-flex align-items-center justify-content-between">
                                    <div>
                                        <span class="fw-bold text-body">
                                            @(editando == null
                                                ? "2. Conectar Tabela do Banco no Servidor"
                                                : $"Editando Fonte: {editando.Nome}")
                                        </span>
                                        <div class="text-muted" style="font-size: 0.74rem;">
                                            @if (editando != null && BIDataSourceService.EhOrigemImportada(editando))
                                            {
                                                <span>Personalize o nome, descrição e colunas ativas do arquivo importado</span>
                                            }
                                            else if (string.IsNullOrEmpty(moduloSelecionado))
                                            {
                                                <span>Exibindo todas as tabelas do servidor</span>
                                            }
                                            else
                                            {
                                                <span>Filtrando módulo do servidor: @moduloSelecionado</span>
                                            }
                                        </div>
                                    </div>
                                    @if (editando != null)
                                    {
                                        <button class="btn btn-xs btn-outline-secondary rounded-3" @onclick="IniciarNova">
                                            + Nova Tabela
                                        </button>
                                    }
                                </div>

                                <div class="card-body p-3">
                                    @if (editando == null || !BIDataSourceService.EhOrigemImportada(editando))
                                    {
                                        <div class="mb-2">
                                            <label class="form-label fw-semibold small text-body mb-1">
                                                <i class="bi bi-funnel me-1 text-primary"></i> Filtrar busca no servidor por nome da tabela:
                                            </label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-body-tertiary"><i class="bi bi-search"></i></span>
                                                <input type="text" class="form-control"
                                                       placeholder="Ex: Conta, Comanda, Cliente, Produto, Despesa..."
                                                       @bind="termoBuscaTabela"
                                                       @bind:event="oninput"
                                                       disabled="@(editando != null)" />
                                                @if (!string.IsNullOrWhiteSpace(termoBuscaTabela))
                                                {
                                                    <button class="btn btn-outline-secondary" type="button" @onclick='() => termoBuscaTabela = ""'>
                                                        <i class="bi bi-x"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-semibold small text-body mb-1">
                                                <i class="bi bi-hdd-network me-1 text-success"></i> Tabela do Servidor (@EntidadesFiltradas.Count encontrada(s)):
                                            </label>
                                            <select class="form-select form-select-sm" @bind="classeSelecionada" @bind:after="AoSelecionarClasse" disabled="@(editando != null)">
                                                <option value="">Selecione uma tabela do banco no servidor...</option>
                                                @foreach (var grupo in EntidadesFiltradas.GroupBy(m => BIDataSourceService.ObterCategoriaModulo(m)))
                                                {
                                                    <optgroup label="Módulo no Servidor: @grupo.Key">
                                                        @foreach (var entidade in grupo.OrderBy(e => e.Tabela))
                                                        {
                                                            <option value="@entidade.Classe">@entidade.Tabela (@entidade.Colunas.Count colunas)</option>
                                                        }
                                                    </optgroup>
                                                }
                                            </select>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="p-2 rounded-3 bg-info-subtle text-info border mb-3 small d-flex align-items-center gap-2">
                                            <i class="bi bi-file-earmark-spreadsheet-fill fs-5"></i>
                                            <div>
                                                <div class="fw-bold">Fonte de Dados de Arquivo (@editando.TabelaOrigem)</div>
                                                <div style="font-size: 0.72rem;">@editando.LinhasCarregadas registros carregados na fonte</div>
                                            </div>
                                        </div>
                                    }

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small text-body mb-1">Nome de exibição no BI:</label>
                                        <input class="form-control form-control-sm" @bind="nome" placeholder="Ex: clientes_para_power_bi, Financeiro — Contas..." />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small text-body mb-1">Descrição (opcional):</label>
                                        <input class="form-control form-control-sm" @bind="descricao" placeholder="Resumo do que esta fonte de dados representa" />
                                    </div>

                                    @if (entidadeSelecionada != null)
                                    {
                                        <div class="border rounded-3 bg-body-tertiary p-3 mb-3">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <div class="d-flex flex-wrap gap-1">
                                                    @if (editando != null && BIDataSourceService.EhOrigemImportada(editando))
                                                    {
                                                        <span class="badge bg-info-subtle text-info border">
                                                            <i class="bi bi-file-earmark-spreadsheet me-1"></i>CSV / JSON
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success-subtle text-success border">
                                                            <i class="bi bi-hdd-network me-1"></i>@BIDataSourceService.ObterCategoriaModulo(entidadeSelecionada)
                                                        </span>
                                                    }
                                                    <span class="badge bg-primary-subtle text-primary border">
                                                        <i class="bi bi-columns-gap me-1"></i>@colunasMarcadas.Count/@entidadeSelecionada.Colunas.Count colunas
                                                    </span>
                                                    @if (entidadeSelecionada.Relacionamentos.Count > 0)
                                                    {
                                                        <span class="badge bg-info-subtle text-info border">
                                                            <i class="bi bi-diagram-3 me-1"></i>@entidadeSelecionada.Relacionamentos.Count vínculo(s)
                                                        </span>
                                                    }
                                                </div>
                                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small"
                                                        @onclick="() => exibirColunasAvancadas = !exibirColunasAvancadas">
                                                    <i class="bi @(exibirColunasAvancadas ? "bi-chevron-up" : "bi-sliders") me-1"></i>
                                                    @(exibirColunasAvancadas ? "Ocultar colunas" : "Escolher colunas")
                                                </button>
                                            </div>

                                            @if (entidadeSelecionada.Relacionamentos.Count > 0)
                                            {
                                                <div class="form-check form-switch mb-1">
                                                    <input class="form-check-input" type="checkbox" id="chkRelacoes" @bind="incluirRelacionamentos" />
                                                    <label class="form-check-label small text-body" for="chkRelacoes">
                                                        Vincular automaticamente tabelas relacionadas no servidor (JOIN)
                                                    </label>
                                                </div>
                                            }

                                            @if (exibirColunasAvancadas)
                                            {
                                                <div class="mt-2 pt-2 border-top" style="max-height: 170px; overflow-y: auto;">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="text-muted" style="font-size: 0.72rem;">Colunas habilitadas nesta fonte:</span>
                                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" style="font-size: 0.72rem;"
                                                                @onclick="SelecionarTodasColunas">
                                                            Marcar todas
                                                        </button>
                                                    </div>
                                                    <div class="row g-1">
                                                        @foreach (var col in entidadeSelecionada.Colunas)
                                                        {
                                                            <div class="col-6">
                                                                <div class="form-check mb-0">
                                                                    <input class="form-check-input" type="checkbox"
                                                                           id="chk_col_@col.NomeColuna"
                                                                           checked="@colunasMarcadas.Contains(col.NomeColuna)"
                                                                           @onchange="e => AlternarColuna(col.NomeColuna, e.Value is true)" />
                                                                    <label class="form-check-label text-truncate d-block text-body" style="font-size: 0.75rem;" for="chk_col_@col.NomeColuna" title="@col.NomeColuna (@col.TipoClr)">
                                                                        @col.NomeColuna
                                                                    </label>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <div class="d-flex flex-wrap gap-2">
                                        <button class="btn btn-sm btn-primary rounded-3 flex-grow-1 py-2 fw-semibold"
                                                @onclick="() => SalvarAsync(true)"
                                                disabled="@(salvando || !PodeSalvar)">
                                            @if (salvando)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-check2-circle me-1"></i>
                                            }
                                            @(editando == null ? "Conectar e Sincronizar no Servidor" : "Salvar Alterações da Fonte")
                                        </button>

                                        @if (editando != null)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary rounded-3" @onclick="CancelarEdicao">Cancelar</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-0 p-3 d-flex justify-content-between align-items-center">
                    <span class="text-muted small">
                        <i class="bi bi-shield-check text-success me-1"></i> As fontes conectadas e os arquivos CSV/JSON ficam disponíveis nos gráficos, KPIs e no Laboratório de Mineração.
                    </span>
                    <button type="button" class="btn btn-sm btn-secondary rounded-3 px-4" @onclick="Fechar">Concluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public record ModuloResumo(string Nome, string Icone, int QuantidadeTabelas);

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<MOrigemDados> origens = new();
    private List<FonteDadosInfo> fontesServidorPadrao = new();
    private List<BIDataset> datasets = new();
    private List<EntidadeModeloDto> modelo = new();
    private HashSet<string> colunasMarcadas = new(StringComparer.OrdinalIgnoreCase);
    private string moduloSelecionado = string.Empty;
    private string termoBuscaTabela = string.Empty;
    private bool exibirColunasAvancadas;
    private bool carregando;
    private bool salvando;
    private bool conectandoModulo;
    private bool _carregado;
    private int executandoId;
    private int? pendenteExclusaoId;
    private string? mensagem;
    private string classeMensagem = "alert-info";

    private MOrigemDados? editando;
    private EntidadeModeloDto? entidadeVirtualEdicao;
    private MOrigemDados? origemAmostraAberta;
    private List<Dictionary<string, string>> linhasAmostra = new();
    private string classeSelecionada = string.Empty;
    private string nome = string.Empty;
    private string descricao = string.Empty;
    private bool incluirRelacionamentos = true;

    private List<ModuloResumo> ModulosDisponiveis => modelo
        .GroupBy(m => BIDataSourceService.ObterCategoriaModulo(m))
        .Select(g => new ModuloResumo(g.Key, ObterIconeModulo(g.Key), g.Count()))
        .OrderByDescending(m => m.QuantidadeTabelas)
        .ToList();

    private List<EntidadeModeloDto> EntidadesFiltradas => modelo
        .Where(m => string.IsNullOrWhiteSpace(moduloSelecionado) ||
                    string.Equals(BIDataSourceService.ObterCategoriaModulo(m), moduloSelecionado, StringComparison.OrdinalIgnoreCase))
        .Where(m => string.IsNullOrWhiteSpace(termoBuscaTabela) ||
                    m.Tabela.Contains(termoBuscaTabela, StringComparison.OrdinalIgnoreCase) ||
                    m.Classe.Contains(termoBuscaTabela, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private EntidadeModeloDto? entidadeSelecionada
        => entidadeVirtualEdicao ?? modelo.FirstOrDefault(m => string.Equals(m.Classe, classeSelecionada, StringComparison.Ordinal));

    private bool PodeSalvar
        => !string.IsNullOrWhiteSpace(classeSelecionada)
           && !string.IsNullOrWhiteSpace(nome)
           && entidadeSelecionada != null
           && colunasMarcadas.Count > 0;

    private static string ObterIconeModulo(string modulo) => modulo switch
    {
        "Financeiro & Contábil" => "bi-cash-coin",
        "Food & Restaurante" => "bi-cup-straw",
        "Comercial & Vendas" => "bi-graph-up-arrow",
        "Estoque & Suprimentos" => "bi-box-seam",
        "Projetos & Serviços" => "bi-kanban",
        "Acessos & Gestão" => "bi-shield-lock",
        _ => "bi-database"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen)
        {
            _carregado = false;
            return;
        }

        if (!_carregado)
        {
            _carregado = true;
            IniciarNova();
            await CarregarAsync();
        }
    }

    private async Task CarregarAsync()
    {
        carregando = true;
        try
        {
            modelo = await DataSourceService.ObterCatalogoEntidadesAsync();
            datasets = await DashboardService.ObterDatasetsVisiveisAsync(BIUsuarioContexto.De(UserState));
            origens = await DataSourceService.ObterOrigensConfiguradasAsync();

            // Garante que qualquer arquivo CSV/JSON importado também esteja registrado como Fonte de Dados gerenciável
            var sincronizouDataset = false;
            foreach (var ds in datasets)
            {
                var classeDs = $"Importado.{ds.Origem}.{ds.Id}";
                if (!origens.Any(o =>
                        string.Equals(o.ClasseOrigem, classeDs, StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(o.Nome, ds.Nome, StringComparison.OrdinalIgnoreCase)))
                {
                    await DataSourceService.RegistrarDatasetComoFonteAsync(ds);
                    sincronizouDataset = true;
                }
            }

            if (sincronizouDataset)
            {
                origens = await DataSourceService.ObterOrigensConfiguradasAsync();
            }

            var todasFontes = await DataSourceService.ObterFontesDisponiveisAsync();
            fontesServidorPadrao = todasFontes.Where(f => !f.OrigemId.HasValue).ToList();
        }
        catch (Exception ex)
        {
            DefinirMensagem($"Falha ao carregar catálogo de fontes: {ex.Message}", "alert-danger");
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task VisualizarAmostraFonteAsync(MOrigemDados origem)
    {
        try
        {
            origemAmostraAberta = origem;
            var cols = origem.Configuracao?.Colunas ?? new List<string>();
            linhasAmostra = await DataSourceService.ObterAmostraAsync(origem.Id, cols, 10);
        }
        catch (Exception ex)
        {
            DefinirMensagem($"Não foi possível carregar amostra: {ex.Message}", "alert-warning");
        }
    }

    private void SelecionarModulo(string modulo)
    {
        moduloSelecionado = modulo;
        if (editando == null)
        {
            var primeira = EntidadesFiltradas.FirstOrDefault();
            if (primeira != null && !string.IsNullOrEmpty(modulo))
            {
                classeSelecionada = primeira.Classe;
                AoSelecionarClasse();
            }
        }
    }

    private async Task ConectarTabelasDoModuloAtualAsync()
    {
        if (string.IsNullOrWhiteSpace(moduloSelecionado))
            return;

        conectandoModulo = true;
        try
        {
            var qtd = await DataSourceService.ConectarModuloServidorAsync(moduloSelecionado);
            DefinirMensagem(
                qtd > 0
                    ? $"{qtd} tabela(s) do módulo '{moduloSelecionado}' conectada(s) ao servidor com sucesso!"
                    : $"As tabelas principais de '{moduloSelecionado}' já estão conectadas.",
                "alert-success");
            await CarregarAsync();
            await NotificarAlteracaoAsync();
        }
        catch (Exception ex)
        {
            DefinirMensagem($"Erro ao conectar tabelas do módulo: {ex.Message}", "alert-danger");
        }
        finally
        {
            conectandoModulo = false;
        }
    }

    private void IniciarNova()
    {
        editando = null;
        entidadeVirtualEdicao = null;
        classeSelecionada = string.Empty;
        nome = string.Empty;
        descricao = string.Empty;
        incluirRelacionamentos = true;
        exibirColunasAvancadas = false;
        colunasMarcadas.Clear();
        pendenteExclusaoId = null;
    }

    private void IniciarEdicao(MOrigemDados origem)
    {
        editando = origem;
        classeSelecionada = origem.ClasseOrigem ?? string.Empty;
        nome = origem.Nome ?? string.Empty;
        descricao = origem.Descricao ?? string.Empty;
        incluirRelacionamentos = (origem.Configuracao?.Relacionamentos?.Count ?? 0) > 0;
        pendenteExclusaoId = null;

        var doCatalogo = modelo.FirstOrDefault(m => string.Equals(m.Classe, classeSelecionada, StringComparison.Ordinal));
        if (doCatalogo != null)
        {
            entidadeVirtualEdicao = null;
        }
        else
        {
            var colsOrigem = origem.Configuracao?.Colunas ?? new List<string>();
            entidadeVirtualEdicao = new EntidadeModeloDto
            {
                Classe = origem.ClasseOrigem ?? $"Importado.CSV.{origem.Id}",
                Tabela = origem.TabelaOrigem ?? "Arquivo CSV",
                Colunas = colsOrigem.Select(c => new ColunaModeloDto
                {
                    NomeColuna = c,
                    Propriedade = c,
                    TipoClr = "String"
                }).ToList(),
                Relacionamentos = new List<RelacionamentoModeloDto>()
            };
            exibirColunasAvancadas = true;
        }

        colunasMarcadas = new HashSet<string>(
            origem.Configuracao?.Colunas
                ?? entidadeSelecionada?.Colunas?.Select(c => c.NomeColuna)
                ?? Enumerable.Empty<string>(),
            StringComparer.OrdinalIgnoreCase);
    }

    private void CancelarEdicao()
    {
        IniciarNova();
    }

    private void AoSelecionarClasse()
    {
        entidadeVirtualEdicao = null;
        var entidade = entidadeSelecionada;
        if (entidade == null)
        {
            colunasMarcadas.Clear();
            return;
        }

        nome = $"{BIDataSourceService.ObterCategoriaModulo(entidade)} — {BIOrigemFactory.NomeSugerido(entidade)}";
        descricao = $"Conexão no Servidor · Tabela {entidade.Tabela} ({entidade.Colunas.Count} colunas)";
        colunasMarcadas = new HashSet<string>(
            entidade.Colunas.Select(c => c.NomeColuna),
            StringComparer.OrdinalIgnoreCase);
    }

    private void AlternarColuna(string nomeColuna, bool marcada)
    {
        if (marcada)
            colunasMarcadas.Add(nomeColuna);
        else
            colunasMarcadas.Remove(nomeColuna);
    }

    private void SelecionarTodasColunas()
    {
        if (entidadeSelecionada == null) return;
        colunasMarcadas = new HashSet<string>(
            entidadeSelecionada.Colunas.Select(c => c.NomeColuna),
            StringComparer.OrdinalIgnoreCase);
    }

    private async Task SalvarAsync(bool executarAgora)
    {
        var entidade = entidadeSelecionada;
        if (entidade == null)
        {
            DefinirMensagem("Selecione uma tabela do banco no servidor.", "alert-warning");
            return;
        }

        salvando = true;
        try
        {
            var origem = editando ?? new MOrigemDados();
            origem.Nome = nome.Trim();
            origem.Descricao = string.IsNullOrWhiteSpace(descricao) ? null : descricao.Trim();
            origem.ClasseOrigem = entidade.Classe;
            origem.TabelaOrigem = entidade.Tabela;

            var config = BIOrigemFactory.ConstruirConfiguracao(entidade, incluirRelacionamentos);
            config.Colunas = colunasMarcadas.ToList();
            origem.Configuracao = config;

            var eraEdicao = editando != null;
            origem = await DataSourceService.SalvarOrigemAsync(origem);

            if (executarAgora)
            {
                var resultado = await DataSourceService.ExecutarCargaOrigemAsync(origem.Id);
                DefinirMensagem(
                    $"Fonte '{origem.Nome}' {(eraEdicao ? "atualizada" : "conectada")}! {resultado.Mensagem}",
                    "alert-success");
            }
            else
            {
                DefinirMensagem(
                    eraEdicao ? $"Fonte '{origem.Nome}' atualizada." : $"Fonte '{origem.Nome}' conectada.",
                    "alert-success");
            }

            IniciarNova();
            await CarregarAsync();
            await NotificarAlteracaoAsync();
        }
        catch (Exception ex)
        {
            DefinirMensagem($"Erro ao salvar fonte: {ex.Message}", "alert-danger");
        }
        finally
        {
            salvando = false;
        }
    }

    private async Task ExecutarAsync(MOrigemDados origem)
    {
        executandoId = origem.Id;
        try
        {
            var resultado = await DataSourceService.ExecutarCargaOrigemAsync(origem.Id);
            DefinirMensagem(
                $"Sincronização de '{origem.Nome}': {resultado.Mensagem}",
                resultado.Sucesso ? "alert-success" : "alert-warning");

            await CarregarAsync();
            await NotificarAlteracaoAsync();
        }
        catch (Exception ex)
        {
            DefinirMensagem($"Erro ao sincronizar fonte: {ex.Message}", "alert-danger");
        }
        finally
        {
            executandoId = 0;
        }
    }

    private async Task SolicitarExclusaoAsync(MOrigemDados origem)
    {
        if (pendenteExclusaoId != origem.Id)
        {
            pendenteExclusaoId = origem.Id;
            DefinirMensagem($"Clique novamente no botão vermelho para confirmar a remoção de '{origem.Nome}'.", "alert-warning");
            return;
        }

        try
        {
            if (BIDataSourceService.EhOrigemImportada(origem))
            {
                await DashboardService.ExcluirDatasetPorReferenciaAsync(origem.ClasseOrigem);
                await DashboardService.ExcluirDatasetPorReferenciaAsync(origem.Nome);
            }

            var removido = await DataSourceService.ExcluirOrigemAsync(origem.Id);
            DefinirMensagem(
                removido ? $"Fonte '{origem.Nome}' removida." : "Não foi possível remover a fonte.",
                removido ? "alert-success" : "alert-danger");

            pendenteExclusaoId = null;
            if (editando?.Id == origem.Id)
                IniciarNova();
            if (origemAmostraAberta?.Id == origem.Id)
                origemAmostraAberta = null;

            await CarregarAsync();
            await NotificarAlteracaoAsync();
        }
        catch (Exception ex)
        {
            DefinirMensagem($"Erro ao remover fonte: {ex.Message}", "alert-danger");
        }
    }

    private async Task AbrirImportacaoPlanilhaAsync()
    {
        await Fechar();
        await ImportUi.AbrirAsync(
            callback: null,
            callbackFonte: async origemImportada =>
            {
                IsOpen = true;
                await IsOpenChanged.InvokeAsync(true);
                await CarregarAsync();
                DefinirMensagem($"Arquivo '{origemImportada.Nome}' importado como Fonte de Dados ({origemImportada.LinhasCarregadas} registros)! Use as ações abaixo para gerenciar.", "alert-success");
                await NotificarAlteracaoAsync();
                await InvokeAsync(StateHasChanged);
            });
    }

    private async Task NotificarAlteracaoAsync()
    {
        if (OnChanged.HasDelegate)
            await OnChanged.InvokeAsync();
    }

    private async Task Fechar()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private void DefinirMensagem(string texto, string classe)
    {
        mensagem = texto;
        classeMensagem = classe;
    }
}
