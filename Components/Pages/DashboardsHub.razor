@page "/dashboards"
@using JT_BI.Models
@using JT_BI.Services
@using JT_BI.Components.BI
@using JT_Classes.Acessos
@inject IBIDashboardService DashboardService
@inject CurrentUserState UserState
@inject NavigationManager Nav

<PageTitle>Hub de Dashboards - JT_BI</PageTitle>

<div class="container-fluid py-4 px-md-4">
    <!-- Topo: Hero & Estatísticas -->
    <div class="row align-items-center mb-4" data-tutorial="hub-header">
        <div class="col-12 col-md-7">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-gradient bg-primary text-white rounded-4 shadow-sm">
                    <i class="bi bi-speedometer2 fs-2"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-body mb-0">Central de Inteligência (JT_BI)</h3>
                    <p class="text-muted mb-0 small">Criação visual interativa, importação ágil e compartilhamento público de dados analíticos.</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-5 d-flex gap-2 justify-content-md-end mt-3 mt-md-0">
            <button class="btn btn-outline-primary rounded-3 shadow-sm" @onclick="() => isImportModalOpen = true">
                <i class="bi bi-file-earmark-arrow-up me-1"></i> Importar CSV / JSON
            </button>
            <button class="btn btn-primary rounded-3 shadow-sm px-3" data-tutorial="hub-novo" @onclick="CriarNovoPainelAsync">
                <i class="bi bi-plus-lg me-1"></i> Novo Painel
            </button>
        </div>
    </div>

    <!-- Cards de Resumo Rápido -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card card-modern border-0 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Painéis Ativos</span>
                        <h4 class="fw-bold mb-0 text-body">@dashboards.Count</h4>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                        <i class="bi bi-grid-fill fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card card-modern border-0 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Indicadores Cadastrados</span>
                        <h4 class="fw-bold mb-0 text-body">@dashboards.Sum(d => d.Widgets.Count)</h4>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle">
                        <i class="bi bi-graph-up-arrow fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card card-modern border-0 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Datasets Vinculados</span>
                        <h4 class="fw-bold mb-0 text-body">@datasetsCount</h4>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                        <i class="bi bi-database fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card card-modern border-0 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Acesso Sem Login</span>
                        <h4 class="fw-bold mb-0 text-success">Liberado</h4>
                    </div>
                    <div class="p-3 bg-info-subtle text-info rounded-circle">
                        <i class="bi bi-shield-check fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de Dashboards em Grid -->
    <div class="row g-4" data-tutorial="hub-cards">
        @if (isLoading)
        {
            <div class="col-12 text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted small mt-2">Carregando painéis...</p>
            </div>
        }
        else if (dashboards.Count == 0)
        {
            <div class="col-12">
                <div class="card card-modern border-0 text-center p-5">
                    <i class="bi bi-speedometer2 text-muted" style="font-size: 3rem;"></i>
                    <h5 class="fw-bold text-body mt-3">Nenhum painel criado ainda</h5>
                    <p class="text-muted small">Crie seu primeiro dashboard visual ou importe dados via planilha CSV/JSON.</p>
                    <div class="d-flex justify-content-center gap-2 mt-2">
                        <button class="btn btn-sm btn-primary rounded-3" @onclick="CriarNovoPainelAsync">
                            <i class="bi bi-plus-lg me-1"></i> Criar Painel
                        </button>
                        <button class="btn btn-sm btn-outline-secondary rounded-3" @onclick="() => isImportModalOpen = true">
                            <i class="bi bi-upload me-1"></i> Importar Dados
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            @foreach (var dash in dashboards)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card card-modern border-0 h-100 hover-shadow transition-all overflow-hidden d-flex flex-column">
                        <div class="card-body p-4 flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="p-2 bg-@dash.CorDestaque-subtle text-@dash.CorDestaque rounded-3">
                                        <i class="bi @dash.Icone fs-5"></i>
                                    </div>
                                    <span class="badge bg-body-secondary text-body-secondary border">@dash.Categoria</span>
                                </div>
                                @if (dash.PermiteAcessoPublico)
                                {
                                    <span class="badge bg-success-subtle text-success small" title="Compartilhamento público ativo">
                                        <i class="bi bi-globe me-1"></i> Público
                                    </span>
                                }
                            </div>

                            <h5 class="fw-bold text-body mb-1">@dash.Nome</h5>
                            <p class="text-muted small mb-2 text-truncate-2" style="min-height: 40px;">@dash.Descricao</p>
                            <div class="small text-muted mb-2">
                                <i class="bi bi-person-circle me-1"></i>
                                @(string.IsNullOrWhiteSpace(dash.UsuarioNome) ? "Compartilhado" : dash.UsuarioNome)
                            </div>

                            <div class="d-flex align-items-center justify-content-between text-muted small pt-2 border-top">
                                <span><i class="bi bi-layers me-1"></i> @dash.Widgets.Count indicadores</span>
                                <span><i class="bi bi-clock-history me-1"></i> @dash.DataAtualizacao.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>

                        <!-- Rodapé de Ações -->
                        <div class="card-footer bg-body-tertiary p-3 border-top border-light-subtle d-flex align-items-center justify-content-between">
                            <div class="d-flex gap-1">
                                <a href="/compartilhado/@dash.PublicToken" target="_blank" class="btn btn-sm btn-outline-secondary rounded-3" title="Visualizar Apresentação">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-3" @onclick="() => AbrirCompartilhar(dash)" title="Compartilhar Link">
                                    <i class="bi bi-share"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-3" @onclick="() => DuplicarAsync(dash.Id)" title="Duplicar Painel">
                                    <i class="bi bi-copy"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-3" @onclick="() => ExcluirAsync(dash.Id)" title="Excluir Painel">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <button type="button" class="btn btn-sm btn-primary rounded-3 px-3 fw-semibold" @onclick="() => EditarNoCanvas(dash.Id)">
                                <i class="bi bi-pencil-square me-1"></i> Abrir Construtor
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<BIImportModal @bind-IsOpen="isImportModalOpen" OnDashboardCriado="DashboardImportadoCriado" />
<BIShareModal @bind-IsOpen="isShareModalOpen" Dashboard="dashboardParaCompartilhar" OnSaved="CarregarDashboardsAsync" />

@code {
    private List<BIDashboard> dashboards = new();
    private int datasetsCount = 0;
    private bool isLoading = true;
    private bool isImportModalOpen = false;
    private bool isShareModalOpen = false;
    private BIDashboard? dashboardParaCompartilhar;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDashboardsAsync();
    }

    private async Task CarregarDashboardsAsync()
    {
        isLoading = true;
        dashboards = await DashboardService.ObterVisiveisAsync(BIUsuarioContexto.De(UserState));
        var dss = await DashboardService.ObterDatasetsAsync();
        datasetsCount = dss.Count;
        isLoading = false;
    }

    private async Task CriarNovoPainelAsync()
    {
        var novo = new BIDashboard
        {
            Nome = $"Novo Painel #{dashboards.Count + 1}",
            Descricao = "Painel analítico criado no construtor visual.",
            Categoria = "Personalizado",
            Icone = "bi-speedometer2"
        };
        await DashboardService.SalvarAsync(novo, BIUsuarioContexto.De(UserState));
        Nav.NavigateTo($"/dashboards/editor/{novo.Id}");
    }

    private void EditarNoCanvas(Guid id)
    {
        Nav.NavigateTo($"/dashboards/editor/{id}");
    }

    private void AbrirCompartilhar(BIDashboard dash)
    {
        dashboardParaCompartilhar = dash;
        isShareModalOpen = true;
    }

    private async Task DuplicarAsync(Guid id)
    {
        var copia = await DashboardService.DuplicarAsync(id, BIUsuarioContexto.De(UserState));
        await CarregarDashboardsAsync();
    }

    private async Task ExcluirAsync(Guid id)
    {
        await DashboardService.ExcluirAsync(id, BIUsuarioContexto.De(UserState));
        await CarregarDashboardsAsync();
    }

    private void DashboardImportadoCriado(BIDashboard dash)
    {
        Nav.NavigateTo($"/dashboards/editor/{dash.Id}");
    }
}