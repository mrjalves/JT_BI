@page "/"
@page "/bi"
@page "/bidashboard"
@page "/home"
@page "/dashboards/editor/{DashboardId:guid}"
@rendermode InteractiveServer
@implements IDisposable

@using JT_BI.Models
@using JT_BI.Services
@using JT_BI.Components.BI
@using JT_Aplicacao.Classes
@using JT_Classes.Acessos
@using JT_Servicos.Gestao
@using JT_UserInterface.Shared
@using JT_UserInterface.Shared.Components.Acessos
@using JT_UserInterface.Shared.Services.Interfaces.Acessos
@using JT_UserInterface.Shared.Services.Interfaces.Comum
@using JT_UserInterface.Shared.Services.Comum

@inject MGestaoConfiguracaoService GestaoConfigService
@inject IAcessoService AcessoService
@inject CurrentUserState UserState
@inject IBIDashboardService DashboardService
@inject IBIDataSourceService DataSourceService
@inject IBIImportService ImportService
@inject IBIDataMiningService DataMiningService
@inject BIImportUiService ImportUi
@inject ITutorialService TutorialService
@inject ToastService ToastService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>JT_BI - Painel Central de Inteligência</PageTitle>

@* ========================================================================= *@
@* FASE 1: VALIDAÇÃO DE SEGURANÇA E ACESSO AUTORIZADO                       *@
@* ========================================================================= *@
@if (!IsCarregandoAcesso && !TemAcesso)
{
    @* FEEDBACK QUANDO O USUÁRIO NÃO POSSUI ACESSO AUTORIZADO *@
    <div class="container d-flex align-items-center justify-content-center" style="min-height: 70vh;">
        <div class="card card-modern border-0 p-5 text-center" style="max-width: 520px;">
            <div class="mb-3">
                <span class="p-3 bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center"
                      style="width: 72px; height: 72px;">
                    <i class="bi bi-shield-lock-fill fs-1"></i>
                </span>
            </div>
            <h4 class="fw-bold text-body mb-2">Acesso Restrito ao Módulo JT_BI</h4>
            <p class="text-muted small mb-4">
                Seu perfil de usuário não possui permissão ativa para o módulo de Gestão/BI ou seu token de autenticação expirou.
            </p>
            <div class="d-flex flex-column gap-2">
                <a href="/login?returnUrl=/" class="btn btn-primary rounded-3 py-2 fw-semibold shadow-sm">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Fazer Login no Sistema
                </a>
                <button class="btn btn-outline-secondary rounded-3 py-2 small" @onclick="RecarregarAcesso">
                    <i class="bi bi-arrow-clockwise me-1"></i> Verificar Novamente
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="bi-spa-wrapper d-flex flex-column h-100">
            <!-- Barra Superior Executiva SPA -->
            <header class="bi-header card card-modern border-0 mb-3" data-tutorial="bi-header">
                <div class="card-body py-2 px-3">
                    <div class="row g-2 align-items-center justify-content-between">
                        <!-- Identificação do Módulo e Dashboard Ativo -->
                        <div class="col-12 col-lg-3 col-xl-3 d-flex align-items-center gap-2">
                            <div class="bi-brand-icon p-2 bg-gradient text-white rounded-3 shadow-sm d-flex align-items-center justify-content-center"
                                 style="background: linear-gradient(135deg, #2563eb, #3b82f6); width: 38px; height: 38px;">
                                <i class="bi bi-pie-chart-fill fs-5"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h5 class="fw-bold mb-0 text-body" style="letter-spacing: -0.3px;">JT_BI Studio</h5>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small">SPA v2.0</span>
                                </div>
                                <small class="text-muted d-block text-truncate" style="max-width: 220px;">
                                    @(DashboardAtivo?.Nome ?? "Carregando ambiente analítico...")
                                </small>
                            </div>
                        </div>

                        <!-- Seletor de Painel / Ações Rápidas -->
                        <div class="col-12 col-lg-6 col-xl-6 d-flex align-items-center justify-content-center gap-2 flex-wrap">
                            @if (ListaDashboards.Any())
                            {
                                <select class="form-select form-select-sm border-0 bg-light rounded-3 fw-semibold text-secondary"
                                        style="max-width: 190px;"
                                        value="@DashboardAtivo?.Id"
                                        @onchange="TrocarDashboardAsync">
                                    @foreach (var dash in ListaDashboards)
                                    {
                                        <option value="@dash.Id">@dash.Nome</option>
                                    }
                                </select>
                            }
                            <button class="btn btn-sm btn-outline-primary rounded-3 px-2 shadow-xs d-flex align-items-center gap-1"
                                    @onclick="NovoDashboardAsync" title="Criar Novo Painel">
                                <i class="bi bi-plus-circle"></i>
                                <span class="d-none d-sm-inline">Novo</span>
                            </button>

                            <!-- Botão Templates Rápidos (Fase 2) -->
                            <button class="btn btn-sm btn-outline-secondary rounded-3 px-2 shadow-xs d-flex align-items-center gap-1"
                                    @onclick="() => isTemplatesModalOpen = true" title="Escolher Template de Painel">
                                <i class="bi bi-layout-wtf text-primary"></i>
                                <span class="d-none d-md-inline">Templates</span>
                            </button>

                            <!-- Botão Importar Dados (Fase 3) -->
                            <button class="btn btn-sm btn-outline-secondary rounded-3 px-2 shadow-xs d-flex align-items-center gap-1"
                                    @onclick="AbrirImportacaoAsync" title="Importar CSV / JSON">
                                <i class="bi bi-file-earmark-arrow-up text-success"></i>
                                <span class="d-none d-md-inline">Importar</span>
                            </button>

                            <!-- Botão Mineração IA (Fase 3) -->
                            <button class="btn btn-sm btn-outline-secondary rounded-3 px-2 shadow-xs d-flex align-items-center gap-1"
                                    data-tutorial="bi-mining-btn"
                                    @onclick="() => isDataMiningModalOpen = true" title="Mineração de Dados (K-Means / Curva ABC)">
                                <i class="bi bi-cpu text-warning"></i>
                                <span class="d-none d-md-inline">Mineração</span>
                            </button>

                            <!-- Botão Compartilhar (Fase 5) -->
                            <button class="btn btn-sm btn-outline-secondary rounded-3 px-2 shadow-xs d-flex align-items-center gap-1"
                                    data-tutorial="bi-share-btn"
                                    @onclick="() => isShareModalOpen = true" title="Compartilhar Link Público">
                                <i class="bi bi-share text-info"></i>
                            </button>

                            <!-- Botão Instruções da Página / Tutorial -->
                            <button class="btn btn-sm btn-outline-info rounded-3 px-2 shadow-xs d-flex align-items-center gap-1"
                                    data-tutorial="bi-instructions-btn"
                                    @onclick="AbrirTutorialPagina" title="Instruções e Tutorial Interativo">
                                <i class="bi bi-question-circle"></i>
                                <span class="d-none d-xl-inline">Instruções</span>
                            </button>

                            <a href="/dashboards" class="btn btn-sm btn-outline-secondary rounded-3 px-2 shadow-xs" title="Ver Hub de Todos os Painéis">
                                <i class="bi bi-grid-3x3-gap"></i>
                            </a>
                        </div>

                        <!-- Status de Usuário & Controle do Painel -->
                        <div class="col-12 col-lg-3 col-xl-3 d-flex align-items-center justify-content-end gap-2">
                            <button class="btn btn-sm btn-outline-secondary rounded-3 px-2" @onclick="ExportarJsonDashboard" title="Exportar Definições JSON">
                                <i class="bi bi-download me-1"></i> Exportar
                            </button>

                            <button class="btn btn-sm btn-success rounded-3 px-3 fw-semibold shadow-sm d-flex align-items-center gap-1"
                                    @onclick="SalvarDashboardAtualAsync" disabled="@IsSalvando" title="Salvar Alterações">
                                @if (IsSalvando)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>Salvando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-cloud-check-fill"></i>
                                    <span>Salvar</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Feedback de Alerta -->
            @if (!string.IsNullOrEmpty(MensagemFeedback))
            {
                <div class="alert @ClasseFeedback alert-dismissible fade show mb-3 py-2 px-3 shadow-sm rounded-3 border-0 d-flex align-items-center justify-content-between" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @(ClasseFeedback.Contains("success") ? "bi-check-circle-fill text-success" : (ClasseFeedback.Contains("info") ? "bi-info-circle-fill text-info" : "bi-exclamation-triangle-fill text-danger")) fs-5"></i>
                        <span class="small fw-semibold">@MensagemFeedback</span>
                    </div>
                    <button type="button" class="btn-close btn-close-sm" @onclick="() => MensagemFeedback = null"></button>
                </div>
            }

            <!-- Área Central SPA Tripartite -->
            <div class="row g-3 flex-grow-1">
                <!-- COLUNA ESQUERDA: Barra de Ferramentas / Widgets & Datasets (Fase 2 Drag & Drop) -->
                <aside class="col-12 col-lg-2 d-flex flex-column">
                    <div class="card card-modern border-0 h-100 overflow-hidden" data-tutorial="bi-toolbox">
                        <div class="card-header border-bottom py-2 px-3 d-flex align-items-center justify-content-between">
                            <span class="fw-bold small text-uppercase text-secondary" style="letter-spacing: 0.5px;">
                                <i class="bi bi-tools me-1 text-primary"></i> Widgets
                            </span>
                            <span class="badge bg-body-secondary text-body rounded-pill">Drag & Drop</span>
                        </div>
                        <div class="card-body p-2 overflow-y-auto">
                            <p class="text-muted small px-1 mb-2" style="font-size: 0.72rem;">
                                Arraste ou clique para adicionar componentes ao Canvas Central:
                            </p>
                            <div class="d-flex flex-column gap-2">
                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-grab hover-shadow transition-all"
                                     draggable="true"
                                     @ondragstart="@(() => IniciarArrasto(BIWidgetTipo.CardKpi))"
                                     @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.CardKpi)"
                                     title="Arraste para o Canvas ou clique para inserir">
                                    <div class="p-2 bg-primary-subtle text-primary rounded-3"><i class="bi bi-123"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Card Indicador (KPI)</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Métricas e Totais</small>
                                    </div>
                                </div>

                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-grab hover-shadow transition-all"
                                     draggable="true"
                                     @ondragstart="@(() => IniciarArrasto(BIWidgetTipo.GraficoBarras))"
                                     @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.GraficoBarras)"
                                     title="Arraste para o Canvas ou clique para inserir">
                                    <div class="p-2 bg-info-subtle text-info rounded-3"><i class="bi bi-bar-chart-fill"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Gráfico de Barras</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Comparações por Categoria</small>
                                    </div>
                                </div>

                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-grab hover-shadow transition-all"
                                     draggable="true"
                                     @ondragstart="@(() => IniciarArrasto(BIWidgetTipo.GraficoLinhas))"
                                     @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.GraficoLinhas)"
                                     title="Arraste para o Canvas ou clique para inserir">
                                    <div class="p-2 bg-success-subtle text-success rounded-3"><i class="bi bi-graph-up"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Gráfico de Linhas</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Evolução Temporal</small>
                                    </div>
                                </div>

                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-grab hover-shadow transition-all"
                                     draggable="true"
                                     @ondragstart="@(() => IniciarArrasto(BIWidgetTipo.GraficoPizza))"
                                     @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.GraficoPizza)"
                                     title="Arraste para o Canvas ou clique para inserir">
                                    <div class="p-2 bg-warning-subtle text-warning rounded-3"><i class="bi bi-pie-chart-fill"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Gráfico de Pizza</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Distribuição Percentual</small>
                                    </div>
                                </div>

                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-grab hover-shadow transition-all"
                                     draggable="true"
                                     @ondragstart="@(() => IniciarArrasto(BIWidgetTipo.Tabela))"
                                     @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.Tabela)"
                                     title="Arraste para o Canvas ou clique para inserir">
                                    <div class="p-2 bg-secondary-subtle text-secondary rounded-3"><i class="bi bi-table"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Tabela Analítica</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Grid com paginação</small>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-3 text-muted opacity-25" />

                            <div class="px-1" data-tutorial="bi-datasources">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold small text-uppercase text-secondary" style="font-size: 0.72rem;">
                                        <i class="bi bi-hdd-network-fill me-1 text-success"></i> Fontes Conectadas
                                    </span>
                                    <span class="badge bg-primary-subtle text-primary border">@fontesMineracao.Count</span>
                                </div>
                                <div class="mb-2">
                                    <span class="badge bg-success-subtle text-success border w-100 text-start py-1 px-2" style="font-size: 0.66rem;">
                                        <i class="bi bi-broadcast me-1"></i>Conexão no Servidor Ativa
                                    </span>
                                </div>

                                @if (fontesMineracao.Count == 0)
                                {
                                    <p class="text-muted small mb-2">
                                        Nenhuma fonte disponível. Conecte uma tabela do servidor para começar.
                                    </p>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-1 small">
                                        @foreach (var fonte in fontesMineracao.Take(6))
                                        {
                                            <div class="d-flex justify-content-between align-items-center text-muted gap-2" title="@fonte.Descricao">
                                                <span class="text-truncate text-body">
                                                    <i class="bi @fonte.Icone me-1 text-@fonte.Cor"></i> @fonte.Nome
                                                </span>
                                                <span class="badge flex-shrink-0 @(fonte.ConexaoServidor ? "bg-success-subtle text-success" : "bg-info-subtle text-info") border" style="font-size: 0.62rem;">
                                                    @fonte.TipoConexao
                                                </span>
                                            </div>
                                        }
                                        @if (fontesMineracao.Count > 6)
                                        {
                                            <span class="text-muted" style="font-size: 0.72rem;">
                                                + @(fontesMineracao.Count - 6) outra(s) fonte(s)
                                            </span>
                                        }
                                    </div>
                                }

                                <button class="btn btn-sm btn-outline-primary w-100 mt-2 rounded-3"
                                        @onclick="() => isFontesModalOpen = true">
                                    <i class="bi bi-hdd-network me-1"></i> Fontes &amp; Servidor
                                </button>
                            </div>
                        </div>
                    </div>
                </aside>

                <!-- COLUNA CENTRAL: Canvas Interativo do BI (Drag-and-Drop Dropzone) -->
                <main class="col-12 col-lg-7 d-flex flex-column">
                    <div class="card card-modern border-0 h-100 overflow-hidden d-flex flex-column" data-tutorial="bi-canvas">
                        <div class="card-header border-bottom py-2 px-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary text-white rounded-pill px-3 py-1 fw-semibold">
                                    <i class="bi bi-bounding-box-circles me-1"></i> Canvas Central
                                </span>
                                <span class="text-muted small">
                                    @((DashboardAtivo?.Widgets?.Count ?? 0) == 0 ? "Nenhum widget ativo" : $"{DashboardAtivo?.Widgets?.Count} widgets no painel")
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <button class="btn btn-xs btn-outline-info rounded-3 py-1 px-2 border-0"
                                        @onclick="AbrirTutorialPagina" title="Instruções da Página / Ajuda">
                                    <i class="bi bi-question-circle me-1"></i> Ajuda
                                </button>
                                <button class="btn btn-xs btn-outline-primary rounded-3 py-1 px-2 border-0"
                                        @onclick="() => isTemplatesModalOpen = true" title="Modelos Prontos de Dashboard">
                                    <i class="bi bi-magic me-1"></i> Templates
                                </button>
                                <button class="btn btn-xs btn-outline-danger rounded-3 py-1 px-2 border-0"
                                        @onclick="LimparCanvas" title="Limpar Widgets">
                                    <i class="bi bi-trash3 me-1"></i> Limpar
                                </button>
                            </div>
                        </div>

                        <!-- Área de Montagem do Canvas (Zona de Drop HTML5/Blazor) -->
                        <div class="card-body p-3 bg-body-tertiary overflow-y-auto flex-grow-1 position-relative transition-all @(IsDragOverCanvas ? "border border-primary border-3 bg-primary-subtle" : "")"
                             id="biCanvasArea"
                             data-tutorial="bi-canvas-body"
                             style="min-height: 480px;"
                             @ondragover="TratarDragOver"
                             @ondragover:preventDefault="true"
                             @ondrop="TratarDrop">

                            @if (IsDragOverCanvas)
                            {
                                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-body bg-opacity-75 z-3">
                                    <div class="p-3 bg-primary text-white rounded-4 shadow-lg text-center animate-bounce">
                                        <i class="bi bi-plus-circle fs-1 d-block mb-1"></i>
                                        <span class="fw-bold">Solte aqui para inserir no Canvas!</span>
                                    </div>
                                </div>
                            }

                            @if (IsCarregando)
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 p-5 text-muted">
                                    <div class="spinner-border text-primary mb-3" role="status"></div>
                                    <p class="fw-semibold mb-0">Carregando painel e configurações analíticas...</p>
                                </div>
                            }
                            else if (DashboardAtivo == null || !DashboardAtivo.Widgets.Any())
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 p-5 text-center text-muted border border-2 border-dashed rounded-4 card-modern m-2">
                                    <div class="display-3 text-primary opacity-25 mb-3">
                                        <i class="bi bi-grid-1x2"></i>
                                    </div>
                                    <h5 class="fw-bold text-body">Canvas Vazio</h5>
                                    <p class="small text-muted mb-3" style="max-width: 440px;">
                                        Arraste um componente da barra esquerda, aplique um template pronto ou utilize o Agente de IA para gerar seus gráficos automaticamente.
                                    </p>
                                    <div class="d-flex gap-2 flex-wrap justify-content-center">
                                        <button class="btn btn-sm btn-primary rounded-3 px-3 shadow-sm" @onclick="() => AplicarTemplateAsync(1)">
                                            <i class="bi bi-speedometer2 me-1"></i> Template Executivo
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary rounded-3 px-3" @onclick="() => AplicarTemplateAsync(2)">
                                            <i class="bi bi-bar-chart-line me-1"></i> Template Operacional
                                        </button>
                                        <button class="btn btn-sm btn-outline-warning rounded-3 px-3 text-dark fw-semibold" @onclick="() => AplicarTemplateAsync(3)">
                                            <i class="bi bi-cpu me-1"></i> Template Mineração IA
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">
                                    @foreach (var widget in DashboardAtivo.Widgets)
                                    {
                                        <div class="@ObterClasseGridWidget(widget.LarguraColunas) transition-all" @key="widget.Id">
                                            <BIWidgetView Widget="widget"
                                                          IsEditor="true"
                                                          IsSelected="@(WidgetSelecionado?.Id == widget.Id)"
                                                          Datasets="datasetsDisponiveis"
                                                          OnEdit="() => SelecionarWidget(widget)"
                                                          OnDelete="() => RemoverWidget(widget.Id)" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </main>

                <!-- COLUNA DIREITA: Inspetor de Propriedades & Agente IA (Fase 4) -->
                <aside class="col-12 col-lg-3 d-flex flex-column">
                    <div class="card card-modern border-0 h-100 overflow-hidden d-flex flex-column">
                        <div class="card-header border-bottom py-2 px-3 d-flex align-items-center justify-content-between">
                            <ul class="nav nav-pills card-header-pills gap-1">
                                <li class="nav-item">
                                    <button class="nav-link py-1 px-3 small rounded-3 @(AbaDireitaAtiva == "ia" ? "active" : "")"
                                            data-tutorial="bi-ai-tab"
                                            @onclick='() => AbaDireitaAtiva = "ia"'>
                                        <i class="bi bi-stars me-1 text-warning"></i> Consultor IA
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link py-1 px-3 small rounded-3 @(AbaDireitaAtiva == "propriedades" ? "active" : "")"
                                            data-tutorial="bi-inspector-tab"
                                            @onclick='() => AbaDireitaAtiva = "propriedades"'>
                                        <i class="bi bi-sliders me-1"></i> Inspector
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <div class="card-body p-3 flex-grow-1 overflow-y-auto d-flex flex-column justify-content-between">
                            @if (AbaDireitaAtiva == "ia")
                            {
                                <!-- Painel do Agente de IA do BI (Fase 4 Conversacional) -->
                                <div class="d-flex flex-column h-100 justify-content-between">
                                    <div class="overflow-y-auto mb-2 flex-grow-1 pe-1" style="max-height: calc(100vh - 350px);">
                                        <div class="p-2 bg-gradient rounded-3 text-white mb-2"
                                             style="background: linear-gradient(135deg, #1e293b, #334155);">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="bi bi-robot fs-5 text-warning"></i>
                                                <span class="fw-bold small">Consultor Executivo BI</span>
                                            </div>
                                            <p class="small text-white-50 mb-0" style="font-size: 0.72rem;">
                                                Peça análises de dados, mineração K-Means, previsões ou comandos para criar gráficos no Canvas.
                                            </p>
                                        </div>

                                        <!-- Histórico do Chat -->
                                        <div class="d-flex flex-column gap-2 mb-2">
                                            @foreach (var msg in HistoricoChat)
                                            {
                                                <div class="p-2 rounded-3 small @(msg.Remetente == "Usuario" ? "bg-primary text-white ms-auto text-end" : "bg-light border text-dark me-auto")"
                                                     style="max-width: 90%; font-size: 0.78rem;">
                                                    <span class="d-block fw-bold mb-1" style="font-size: 0.68rem; opacity: 0.8;">
                                                        @(msg.Remetente == "Usuario" ? "Você" : "Consultor IA") • @msg.Horario.ToString("HH:mm")
                                                    </span>
                                                    <span>@msg.Texto</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Sugestões Rápidas de Comandos -->
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        <button class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.7rem;"
                                                @onclick='() => ExecutarPromptRapido("Crie um resumo executivo com KPIs de faturamento")'>
                                            + KPIs Vendas
                                        </button>
                                        <button class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.7rem;"
                                                @onclick='() => ExecutarPromptRapido("Execute clusterização K-Means dos clientes")'>
                                            + K-Means
                                        </button>
                                        <button class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.7rem;"
                                                @onclick='() => ExecutarPromptRapido("Calcule a curva ABC dos itens mais vendidos")'>
                                            + Curva ABC
                                        </button>
                                    </div>

                                    <!-- Campo de Entrada do Chat -->
                                    <div class="pt-2 border-top">
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control rounded-start-3"
                                                   placeholder="Instrua o Consultor de IA..."
                                                   @bind="PromptIaRapido"
                                                   @onkeyup="TratarEnterPromptIa" />
                                            <button class="btn btn-primary rounded-end-3 px-3" @onclick="EnviarInstrucaoIaAsync">
                                                <i class="bi bi-send-fill"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Painel de Propriedades do Widget Selecionado (Inspector) -->
                                @if (WidgetSelecionado == null)
                                {
                                    <div class="text-center text-muted p-4">
                                        <i class="bi bi-cursor fs-1 opacity-25 d-block mb-2"></i>
                                        <span class="small">Selecione um widget no Canvas para editar título, métricas, cores e largura de colunas.</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-3">
                                        <div>
                                            <label class="form-label small fw-semibold text-secondary">Título do Widget</label>
                                            <input type="text" class="form-control form-control-sm rounded-3" @bind="WidgetSelecionado.Titulo" />
                                        </div>

                                        <div>
                                            <label class="form-label small fw-semibold text-secondary">Subtítulo / Descrição</label>
                                            <input type="text" class="form-control form-control-sm rounded-3" @bind="WidgetSelecionado.Subtitulo" />
                                        </div>

                                        <div>
                                            <label class="form-label small fw-semibold text-secondary">Tipo de Widget</label>
                                            <select class="form-select form-select-sm rounded-3" @bind="WidgetSelecionado.Tipo">
                                                <option value="@BIWidgetTipo.CardKpi">Card Indicador (KPI)</option>
                                                <option value="@BIWidgetTipo.GraficoBarras">Gráfico de Barras</option>
                                                <option value="@BIWidgetTipo.GraficoLinhas">Gráfico de Linhas</option>
                                                <option value="@BIWidgetTipo.GraficoPizza">Gráfico de Pizza</option>
                                                <option value="@BIWidgetTipo.Tabela">Tabela Analítica</option>
                                            </select>
                                        </div>

                                        <div>
                                            <label class="form-label small fw-semibold text-secondary">Fonte de Dados</label>
                                            <select class="form-select form-select-sm rounded-3" @bind="WidgetSelecionado.FonteDadosId" @bind:after="AjustarFonteWidgetSelecionado">
                                                @foreach (var f in fontesMineracao)
                                                {
                                                    <option value="@f.Id">@f.Nome</option>
                                                }
                                                @foreach (var ds in datasetsDisponiveis)
                                                {
                                                    <option value="@($"dataset_{ds.Id}")">Dataset: @ds.Nome</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="row g-2">
                                            <div class="col-6">
                                                <label class="form-label small fw-semibold text-secondary">Métrica (Valor)</label>
                                                <input type="text" class="form-control form-control-sm rounded-3" list="metricasInspector" @bind="WidgetSelecionado.MetricaCampo" />
                                                <datalist id="metricasInspector">
                                                    @foreach (var m in ObterMetricasFonteWidget())
                                                    {
                                                        <option value="@m"></option>
                                                    }
                                                </datalist>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-semibold text-secondary">Dimensão (Eixo)</label>
                                                <input type="text" class="form-control form-control-sm rounded-3" list="dimensoesInspector" @bind="WidgetSelecionado.DimensaoCampo" />
                                                <datalist id="dimensoesInspector">
                                                    @foreach (var d in ObterDimensoesFonteWidget())
                                                    {
                                                        <option value="@d"></option>
                                                    }
                                                </datalist>
                                            </div>
                                        </div>

                                        <div class="row g-2">
                                            <div class="col-6">
                                                <label class="form-label small fw-semibold text-secondary">Agregação</label>
                                                <select class="form-select form-select-sm rounded-3" @bind="WidgetSelecionado.Agregacao">
                                                    <option value="Soma">Soma</option>
                                                    <option value="Media">Média</option>
                                                    <option value="Contagem">Contagem</option>
                                                    <option value="Max">Máximo</option>
                                                    <option value="Min">Mínimo</option>
                                                </select>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-semibold text-secondary">Formato</label>
                                                <select class="form-select form-select-sm rounded-3" @bind="WidgetSelecionado.FormatoValor">
                                                    <option value="Moeda">Moeda (R$)</option>
                                                    <option value="Numero">Número</option>
                                                    <option value="Percentual">Percentual (%)</option>
                                                    <option value="Decimal">Decimal</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div>
                                            <label class="form-label small fw-semibold text-secondary">Largura na Grade</label>
                                            <select class="form-select form-select-sm rounded-3" @bind="WidgetSelecionado.LarguraColunas">
                                                <option value="4">Pequeno (4 colunas - 1/3 da tela)</option>
                                                <option value="6">Médio (6 colunas - 1/2 da tela)</option>
                                                <option value="8">Grande (8 colunas - 2/3 da tela)</option>
                                                <option value="12">Largura Total (12 colunas)</option>
                                            </select>
                                        </div>

                                        <div>
                                            <label class="form-label small fw-semibold text-secondary">Cor do Destaque</label>
                                            <select class="form-select form-select-sm rounded-3" @bind="WidgetSelecionado.CorDestaque">
                                                <option value="primary">Azul (Primary)</option>
                                                <option value="success">Verde (Success)</option>
                                                <option value="warning">Amarelo (Warning)</option>
                                                <option value="info">Ciano (Info)</option>
                                                <option value="danger">Vermelho (Danger)</option>
                                                <option value="dark">Escuro (Dark)</option>
                                            </select>
                                        </div>

                                        @if (WidgetSelecionado.Tipo == BIWidgetTipo.CardKpi)
                                        {
                                            <div>
                                                <label class="form-label small fw-semibold text-secondary">Valor do Indicador</label>
                                                <input type="number" class="form-control form-control-sm rounded-3" @bind="WidgetSelecionado.ValorAtual" />
                                            </div>
                                        }

                                        <button class="btn btn-sm btn-outline-danger rounded-3 mt-2" @onclick="() => RemoverWidget(WidgetSelecionado.Id)">
                                            <i class="bi bi-trash me-1"></i> Excluir do Canvas
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </aside>
            </div>
        </div>

        @* ========================================================================= *@
        @* MODAIS AUXILIARES: TEMPLATES, IMPORTAÇÃO, MINERAÇÃO & COMPARTILHAMENTO    *@
        @* ========================================================================= *@

        <!-- Modal de Seleção de Templates (Fase 2) -->
        @if (isTemplatesModalOpen)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.72); backdrop-filter: blur(4px); z-index: 1055;">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                        <div class="modal-header bi-modal-header p-3 border-0">
                            <h5 class="modal-title fw-bold mb-0 text-white" style="color: #ffffff !important;">
                                <i class="bi bi-magic me-2 text-warning"></i>Escolha um Template de Painel
                            </h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="() => isTemplatesModalOpen = false"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <div class="card h-100 border rounded-4 p-3 hover-shadow transition-all text-center cursor-pointer"
                                         @onclick="() => AplicarTemplateAsync(1)">
                                        <div class="p-3 bg-primary-subtle text-primary rounded-circle d-inline-flex mx-auto mb-2">
                                            <i class="bi bi-speedometer2 fs-3"></i>
                                        </div>
                                        <h6 class="fw-bold text-body mb-1">Resumo Executivo</h6>
                                        <p class="text-muted small mb-3" style="font-size: 0.75rem;">
                                            3 Indicadores (KPIs) de faturamento, pedidos e clientes + Gráficos de vendas e evolução.
                                        </p>
                                        <button class="btn btn-sm btn-primary rounded-3 w-100 mt-auto">Aplicar Template</button>
                                    </div>
                                </div>

                                <div class="col-12 col-md-4">
                                    <div class="card h-100 border rounded-4 p-3 hover-shadow transition-all text-center cursor-pointer"
                                         @onclick="() => AplicarTemplateAsync(2)">
                                        <div class="p-3 bg-success-subtle text-success rounded-circle d-inline-flex mx-auto mb-2">
                                            <i class="bi bi-bar-chart-line fs-3"></i>
                                        </div>
                                        <h6 class="fw-bold text-body mb-1">Análise Operacional</h6>
                                        <p class="text-muted small mb-3" style="font-size: 0.75rem;">
                                            Comparativo por categoria, pizza de canais e grade analítica de transações.
                                        </p>
                                        <button class="btn btn-sm btn-success rounded-3 w-100 mt-auto">Aplicar Template</button>
                                    </div>
                                </div>

                                <div class="col-12 col-md-4">
                                    <div class="card h-100 border rounded-4 p-3 hover-shadow transition-all text-center cursor-pointer"
                                         @onclick="() => AplicarTemplateAsync(3)">
                                        <div class="p-3 bg-warning-subtle text-warning rounded-circle d-inline-flex mx-auto mb-2">
                                            <i class="bi bi-cpu fs-3"></i>
                                        </div>
                                        <h6 class="fw-bold text-body mb-1">Mineração &amp; IA</h6>
                                        <p class="text-muted small mb-3" style="font-size: 0.75rem;">
                                            Modelos K-Means, previsão de churn, curva ABC e projeções preditivas.
                                        </p>
                                        <button class="btn btn-sm btn-warning rounded-3 w-100 mt-auto text-dark fw-semibold">Aplicar Template</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Modal de Mineração de Dados K-Means & Curva ABC (Fase 3) -->
        @if (isDataMiningModalOpen)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.72); backdrop-filter: blur(4px); z-index: 1055;">
                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                        <div class="modal-header bi-modal-header p-3 border-0">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 bg-warning bg-opacity-25 rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                    <i class="bi bi-cpu-fill text-warning fs-4"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <h5 class="modal-title fw-bold mb-0 text-white" style="color: #ffffff !important;">
                                            Laboratório de Mineração de Dados (BI)
                                        </h5>
                                        <span class="badge bg-warning text-dark fw-bold rounded-pill px-2 py-1" style="font-size: 0.68rem;">
                                            K-MEANS &amp; CURVA ABC
                                        </span>
                                    </div>
                                    <small class="d-block" style="color: rgba(241, 245, 249, 0.88) !important;">
                                        Vincule uma fonte conectada ao servidor ou planilha importada para segmentar dados e gerar widgets analíticos
                                    </small>
                                </div>
                            </div>
                            <button type="button" class="btn-close btn-close-white" @onclick="() => isDataMiningModalOpen = false"></button>
                        </div>

                        <div class="modal-body p-4">
                            <!-- Seção 1: Vínculo de Fonte de Dados -->
                            <div class="bi-mining-card p-3 mb-3 shadow-xs">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-link-45deg fs-5 text-primary"></i>
                                        <span class="fw-bold text-body">1. Fonte de Dados Vinculada para Mineração</span>
                                        @if (EhFonteServidorMineracao)
                                        {
                                            <span class="badge bg-success-subtle text-success border">
                                                <i class="bi bi-hdd-network me-1"></i>CONEXÃO NO SERVIDOR
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info border">
                                                <i class="bi bi-file-earmark-spreadsheet me-1"></i>DATASET IMPORTADO
                                            </span>
                                        }
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-xs btn-outline-primary rounded-3 py-1 px-2 small"
                                                @onclick="AbrirGerenciadorFontesDaMineracao">
                                            <i class="bi bi-hdd-network me-1"></i> Conectar Tabela do Servidor
                                        </button>
                                        <button type="button" class="btn btn-xs btn-outline-success rounded-3 py-1 px-2 small"
                                                @onclick="AbrirImportacaoDaMineracaoAsync">
                                            <i class="bi bi-file-earmark-arrow-up me-1"></i> Importar CSV / JSON
                                        </button>
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center">
                                    <div class="col-12 col-lg-7">
                                        <select class="form-select form-select-sm fw-semibold"
                                                @bind="fonteMineracaoSelecionadaId"
                                                @bind:after="AjustarCamposMineracao">
                                            @if (fontesMineracao.Any(f => f.OrigemId.HasValue))
                                            {
                                                <optgroup label="Tabelas Sincronizadas no Servidor (Banco de Dados)">
                                                    @foreach (var fonte in fontesMineracao.Where(f => f.OrigemId.HasValue))
                                                    {
                                                        <option value="@fonte.Id">🗄️ [Servidor] @fonte.Nome</option>
                                                    }
                                                </optgroup>
                                            }
                                            <optgroup label="Módulos Integrados no Servidor JT">
                                                @foreach (var fonte in fontesMineracao.Where(f => !f.OrigemId.HasValue))
                                                {
                                                    <option value="@fonte.Id">🌐 [Módulo Servidor] @fonte.Nome</option>
                                                }
                                            </optgroup>
                                            @if (datasetsDisponiveis.Any())
                                            {
                                                <optgroup label="Planilhas e Datasets Importados (CSV / JSON)">
                                                    @foreach (var ds in datasetsDisponiveis)
                                                    {
                                                        <option value="@($"dataset_{ds.Id}")">📊 [Importado] @ds.Nome (@ds.QtdLinhas linhas)</option>
                                                    }
                                                </optgroup>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-lg-5">
                                        <div class="small text-muted text-truncate" title="@DescricaoFonteMineracaoAtual">
                                            <i class="bi bi-info-circle me-1 text-primary"></i>@DescricaoFonteMineracaoAtual
                                        </div>
                                    </div>
                                </div>

                                @if (ColunasMineracao.Count > 0)
                                {
                                    <div class="mt-2 pt-2 border-top d-flex align-items-center flex-wrap gap-1">
                                        <span class="text-muted small me-1" style="font-size: 0.74rem;">Campos disponíveis na fonte:</span>
                                        @foreach (var col in ColunasMineracao.Take(10))
                                        {
                                            <span class="badge bg-body-secondary text-body border" style="font-size: 0.7rem;">@col</span>
                                        }
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(mensagemMineracaoModal))
                            {
                                <div class="alert @classeMensagemMineracaoModal py-2 px-3 small rounded-3 mb-3 d-flex align-items-center justify-content-between">
                                    <span><i class="bi bi-check2-circle me-1"></i> @mensagemMineracaoModal</span>
                                    <button type="button" class="btn-close btn-sm" @onclick="() => mensagemMineracaoModal = null"></button>
                                </div>
                            }

                            <!-- Seção 2: Algoritmos de Mineração -->
                            <div class="row g-3">
                                <!-- Clusterização K-Means -->
                                <div class="col-12 col-lg-6">
                                    <div class="bi-mining-card p-3 h-100 d-flex flex-column justify-content-between shadow-xs">
                                        <div>
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="p-2 bg-primary-subtle text-primary rounded-3">
                                                        <i class="bi bi-diagram-3-fill fs-5"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="fw-bold mb-0">Clusterização K-Means</h6>
                                                        <small class="text-muted" style="font-size: 0.74rem;">Agrupamento multidimensional por similaridade (Z-Score)</small>
                                                    </div>
                                                </div>
                                                <span class="badge bg-primary-subtle text-primary border">3 Widgets</span>
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label small fw-bold mb-1">Quantidade de Grupos (Clusters K):</label>
                                                <select class="form-select form-select-sm" @bind="kMeansK">
                                                    <option value="2">2 Grupos (Alto Valor vs Baixo Valor)</option>
                                                    <option value="3">3 Grupos (Recomendado: VIP, Médio Potencial, Em Risco)</option>
                                                    <option value="4">4 Grupos (Segmentação Detalhada)</option>
                                                    <option value="5">5 Grupos (Micro-segmentação Executiva)</option>
                                                </select>
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label small fw-bold mb-1">Campo de Identificação (Dimensão / Rótulo):</label>
                                                <select class="form-select form-select-sm" @bind="campoMineracaoNome">
                                                    @foreach (var col in ColunasMineracao)
                                                    {
                                                        <option value="@col">@col</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="row g-2 mb-3">
                                                <div class="col-6">
                                                    <label class="form-label small fw-bold mb-1">Métrica 1 (Eixo X / Valor):</label>
                                                    <select class="form-select form-select-sm" @bind="campoMineracaoValor1">
                                                        @foreach (var col in MetricasMineracao)
                                                        {
                                                            <option value="@col">@col</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small fw-bold mb-1">Métrica 2 (Eixo Y / Volume):</label>
                                                    <select class="form-select form-select-sm" @bind="campoMineracaoValor2">
                                                        @foreach (var col in MetricasMineracao)
                                                        {
                                                            <option value="@col">@col</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-3 flex-grow-1"
                                                    @onclick="PrevisualizarKMeansAsync">
                                                <i class="bi bi-eye me-1"></i> Testar / Pré-visualizar
                                            </button>
                                            <button type="button" class="btn btn-sm btn-primary rounded-3 flex-grow-1 fw-semibold"
                                                    @onclick="ExecutarKMeansNoCanvasAsync">
                                                <i class="bi bi-play-fill me-1"></i> Executar e Injetar no Canvas
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Classificação Curva ABC -->
                                <div class="col-12 col-lg-6">
                                    <div class="bi-mining-card p-3 h-100 d-flex flex-column justify-content-between shadow-xs">
                                        <div>
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="p-2 bg-success-subtle text-success rounded-3">
                                                        <i class="bi bi-pie-chart-fill fs-5"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="fw-bold mb-0">Classificação Curva ABC (Pareto)</h6>
                                                        <small class="text-muted" style="font-size: 0.74rem;">Classifica relevância em Classe A (80%), B (15%) e C (5%)</small>
                                                    </div>
                                                </div>
                                                <span class="badge bg-success-subtle text-success border">2 Widgets</span>
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label small fw-bold mb-1">Campo de Identificação (Item / Cliente / Categoria):</label>
                                                <select class="form-select form-select-sm" @bind="campoMineracaoNome">
                                                    @foreach (var col in ColunasMineracao)
                                                    {
                                                        <option value="@col">@col</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small fw-bold mb-1">Campo de Valor (Faturamento / Volume para Ranking):</label>
                                                <select class="form-select form-select-sm" @bind="campoMineracaoValorAbc">
                                                    @foreach (var col in MetricasMineracao)
                                                    {
                                                        <option value="@col">@col</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="p-2 rounded-3 bg-body-tertiary border small text-muted mb-3" style="font-size: 0.74rem;">
                                                <i class="bi bi-lightbulb text-warning me-1"></i>
                                                <strong>Regra de Pareto:</strong> Identifica automaticamente quais itens da fonte vinculada concentram 80% do resultado financeiro.
                                            </div>
                                        </div>

                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-success rounded-3 flex-grow-1"
                                                    @onclick="PrevisualizarCurvaAbcAsync">
                                                <i class="bi bi-eye me-1"></i> Testar / Pré-visualizar
                                            </button>
                                            <button type="button" class="btn btn-sm btn-success rounded-3 flex-grow-1 fw-semibold"
                                                    @onclick="ExecutarCurvaAbcNoCanvasAsync">
                                                <i class="bi bi-play-fill me-1"></i> Calcular e Injetar no Canvas
                                            </button>
