                        <div class="modal-footer bg-light border-0 p-3 d-flex justify-content-between align-items-center">
                            <span class="text-muted small">
                                <i class="bi bi-hdd-network text-success me-1"></i> Os resultados injetados no Canvas ficam vinculados ao painel ativo.
                            </span>
                            <button type="button" class="btn btn-sm btn-secondary rounded-3 px-4" @onclick="() => isDataMiningModalOpen = false">Fechar</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Modal Fontes de Dados (EDW) -->
