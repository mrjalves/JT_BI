    // =========================================================================
    // FASE 3: MINERAÇÃO DE DADOS & UPLOAD
    // =========================================================================

    private async Task ExecutarKMeansNoCanvasAsync()
    {
        if (DashboardAtivo == null) return;

        // Amostra de registros para clustering
        var registros = new List<Dictionary<string, string>>
        {
            new() { ["Cliente"] = "Restaurante Sabor & Arte", ["TicketMedio"] = "1850", ["Frequencia"] = "28" },
            new() { ["Cliente"] = "Padaria Central", ["TicketMedio"] = "920", ["Frequencia"] = "14" },
            new() { ["Cliente"] = "Mercado do Povo", ["TicketMedio"] = "3400", ["Frequencia"] = "45" },
            new() { ["Cliente"] = "Bar & Petiscos", ["TicketMedio"] = "450", ["Frequencia"] = "6" },
            new() { ["Cliente"] = "Lanchonete 24h", ["TicketMedio"] = "1200", ["Frequencia"] = "22" },
            new() { ["Cliente"] = "Pizzaria Bella", ["TicketMedio"] = "2800", ["Frequencia"] = "38" }
        };

        var resultado = DataMiningService.ExecutarKMeans(registros, "Cliente", "TicketMedio", "Frequencia", kMeansK);
        var widgets = DataMiningService.GerarWidgetsMinacao(resultado);

        foreach (var w in widgets)
        {
            DashboardAtivo.Widgets.Add(w);
        }

        isDataMiningModalOpen = false;
        await SalvarDashboardAtualAsync();
        ExibirFeedback(resultado.ResumoExecutivo, "alert-success");
    }

    private async Task ExecutarCurvaAbcNoCanvasAsync()
    {
        if (DashboardAtivo == null) return;

        var registros = new List<Dictionary<string, string>>
        {
            new() { ["Produto"] = "Combo Executivo", ["Valor"] = "45200" },
            new() { ["Produto"] = "Pizza Artesanal", ["Valor"] = "28400" },
            new() { ["Produto"] = "Bebidas & Refrigerantes", ["Valor"] = "14200" },
            new() { ["Produto"] = "Sobremesas Especiais", ["Valor"] = "6800" },
            new() { ["Produto"] = "Porções & Aperitivos", ["Valor"] = "3200" }
        };

        var resultado = DataMiningService.CalcularCurvaAbc(registros, "Produto", "Valor");
        var widgets = DataMiningService.GerarWidgetsCurvaAbc(resultado);

        foreach (var w in widgets)
        {
            DashboardAtivo.Widgets.Add(w);
        }

        isDataMiningModalOpen = false;
        await SalvarDashboardAtualAsync();
        ExibirFeedback($"Curva ABC calculada: {resultado.QtdClasseA} itens na Classe A (80% da receita).", "alert-success");
    }

    private void TratarDashboardCriado(BIDashboard novo)
    {
        ListaDashboards.Insert(0, novo);
        DashboardAtivo = novo;
        WidgetSelecionado = null;
        ExibirFeedback($"Dashboard '{novo.Nome}' importado com sucesso!", "alert-success");
    }

    // =========================================================================
    // FASE 4: AGENTE DE IA (CONSULTOR EXECUTIVO BI)
    // =========================================================================

    private async Task EnviarInstrucaoIaAsync()
    {
        if (string.IsNullOrWhiteSpace(PromptIaRapido)) return;

        var prompt = PromptIaRapido.Trim();
        PromptIaRapido = string.Empty;

        HistoricoChat.Add(new MensagemChatBI
        {
            Remetente = "Usuario",
            Texto = prompt,
            Horario = DateTime.Now
        });

        if (prompt.Contains("kmeans", StringComparison.OrdinalIgnoreCase) || prompt.Contains("cluster", StringComparison.OrdinalIgnoreCase))
        {
            await ExecutarKMeansNoCanvasAsync();
            HistoricoChat.Add(new MensagemChatBI
            {
                Remetente = "IA",
                Texto = "Executei a mineração K-Means e inseri os gráficos de segmentação de clientes diretamente no seu Canvas!",
                Horario = DateTime.Now
            });
        }
        else if (prompt.Contains("abc", StringComparison.OrdinalIgnoreCase) || prompt.Contains("pareto", StringComparison.OrdinalIgnoreCase))
        {
            await ExecutarCurvaAbcNoCanvasAsync();
            HistoricoChat.Add(new MensagemChatBI
            {
                Remetente = "IA",
                Texto = "Calculei a Curva ABC e adicionei o KPI da Classe A e o gráfico de distribuição no Canvas.",
                Horario = DateTime.Now
            });
        }
        else if (prompt.Contains("executivo", StringComparison.OrdinalIgnoreCase) || prompt.Contains("template 1", StringComparison.OrdinalIgnoreCase))
        {
            await AplicarTemplateAsync(1);
            HistoricoChat.Add(new MensagemChatBI
            {
                Remetente = "IA",
                Texto = "Template Executivo aplicado! Configurei os KPIs principais e a evolução financeira diária.",
                Horario = DateTime.Now
            });
        }
        else if (prompt.Contains("operacional", StringComparison.OrdinalIgnoreCase) || prompt.Contains("vendas", StringComparison.OrdinalIgnoreCase))
        {
            await AplicarTemplateAsync(2);
            HistoricoChat.Add(new MensagemChatBI
            {
                Remetente = "IA",
                Texto = "Template Operacional aplicado com comparativo de categorias e canais de aquisição.",
                Horario = DateTime.Now
            });
        }
        else if (prompt.Contains("barra", StringComparison.OrdinalIgnoreCase))
        {
            AdicionarWidgetRapido(BIWidgetTipo.GraficoBarras);
            HistoricoChat.Add(new MensagemChatBI
            {
                Remetente = "IA",
                Texto = "Gráfico de Barras adicionado com sucesso ao Canvas!",
                Horario = DateTime.Now
            });
        }
        else if (prompt.Contains("linha", StringComparison.OrdinalIgnoreCase) || prompt.Contains("tendência", StringComparison.OrdinalIgnoreCase))
        {
            AdicionarWidgetRapido(BIWidgetTipo.GraficoLinhas);
            HistoricoChat.Add(new MensagemChatBI
            {
                Remetente = "IA",
                Texto = "Gráfico de Linhas de tendência temporal adicionado!",
                Horario = DateTime.Now
            });
        }
        else if (prompt.Contains("pizza", StringComparison.OrdinalIgnoreCase))
        {
            AdicionarWidgetRapido(BIWidgetTipo.GraficoPizza);
            HistoricoChat.Add(new MensagemChatBI
            {
                Remetente = "IA",
                Texto = "Gráfico de Pizza para proporções percentuais gerado no Canvas!",
                Horario = DateTime.Now
            });
        }
        else if (prompt.Contains("kpi", StringComparison.OrdinalIgnoreCase) || prompt.Contains("total", StringComparison.OrdinalIgnoreCase))
        {
            AdicionarWidgetRapido(BIWidgetTipo.CardKpi);
            HistoricoChat.Add(new MensagemChatBI
            {
                Remetente = "IA",
                Texto = "Card KPI criado! Você pode editar o valor e o título no Inspector à direita.",
                Horario = DateTime.Now
            });
        }
        else if (prompt.Contains("limpar", StringComparison.OrdinalIgnoreCase))
        {
            LimparCanvas();
            HistoricoChat.Add(new MensagemChatBI
            {
                Remetente = "IA",
                Texto = "O Canvas foi limpo. O que você gostaria de construir agora?",
                Horario = DateTime.Now
            });
        }
        else
        {
            HistoricoChat.Add(new MensagemChatBI
            {
                Remetente = "IA",
                Texto = $"Analisando: '{prompt}'. Dica executiva: você pode pedir 'Crie o template executivo', 'Execute K-Means' ou 'Adicione um gráfico de barras'.",
                Horario = DateTime.Now
            });
        }

        StateHasChanged();
    }

    private async Task ExecutarPromptRapido(string prompt)
    {
        PromptIaRapido = prompt;
        await EnviarInstrucaoIaAsync();
    }

    private async Task TratarEnterPromptIa(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await EnviarInstrucaoIaAsync();
        }
    }

    // =========================================================================
    // FASE 5: COMPARTILHAMENTO & PERSISTÊNCIA
    // =========================================================================

    private async Task ExportarJsonDashboard()
    {
        if (DashboardAtivo == null) return;
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(DashboardAtivo, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", json);
            ExibirFeedback("Definições JSON do dashboard copiadas para a área de transferência!", "alert-info");
        }
        catch (Exception ex)
        {
            ExibirFeedback($"Erro ao exportar: {ex.Message}", "alert-danger");
        }
    }

    private async Task TrocarDashboardAsync(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            var encontrado = await DashboardService.ObterPorIdAsync(id);
            if (encontrado != null)
            {
                DashboardAtivo = encontrado;
                WidgetSelecionado = null;
            }
        }
    }

    private async Task NovoDashboardAsync()
    {
        var novo = new BIDashboard
        {
            Nome = $"Novo Painel #{ListaDashboards.Count + 1}",
            Descricao = "Painel analítico customizado",
            Categoria = "Personalizado",
            Icone = "bi-bar-chart-fill"
        };
        await DashboardService.SalvarAsync(novo);
        ListaDashboards.Insert(0, novo);
        DashboardAtivo = novo;
        WidgetSelecionado = null;
        ExibirFeedback("Novo dashboard criado com sucesso!", "alert-success");
    }

    private async Task SalvarDashboardAtualAsync()
    {
        if (DashboardAtivo == null) return;
        IsSalvando = true;
        try
        {
            await DashboardService.SalvarAsync(DashboardAtivo);
            ExibirFeedback("Dashboard e configurações salvas com sucesso!", "alert-success");
        }
        catch (Exception ex)
        {
            ExibirFeedback($"Erro ao salvar: {ex.Message}", "alert-danger");
        }
        finally
        {
            IsSalvando = false;
        }
    }

    private void AdicionarWidgetRapido(BIWidgetTipo tipo)
    {
        if (DashboardAtivo == null) return;

        var widget = new BIWidget
        {
            Id = Guid.NewGuid(),
            Tipo = tipo,
            Titulo = ObterTituloPadraoPorTipo(tipo),
            LarguraColunas = tipo == BIWidgetTipo.CardKpi ? 4 : (tipo == BIWidgetTipo.Tabela ? 12 : 6),
            CorTema = "primary",
            ValorAtual = tipo == BIWidgetTipo.CardKpi ? 12450m : null
        };

        DashboardAtivo.Widgets.Add(widget);
        WidgetSelecionado = widget;
        AbaDireitaAtiva = "propriedades";
        ExibirFeedback($"Widget '{widget.Titulo}' inserido no Canvas.", "alert-info");
    }

    private void SelecionarWidget(BIWidget widget)
    {
        WidgetSelecionado = widget;
        AbaDireitaAtiva = "propriedades";
    }

    private void RemoverWidget(Guid id)
    {
        if (DashboardAtivo == null) return;
        DashboardAtivo.Widgets.RemoveAll(w => w.Id == id);
        if (WidgetSelecionado?.Id == id) WidgetSelecionado = null;
        ExibirFeedback("Widget removido do Canvas.", "alert-secondary");
    }

    private void LimparCanvas()
    {
        if (DashboardAtivo == null) return;
        DashboardAtivo.Widgets.Clear();
        WidgetSelecionado = null;
        ExibirFeedback("Canvas limpo com sucesso.", "alert-secondary");
    }

    private void RecarregarAcesso()
    {
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private string ObterClasseGridWidget(int colunas) => colunas switch
    {
        12 => "col-12",
        8 => "col-12 col-xl-8",
        6 => "col-12 col-md-6",
        4 => "col-12 col-sm-6 col-lg-4",
        3 => "col-12 col-sm-6 col-lg-3",
        _ => "col-12 col-md-6"
    };

    private string ObterTituloPadraoPorTipo(BIWidgetTipo tipo) => tipo switch
    {
        BIWidgetTipo.CardKpi => "Novo Indicador KPI",
        BIWidgetTipo.GraficoBarras => "Comparativo em Barras",
        BIWidgetTipo.GraficoLinhas => "Tendência Temporal",
        BIWidgetTipo.GraficoPizza => "Distribuição Percentual",
        BIWidgetTipo.Tabela => "Tabela Analítica",
        _ => "Novo Widget"
    };

    private void ExibirFeedback(string msg, string classe)
    {
        MensagemFeedback = msg;
        ClasseFeedback = classe;
    }
}
