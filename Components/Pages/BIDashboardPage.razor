    private string campoMineracaoValor1 = "Faturamento";
    private string campoMineracaoValor2 = "Despesas";
    private string campoMineracaoValorAbc = "Faturamento";
    private KMeansResultado? previewKMeans;
    private ResultadoCurvaAbc? previewCurvaAbc;
    private string? mensagemMineracaoModal;
    private string classeMensagemMineracaoModal = "alert-info";

    // Drag and Drop (Fase 2)
    private BIWidgetTipo? tipoWidgetArrastando;
    private bool IsDragOverCanvas = false;

    // Histórico de Chat IA (Fase 4)
    private List<MensagemChatBI> HistoricoChat = new()
    {
        new MensagemChatBI
        {
            Remetente = "IA",
            Texto = "Olá! Sou o Consultor de Inteligência do JT_BI. Posso criar gráficos, rodar K-Means, analisar curva ABC ou sugerir métricas de negócio para o seu painel.",
            Horario = DateTime.Now
        }
    };

    // Controle de Permissão e Acesso SPA
    private bool IsCarregandoAcesso = true;
    private bool TemAcesso = false;

    private async Task VerificarAcessoAsync()
    {
        IsCarregandoAcesso = true;
        try
        {
            if (UserState.Autenticado)
            {
                // Administrador ou Supervisor tem acesso pleno garantido ao JT_BI Studio
                if (BIUsuarioContexto.De(UserState).AcessoTotal)
                {
                    TemAcesso = true;
                    return;
                }

                TemAcesso = await AcessoService.TemPermissaoAsync(eModuloSistema.Gestao, eAcaoPermissao.Ler);
            }
            else
            {
                TemAcesso = false;
            }
        }
        catch
        {
            TemAcesso = UserState.Autenticado;
        }
        finally
        {
            IsCarregandoAcesso = false;
        }
    }

    private Action? _stateChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        _stateChangedHandler = () => _ = InvokeAsync(async () =>
        {
            await VerificarAcessoAsync();
            if (TemAcesso)
            {
                await CarregarAmbienteAsync();
            }
            else
            {
                ListaDashboards.Clear();
                DashboardAtivo = null;
            }
            StateHasChanged();
        });

        UserState.OnStateChanged += _stateChangedHandler;

        await VerificarAcessoAsync();
        if (TemAcesso)
        {
            await CarregarAmbienteAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TemAcesso && DashboardId.HasValue && DashboardAtivo?.Id != DashboardId.Value)
        {
            var contexto = BIUsuarioContexto.De(UserState);
            var selecionado = ListaDashboards.FirstOrDefault(d => d.Id == DashboardId.Value)
                ?? await DashboardService.ObterAcessivelAsync(DashboardId.Value, contexto);

            if (selecionado != null)
            {
                if (ListaDashboards.All(d => d.Id != selecionado.Id))
                {
                    ListaDashboards.Insert(0, selecionado);
                }
                DashboardAtivo = selecionado;
                WidgetSelecionado = null;
            }
        }
    }

    public void Dispose()
    {
        if (_stateChangedHandler != null)
        {
            UserState.OnStateChanged -= _stateChangedHandler;
            _stateChangedHandler = null;
        }
    }

    private FonteDadosInfo? FonteMineracao
        => fontesMineracao.FirstOrDefault(f => string.Equals(f.Id, fonteMineracaoSelecionadaId, StringComparison.OrdinalIgnoreCase));

    private BIDataset? DatasetMineracao
        => fonteMineracaoSelecionadaId.StartsWith("dataset_", StringComparison.OrdinalIgnoreCase)
            ? datasetsDisponiveis.FirstOrDefault(d => $"dataset_{d.Id}" == fonteMineracaoSelecionadaId)
            : null;

    private bool EhFonteServidorMineracao
        => !fonteMineracaoSelecionadaId.StartsWith("dataset_", StringComparison.OrdinalIgnoreCase);

    private string DescricaoFonteMineracaoAtual
        => FonteMineracao?.Descricao
            ?? (DatasetMineracao != null
                ? $"Planilha importada ({DatasetMineracao.QtdLinhas} linhas, {DatasetMineracao.Colunas.Count} colunas)"
                : "Conexão ativa no servidor");

    private List<string> ColunasMineracao
    {
        get
        {
            if (DatasetMineracao != null)
            {
                return DatasetMineracao.Colunas
                    .Select(c => c.Nome)
                    .Where(n => !string.IsNullOrWhiteSpace(n))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }

            if (FonteMineracao != null)
            {
                return FonteMineracao.Dimensoes
                    .Concat(FonteMineracao.Metricas)
                    .Where(n => !string.IsNullOrWhiteSpace(n))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }

            return new List<string> { "Cliente", "Faturamento", "TicketMedio", "Frequencia" };
        }
    }

    private List<string> MetricasMineracao
    {
        get
        {
            if (DatasetMineracao != null)
            {
                var numericas = DatasetMineracao.Colunas
                    .Where(c => c.TipoDado == "Numero")
                    .Select(c => c.Nome)
                    .ToList();
                return numericas.Count > 0 ? numericas : ColunasMineracao;
            }

            if (FonteMineracao != null && FonteMineracao.Metricas.Count > 0)
            {
                return FonteMineracao.Metricas;
            }

            return ColunasMineracao;
        }
    }

    private void AjustarCamposMineracao()
    {
        previewKMeans = null;
        previewCurvaAbc = null;
        mensagemMineracaoModal = null;

        var colunas = ColunasMineracao;
        var metricas = MetricasMineracao;
        if (colunas.Count == 0) return;

        campoMineracaoNome = FonteMineracao?.Dimensoes.FirstOrDefault() ?? colunas[0];
        campoMineracaoValor1 = metricas.Count > 0 ? metricas[0] : (colunas.Count > 1 ? colunas[1] : colunas[0]);
        campoMineracaoValor2 = metricas.Count > 1 ? metricas[1] : campoMineracaoValor1;
        campoMineracaoValorAbc = metricas.Count > 0 ? metricas[0] : campoMineracaoValor1;
    }

    private async Task RecarregarFontesAsync()
    {
        try
        {
            var contexto = BIUsuarioContexto.De(UserState);
            fontesMineracao = await DataSourceService.ObterFontesDisponiveisAsync();
            datasetsDisponiveis = await DashboardService.ObterDatasetsVisiveisAsync(contexto);

            if (FonteMineracao == null && DatasetMineracao == null)
            {
                var preferida = fontesMineracao.FirstOrDefault(f => f.OrigemId.HasValue)
                    ?? fontesMineracao.FirstOrDefault();
                fonteMineracaoSelecionadaId = preferida?.Id ?? "financeiro";
                AjustarCamposMineracao();
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[JT_BI] Falha ao recarregar fontes: {ex.Message}");
        }
    }

    private async Task CarregarAmbienteAsync()
    {
        IsCarregando = true;
        try
        {
            try
            {
                var configGestao = await GestaoConfigService.GetAtivaAsync();
            }
            catch (Exception exGestao)
            {
                Console.WriteLine($"[JT_BI] Aviso ao obter GestaoConfig: {exGestao.Message}");
            }

            var contexto = BIUsuarioContexto.De(UserState);
            datasetsDisponiveis = await DashboardService.ObterDatasetsVisiveisAsync(contexto);
            var origensExistentes = await DataSourceService.ObterOrigensConfiguradasAsync();
            foreach (var ds in datasetsDisponiveis)
            {
                if (!origensExistentes.Any(o => string.Equals(o.Nome, ds.Nome, StringComparison.OrdinalIgnoreCase)))
                {
                    await DataSourceService.RegistrarDatasetComoFonteAsync(ds);
                }
            }
            fontesMineracao = await DataSourceService.ObterFontesDisponiveisAsync();

            var fonteMineracaoInicial = fontesMineracao.FirstOrDefault(f => f.OrigemId.HasValue)
                ?? fontesMineracao.FirstOrDefault();
            if (fonteMineracaoInicial != null)
            {
                fonteMineracaoSelecionadaId = fonteMineracaoInicial.Id;
                AjustarCamposMineracao();
            }
            ListaDashboards = await DashboardService.ObterVisiveisAsync(contexto);
            if (DashboardId.HasValue)
            {
                var selecionado = ListaDashboards.FirstOrDefault(d => d.Id == DashboardId.Value)
                    ?? await DashboardService.ObterAcessivelAsync(DashboardId.Value, contexto);

                if (selecionado != null)
                {
                    if (ListaDashboards.All(d => d.Id != selecionado.Id))
                    {
                        ListaDashboards.Insert(0, selecionado);
                    }
                    DashboardAtivo = selecionado;
                }
            }

            if (DashboardAtivo == null && ListaDashboards.Any())
            {
                DashboardAtivo = ListaDashboards.First();
            }
            else if (DashboardAtivo == null)
            {
                DashboardAtivo = new BIDashboard
                {
                    Nome = "Dashboard Executivo JT",
                    Descricao = "Painel corporativo de inteligência",
                    Categoria = "Geral",
                    Icone = "bi-speedometer2"
                };
                await DashboardService.SalvarAsync(DashboardAtivo, contexto);
                ListaDashboards.Add(DashboardAtivo);
            }

            if (DashboardAtivo.DatasetsVinculadosIds.Count > 0)
            {
                var vinculados = await DashboardService.ObterDatasetsPorIdsAsync(DashboardAtivo.DatasetsVinculadosIds);
                foreach (var ds in vinculados.Where(d => datasetsDisponiveis.All(x => x.Id != d.Id)))
                {
                    datasetsDisponiveis.Add(ds);
                }
            }
        }
        catch (Exception ex)
        {
            MensagemFeedback = $"Aviso ao carregar ambiente: {ex.Message}";
            ClasseFeedback = "alert-warning";
        }
        finally
        {
            IsCarregando = false;
        }
    }

