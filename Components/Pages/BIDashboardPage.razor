@page "/"
@page "/bi"
@page "/bidashboard"
@rendermode InteractiveServer

@using JT_BI.Models
@using JT_BI.Services
@using JT_BI.Components.BI
@using JT_Aplicacao.Classes
@using JT_Classes.Acessos
@using JT_Servicos.Gestao
@using JT_UserInterface.Shared
@using JT_UserInterface.Shared.Components.Acessos
@using JT_UserInterface.Shared.Services.Interfaces.Acessos
@using JT_UserInterface.Shared.Services.Comum

@inject MGestaoConfiguracaoService GestaoConfigService
@inject IAcessoService AcessoService
@inject CurrentUserState UserState
@inject IBIDashboardService DashboardService
@inject IBIDataSourceService DataSourceService
@inject IBIImportService ImportService
@inject ToastService ToastService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>JT_BI - Painel Central de Inteligência</PageTitle>

@* ========================================================================= *@
@* FASE 1: VALIDAÇÃO DE SEGURANÇA E ACESSO AUTORIZADO                       *@
@* ========================================================================= *@
<AcessoAutorizado Modulo="eModuloSistema.Gestao" Acao="eAcaoPermissao.Ler">
    <ChildContent>
        <div class="bi-spa-wrapper d-flex flex-column h-100">
            <!-- Barra Superior Executiva SPA -->
            <header class="bi-header card border-0 shadow-sm rounded-4 mb-3 overflow-hidden bg-white">
                <div class="card-body py-2 px-3">
                    <div class="row g-2 align-items-center justify-content-between">
                        <!-- Identificação do Módulo e Dashboard Ativo -->
                        <div class="col-12 col-md-4 d-flex align-items-center gap-2">
                            <div class="bi-brand-icon p-2 bg-gradient text-white rounded-3 shadow-sm d-flex align-items-center justify-content-center"
                                 style="background: linear-gradient(135deg, #2563eb, #3b82f6); width: 38px; height: 38px;">
                                <i class="bi bi-pie-chart-fill fs-5"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h5 class="fw-bold mb-0 text-dark" style="letter-spacing: -0.3px;">JT_BI Studio</h5>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small">SPA v2.0</span>
                                </div>
                                <small class="text-muted d-block text-truncate" style="max-width: 260px;">
                                    @(DashboardAtivo?.Nome ?? "Carregando ambiente analítico...")
                                </small>
                            </div>
                        </div>

                        <!-- Seletor de Painel / Ações Rápidas -->
                        <div class="col-12 col-md-5 d-flex align-items-center justify-content-center gap-2">
                            @if (ListaDashboards.Any())
                            {
                                <select class="form-select form-select-sm border-0 bg-light rounded-3 fw-semibold text-secondary"
                                        style="max-width: 240px;"
                                        value="@DashboardAtivo?.Id"
                                        @onchange="TrocarDashboardAsync">
                                    @foreach (var dash in ListaDashboards)
                                    {
                                        <option value="@dash.Id">@dash.Nome (@dash.Categoria)</option>
                                    }
                                </select>
                            }
                            <button class="btn btn-sm btn-outline-primary rounded-3 px-3 shadow-xs d-flex align-items-center gap-1"
                                    @onclick="NovoDashboardAsync" title="Criar Novo Painel">
                                <i class="bi bi-plus-circle"></i>
                                <span class="d-none d-sm-inline">Novo</span>
                            </button>
                            <a href="/dashboards" class="btn btn-sm btn-outline-secondary rounded-3 px-2 shadow-xs" title="Ver Hub com Todos os Painéis">
                                <i class="bi bi-grid-3x3-gap"></i>
                            </a>
                        </div>

                        <!-- Status de Usuário & Controle do Painel -->
                        <div class="col-12 col-md-3 d-flex align-items-center justify-content-end gap-2">
                            <div class="d-none d-lg-flex flex-column text-end me-1">
                                <span class="fw-semibold text-dark small">@(string.IsNullOrWhiteSpace(UserState.UsuarioName) ? "Administrador" : UserState.UsuarioName)</span>
                                <small class="text-success" style="font-size: 0.72rem;">
                                    <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Sessão Segura
                                </small>
                            </div>

                            <button class="btn btn-sm btn-success rounded-3 px-3 fw-semibold shadow-sm d-flex align-items-center gap-1"
                                    @onclick="SalvarDashboardAtualAsync" disabled="@IsSalvando" title="Salvar Alterações">
                                @if (IsSalvando)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>Salvando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-cloud-check-fill"></i>
                                    <span>Salvar</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Feedback de Alerta -->
            @if (!string.IsNullOrEmpty(MensagemFeedback))
            {
                <div class="alert @ClasseFeedback alert-dismissible fade show mb-3 py-2 px-3 shadow-sm rounded-3 border-0 d-flex align-items-center justify-content-between" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @(ClasseFeedback.Contains("success") ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-5"></i>
                        <span class="small fw-semibold">@MensagemFeedback</span>
                    </div>
                    <button type="button" class="btn-close btn-close-sm" @onclick="() => MensagemFeedback = null"></button>
                </div>
            }

            <!-- Área Central SPA Tripartite -->
            <div class="row g-3 flex-grow-1 overflow-hidden" style="min-height: calc(100vh - 180px);">
                <!-- COLUNA ESQUERDA: Barra de Ferramentas / Widgets & Datasets -->
                <aside class="col-12 col-lg-2 d-flex flex-column">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden">
                        <div class="card-header bg-white border-bottom py-2 px-3 d-flex align-items-center justify-content-between">
                            <span class="fw-bold small text-uppercase text-secondary" style="letter-spacing: 0.5px;">
                                <i class="bi bi-tools me-1 text-primary"></i> Widgets
                            </span>
                            <span class="badge bg-light text-secondary rounded-pill">Drag & Drop</span>
                        </div>
                        <div class="card-body p-2 overflow-y-auto">
                            <p class="text-muted small px-1 mb-2" style="font-size: 0.75rem;">
                                Arraste ou clique para adicionar componentes ao Canvas Central:
                            </p>
                            <div class="d-flex flex-column gap-2">
                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-pointer hover-shadow transition-all"
                                     draggable="true" @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.CardKpi)">
                                    <div class="p-2 bg-primary-subtle text-primary rounded-3"><i class="bi bi-123"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Card Indicador (KPI)</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Métricas e Totais</small>
                                    </div>
                                </div>

                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-pointer hover-shadow transition-all"
                                     draggable="true" @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.GraficoBarras)">
                                    <div class="p-2 bg-info-subtle text-info rounded-3"><i class="bi bi-bar-chart-fill"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Gráfico de Barras</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Comparações por Categoria</small>
                                    </div>
                                </div>

                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-pointer hover-shadow transition-all"
                                     draggable="true" @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.GraficoLinhas)">
                                    <div class="p-2 bg-success-subtle text-success rounded-3"><i class="bi bi-graph-up"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Gráfico de Linhas</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Evolução Temporal</small>
                                    </div>
                                </div>

                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-pointer hover-shadow transition-all"
                                     draggable="true" @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.GraficoPizza)">
                                    <div class="p-2 bg-warning-subtle text-warning rounded-3"><i class="bi bi-pie-chart-fill"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Gráfico de Pizza</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Distribuição Percentual</small>
                                    </div>
                                </div>

                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-pointer hover-shadow transition-all"
                                     draggable="true" @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.Tabela)">
                                    <div class="p-2 bg-secondary-subtle text-secondary rounded-3"><i class="bi bi-table"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Tabela Analítica</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Grid com paginação</small>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-3 text-muted opacity-25" />

                            <div class="px-1">
                                <span class="fw-bold small text-uppercase text-secondary d-block mb-2" style="font-size: 0.72rem;">
                                    <i class="bi bi-database-check me-1 text-success"></i> Fontes JT Conectadas
                                </span>
                                <div class="d-flex flex-column gap-1 small">
                                    <div class="d-flex justify-content-between align-items-center text-muted">
                                        <span><i class="bi bi-cash-coin me-1 text-success"></i> Financeiro</span>
                                        <span class="badge bg-success-subtle text-success">OK</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center text-muted">
                                        <span><i class="bi bi-cup-straw me-1 text-warning"></i> Food</span>
                                        <span class="badge bg-success-subtle text-success">OK</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center text-muted">
                                        <span><i class="bi bi-box-seam me-1 text-info"></i> Estoque</span>
                                        <span class="badge bg-success-subtle text-success">OK</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center text-muted">
                                        <span><i class="bi bi-cart me-1 text-primary"></i> Vendas</span>
                                        <span class="badge bg-success-subtle text-success">OK</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>

                <!-- COLUNA CENTRAL: Canvas Interativo do BI -->
                <main class="col-12 col-lg-7 d-flex flex-column">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden d-flex flex-column">
                        <div class="card-header bg-white border-bottom py-2 px-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary text-white rounded-pill px-3 py-1 fw-semibold">
                                    <i class="bi bi-bounding-box-circles me-1"></i> Canvas Central
                                </span>
                                <span class="text-muted small">
                                    @((DashboardAtivo?.Widgets?.Count ?? 0) == 0 ? "Nenhum widget ativo" : $"{DashboardAtivo?.Widgets?.Count} widgets no painel")
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <button class="btn btn-xs btn-outline-secondary rounded-3 py-1 px-2 border-0"
                                        @onclick="CarregarTemplatePadraoAsync" title="Carregar Template Rápido">
                                    <i class="bi bi-layout-wtf me-1"></i> Templates
                                </button>
                                <button class="btn btn-xs btn-outline-secondary rounded-3 py-1 px-2 border-0"
                                        @onclick="LimparCanvas" title="Limpar Widgets">
                                    <i class="bi bi-trash3 me-1"></i> Limpar
                                </button>
                            </div>
                        </div>

                        <!-- Área de Montagem do Canvas -->
                        <div class="card-body p-3 bg-light overflow-y-auto flex-grow-1" id="biCanvasArea" style="min-height: 480px;">
                            @if (IsCarregando)
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 p-5 text-muted">
                                    <div class="spinner-border text-primary mb-3" role="status"></div>
                                    <p class="fw-semibold mb-0">Carregando painel e configurações de Gestão...</p>
                                </div>
                            }
                            else if (DashboardAtivo == null || !DashboardAtivo.Widgets.Any())
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 p-5 text-center text-muted border border-2 border-dashed rounded-4 bg-white m-2">
                                    <div class="display-3 text-primary opacity-25 mb-3">
                                        <i class="bi bi-grid-1x2"></i>
                                    </div>
                                    <h5 class="fw-bold text-dark">Canvas Vazio</h5>
                                    <p class="small text-muted mb-3" style="max-width: 420px;">
                                        Arraste um widget da barra esquerda, escolha um template rápido ou utilize o Agente de IA para montar os gráficos automaticamente.
                                    </p>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-primary rounded-3 px-3 shadow-sm" @onclick="CarregarTemplatePadraoAsync">
                                            <i class="bi bi-magic me-1"></i> Carregar Template Executivo
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary rounded-3 px-3" @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.CardKpi)">
                                            <i class="bi bi-plus-lg me-1"></i> Adicionar Primeiro KPI
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">
                                    @foreach (var widget in DashboardAtivo.Widgets)
                                    {
                                        <div class="@ObterClasseGridWidget(widget.LarguraColunas) transition-all" key="@widget.Id">
                                            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden widget-canvas-card bg-white position-relative hover-shadow">
                                                <div class="card-header bg-white border-bottom py-2 px-3 d-flex align-items-center justify-content-between">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-grip-vertical text-muted cursor-grab" title="Arrastar"></i>
                                                        <span class="fw-bold small text-dark">@widget.Titulo</span>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-1">
                                                        <button class="btn btn-xs btn-link text-muted p-0 me-1" @onclick="() => SelecionarWidget(widget)" title="Configurar">
                                                            <i class="bi bi-gear-fill"></i>
                                                        </button>
                                                        <button class="btn btn-xs btn-link text-danger p-0" @onclick="() => RemoverWidget(widget.Id)" title="Excluir">
                                                            <i class="bi bi-x-circle-fill"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="card-body p-3" style="min-height: 220px;">
                                                    <BIWidgetView Widget="widget" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </main>

                <!-- COLUNA DIREITA: Inspetor de Propriedades & Agente IA -->
                <aside class="col-12 col-lg-3 d-flex flex-column">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden d-flex flex-column">
                        <div class="card-header bg-white border-bottom py-2 px-3 d-flex align-items-center justify-content-between">
                            <ul class="nav nav-pills card-header-pills gap-1">
                                <li class="nav-item">
                                    <button class="nav-link py-1 px-3 small rounded-3 @(AbaDireitaAtiva == "ia" ? "active" : "")"
                                            @onclick='() => AbaDireitaAtiva = "ia"'>
                                        <i class="bi bi-stars me-1 text-warning"></i> Agente IA
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link py-1 px-3 small rounded-3 @(AbaDireitaAtiva == "propriedades" ? "active" : "")"
                                            @onclick='() => AbaDireitaAtiva = "propriedades"'>
                                        <i class="bi bi-sliders me-1"></i> Inspector
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <div class="card-body p-3 flex-grow-1 overflow-y-auto">
                            @if (AbaDireitaAtiva == "ia")
                            {
                                <!-- Painel do Agente de IA do BI -->
                                <div class="d-flex flex-column h-100 justify-content-between">
                                    <div>
                                        <div class="p-3 bg-gradient rounded-3 text-white mb-3"
                                             style="background: linear-gradient(135deg, #1e293b, #334155);">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="bi bi-robot fs-5 text-warning"></i>
                                                <span class="fw-bold small">Consultor Executivo BI</span>
                                            </div>
                                            <p class="small text-white-50 mb-0" style="font-size: 0.75rem;">
                                                Pergunte sobre seus dados, solicite insights ou peça para gerar gráficos automaticamente no Canvas.
                                            </p>
                                        </div>

                                        <div class="d-flex flex-column gap-2 mb-3">
                                            <div class="p-2 bg-light rounded-3 border small">
                                                <span class="badge bg-secondary-subtle text-secondary small mb-1">Exemplo de comando:</span>
                                                <p class="mb-0 text-dark small fst-italic">"Crie um gráfico de barras comparando vendas do mês por categoria"</p>
                                            </div>
                                            <div class="p-2 bg-light rounded-3 border small">
                                                <span class="badge bg-secondary-subtle text-secondary small mb-1">Exemplo de mineração:</span>
                                                <p class="mb-0 text-dark small fst-italic">"Agrupe meus clientes via K-Means por ticket médio e frequência"</p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Campo de Chat Rápido com o Agente -->
                                    <div class="pt-2 border-top">
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control rounded-start-3"
                                                   placeholder="Instrua o Agente de IA..."
                                                   @bind="PromptIaRapido"
                                                   @onkeyup="TratarEnterPromptIa" />
                                            <button class="btn btn-primary rounded-end-3 px-3" @onclick="EnviarInstrucaoIaAsync">
                                                <i class="bi bi-send-fill"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Painel de Propriedades do Widget Selecionado -->
                                @if (WidgetSelecionado == null)
                                {
                                    <div class="text-center text-muted p-4">
                                        <i class="bi bi-cursor fs-1 opacity-25 d-block mb-2"></i>
                                        <span class="small">Selecione um widget no Canvas para editar título, métricas, cores e largura de colunas.</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-3">
                                        <div>
                                            <label class="form-label small fw-semibold text-secondary">Título do Widget</label>
                                            <input type="text" class="form-control form-control-sm rounded-3" @bind="WidgetSelecionado.Titulo" />
                                        </div>

                                        <div>
                                            <label class="form-label small fw-semibold text-secondary">Largura na Grade</label>
                                            <select class="form-select form-select-sm rounded-3" @bind="WidgetSelecionado.LarguraColunas">
                                                <option value="4">Pequeno (4 colunas - 1/3 da tela)</option>
                                                <option value="6">Médio (6 colunas - 1/2 da tela)</option>
                                                <option value="8">Grande (8 colunas - 2/3 da tela)</option>
                                                <option value="12">Largura Total (12 colunas)</option>
                                            </select>
                                        </div>

                                        <div>
                                            <label class="form-label small fw-semibold text-secondary">Cor do Destaque</label>
                                            <select class="form-select form-select-sm rounded-3" @bind="WidgetSelecionado.CorDestaque">
                                                <option value="primary">Azul (Primary)</option>
                                                <option value="success">Verde (Success)</option>
                                                <option value="warning">Amarelo (Warning)</option>
                                                <option value="info">Ciano (Info)</option>
                                                <option value="danger">Vermelho (Danger)</option>
                                                <option value="dark">Escuro (Dark)</option>
                                            </select>
                                        </div>

                                        <button class="btn btn-sm btn-outline-danger rounded-3 mt-2" @onclick="() => RemoverWidget(WidgetSelecionado.Id)">
                                            <i class="bi bi-trash me-1"></i> Excluir Widget
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </ChildContent>

    @* ========================================================================= *@
    @* FEEDBACK QUANDO O USUÁRIO NÃO POSSUI ACESSO AUTORIZADO                    *@
    @* ========================================================================= *@
    <SemAcessoContent>
        <div class="container d-flex align-items-center justify-content-center" style="min-height: 70vh;">
            <div class="card border-0 shadow rounded-4 p-5 text-center bg-white" style="max-width: 520px;">
                <div class="mb-3">
                    <span class="p-3 bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center"
                          style="width: 72px; height: 72px;">
                        <i class="bi bi-shield-lock-fill fs-1"></i>
                    </span>
                </div>
                <h4 class="fw-bold text-dark mb-2">Acesso Restrito ao Módulo JT_BI</h4>
                <p class="text-muted small mb-4">
                    Seu perfil de usuário não possui permissão ativa para o módulo de Gestão/BI ou seu token de autenticação expirou.
                </p>
                <div class="d-flex flex-column gap-2">
                    <a href="/login" class="btn btn-primary rounded-3 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Fazer Login no Sistema
                    </a>
                    <button class="btn btn-outline-secondary rounded-3 py-2 small" @onclick="RecarregarAcesso">
                        <i class="bi bi-arrow-clockwise me-1"></i> Verificar Novamente
                    </button>
                </div>
            </div>
        </div>
    </SemAcessoContent>
</AcessoAutorizado>

@code {
    private List<BIDashboard> ListaDashboards = new();
    private BIDashboard? DashboardAtivo;
    private BIWidget? WidgetSelecionado;
    private bool IsCarregando = true;
    private bool IsSalvando = false;
    private string AbaDireitaAtiva = "ia";
    private string? MensagemFeedback;
    private string ClasseFeedback = "alert-success";
    private string PromptIaRapido = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAmbienteAsync();
    }

    private async Task CarregarAmbienteAsync()
    {
        IsCarregando = true;
        try
        {
            // Consome serviços do módulo Gestão / Comum (não bloqueante)
            try
            {
                var configGestao = await GestaoConfigService.GetAtivaAsync();
            }
            catch (Exception exGestao)
            {
                Console.WriteLine($"[JT_BI] Aviso ao obter GestaoConfig: {exGestao.Message}");
            }

            // Carrega dashboards existentes
            ListaDashboards = await DashboardService.ObterTodosAsync();
            if (ListaDashboards.Any())
            {
                DashboardAtivo = ListaDashboards.First();
            }
            else
            {
                DashboardAtivo = new BIDashboard
                {
                    Nome = "Dashboard Executivo JT",
                    Descricao = "Painel corporativo de inteligência",
                    Categoria = "Geral",
                    Icone = "bi-speedometer2"
                };
                await DashboardService.SalvarAsync(DashboardAtivo);
                ListaDashboards.Add(DashboardAtivo);
            }
        }
        catch (Exception ex)
        {
            MensagemFeedback = $"Aviso ao carregar configurações de gestão: {ex.Message}";
            ClasseFeedback = "alert-warning";
        }
        finally
        {
            IsCarregando = false;
        }
    }

    private async Task TrocarDashboardAsync(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            var encontrado = await DashboardService.ObterPorIdAsync(id);
            if (encontrado != null)
            {
                DashboardAtivo = encontrado;
                WidgetSelecionado = null;
            }
        }
    }

    private async Task NovoDashboardAsync()
    {
        var novo = new BIDashboard
        {
            Nome = $"Novo Painel #{ListaDashboards.Count + 1}",
            Descricao = "Painel personalizado",
            Categoria = "Personalizado",
            Icone = "bi-bar-chart-fill"
        };
        await DashboardService.SalvarAsync(novo);
        ListaDashboards.Insert(0, novo);
        DashboardAtivo = novo;
        WidgetSelecionado = null;
        ExibirFeedback("Novo dashboard criado com sucesso!", "alert-success");
    }

    private async Task SalvarDashboardAtualAsync()
    {
        if (DashboardAtivo == null) return;
        IsSalvando = true;
        try
        {
            await DashboardService.SalvarAsync(DashboardAtivo);
            ExibirFeedback("Dashboard e configurações salvas com sucesso!", "alert-success");
        }
        catch (Exception ex)
        {
            ExibirFeedback($"Erro ao salvar: {ex.Message}", "alert-danger");
        }
        finally
        {
            IsSalvando = false;
        }
    }

    private void AdicionarWidgetRapido(BIWidgetTipo tipo)
    {
        if (DashboardAtivo == null) return;

        var widget = new BIWidget
        {
            Id = Guid.NewGuid(),
            Tipo = tipo,
            Titulo = ObterTituloPadraoPorTipo(tipo),
            LarguraColunas = tipo == BIWidgetTipo.CardKpi ? 4 : (tipo == BIWidgetTipo.Tabela ? 12 : 6),
            CorTema = "primary",
            ValorAtual = tipo == BIWidgetTipo.CardKpi ? 12450m : null
        };

        DashboardAtivo.Widgets.Add(widget);
        WidgetSelecionado = widget;
        ExibirFeedback($"Widget '{widget.Titulo}' inserido no Canvas.", "alert-info");
    }

    private void SelecionarWidget(BIWidget widget)
    {
        WidgetSelecionado = widget;
        AbaDireitaAtiva = "propriedades";
    }

    private void RemoverWidget(Guid id)
    {
        if (DashboardAtivo == null) return;
        DashboardAtivo.Widgets.RemoveAll(w => w.Id == id);
        if (WidgetSelecionado?.Id == id) WidgetSelecionado = null;
        ExibirFeedback("Widget removido do Canvas.", "alert-secondary");
    }

    private void LimparCanvas()
    {
        if (DashboardAtivo == null) return;
        DashboardAtivo.Widgets.Clear();
        WidgetSelecionado = null;
        ExibirFeedback("Canvas limpo.", "alert-secondary");
    }

