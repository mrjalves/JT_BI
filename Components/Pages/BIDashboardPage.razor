    private void AdicionarWidgetRapido(BIWidgetTipo tipo)
    {
        if (DashboardAtivo == null) return;

        var fonteInicial = fontesMineracao.FirstOrDefault();
        var datasetVinculado = DashboardAtivo.DatasetsVinculadosIds.Count > 0
            ? datasetsDisponiveis.FirstOrDefault(d => DashboardAtivo.DatasetsVinculadosIds.Contains(d.Id))
            : null;

        var widget = new BIWidget
        {
            Id = Guid.NewGuid(),
            Tipo = tipo,
            Titulo = ObterTituloPadraoPorTipo(tipo),
            LarguraColunas = tipo == BIWidgetTipo.CardKpi ? 4 : (tipo == BIWidgetTipo.Tabela ? 12 : 6),
            CorTema = "primary",
            FonteDadosId = datasetVinculado != null ? $"dataset_{datasetVinculado.Id}" : (fonteInicial?.Id ?? "financeiro"),
            OrigemId = datasetVinculado != null ? null : fonteInicial?.OrigemId,
            MetricaCampo = datasetVinculado != null
                ? (datasetVinculado.Colunas.FirstOrDefault(c => c.TipoDado == "Numero")?.Nome ?? datasetVinculado.Colunas.FirstOrDefault()?.Nome ?? "Valor")
                : (fonteInicial?.Metricas.FirstOrDefault() ?? "Faturamento"),
            DimensaoCampo = datasetVinculado != null
                ? (datasetVinculado.Colunas.FirstOrDefault(c => c.TipoDado != "Numero")?.Nome ?? datasetVinculado.Colunas.LastOrDefault()?.Nome ?? "Categoria")
                : (fonteInicial?.Dimensoes.FirstOrDefault() ?? "Mes"),
            ValorAtual = tipo == BIWidgetTipo.CardKpi ? 12450m : null
        };

        DashboardAtivo.Widgets.Add(widget);
        WidgetSelecionado = widget;
        AbaDireitaAtiva = "propriedades";
        ExibirFeedback($"Widget '{widget.Titulo}' inserido no Canvas.", "alert-info");
    }

    private void SelecionarWidget(BIWidget widget)
    {
        WidgetSelecionado = widget;
        AbaDireitaAtiva = "propriedades";
    }

    private void AjustarFonteWidgetSelecionado()
    {
        if (WidgetSelecionado == null) return;
        var fonteId = WidgetSelecionado.FonteDadosId ?? string.Empty;
        var fonte = fontesMineracao.FirstOrDefault(f => f.Id == fonteId);
        if (fonte != null)
        {
            WidgetSelecionado.OrigemId = fonte.OrigemId;
            WidgetSelecionado.MetricaCampo = fonte.Metricas.FirstOrDefault() ?? "Valor";
            WidgetSelecionado.DimensaoCampo = fonte.Dimensoes.FirstOrDefault() ?? "Categoria";
        }
        else if (fonteId.StartsWith("dataset_", StringComparison.OrdinalIgnoreCase))
        {
            WidgetSelecionado.OrigemId = null;
            var ds = datasetsDisponiveis.FirstOrDefault(d => $"dataset_{d.Id}" == fonteId);
            if (ds != null)
            {
                var colNum = ds.Colunas.FirstOrDefault(c => c.TipoDado == "Numero") ?? ds.Colunas.FirstOrDefault();
                var colTxt = ds.Colunas.FirstOrDefault(c => c.TipoDado != "Numero") ?? ds.Colunas.LastOrDefault();
                WidgetSelecionado.MetricaCampo = colNum?.Nome ?? string.Empty;
                WidgetSelecionado.DimensaoCampo = colTxt?.Nome ?? string.Empty;
            }
        }
    }

    private IEnumerable<string> ObterMetricasFonteWidget()
    {
        if (WidgetSelecionado == null) return Enumerable.Empty<string>();
        var fonteId = WidgetSelecionado.FonteDadosId ?? string.Empty;
        var fonte = fontesMineracao.FirstOrDefault(f => f.Id == fonteId);
        if (fonte != null) return fonte.Metricas;
        var ds = datasetsDisponiveis.FirstOrDefault(d => $"dataset_{d.Id}" == fonteId);
        return ds?.Colunas.Select(c => c.Nome) ?? Enumerable.Empty<string>();
    }

    private IEnumerable<string> ObterDimensoesFonteWidget()
    {
        if (WidgetSelecionado == null) return Enumerable.Empty<string>();
        var fonteId = WidgetSelecionado.FonteDadosId ?? string.Empty;
        var fonte = fontesMineracao.FirstOrDefault(f => f.Id == fonteId);
        if (fonte != null) return fonte.Dimensoes;
        var ds = datasetsDisponiveis.FirstOrDefault(d => $"dataset_{d.Id}" == fonteId);
        return ds?.Colunas.Select(c => c.Nome) ?? Enumerable.Empty<string>();
    }

    private void RemoverWidget(Guid id)
    {
        if (DashboardAtivo == null) return;
        DashboardAtivo.Widgets.RemoveAll(w => w.Id == id);
        if (WidgetSelecionado?.Id == id) WidgetSelecionado = null;
        ExibirFeedback("Widget removido do Canvas.", "alert-secondary");
    }

    private void LimparCanvas()
    {
        if (DashboardAtivo == null) return;
        DashboardAtivo.Widgets.Clear();
        WidgetSelecionado = null;
        ExibirFeedback("Canvas limpo com sucesso.", "alert-secondary");
    }

