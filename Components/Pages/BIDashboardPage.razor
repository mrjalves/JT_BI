                            @if (previewCurvaAbc != null && previewCurvaAbc.Itens.Count > 0)
                            {
                                <div class="bi-mining-card p-3 mt-3 border-success">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="fw-bold small text-success">
                                            <i class="bi bi-check2-all me-1"></i>Resultado Curva ABC — Total Analisado: R$ @previewCurvaAbc.TotalGeral.ToString("N2")
                                        </span>
                                        <button type="button" class="btn btn-xs btn-outline-secondary" @onclick="() => previewCurvaAbc = null">Fechar prévia</button>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2 mb-2">
                                        <span class="badge bg-success-subtle text-success border">Classe A (80%): @previewCurvaAbc.QtdClasseA item(ns)</span>
                                        <span class="badge bg-warning-subtle text-warning border">Classe B (15%): @previewCurvaAbc.QtdClasseB item(ns)</span>
                                        <span class="badge bg-danger-subtle text-danger border">Classe C (5%): @previewCurvaAbc.QtdClasseC item(ns)</span>
                                    </div>
                                    <div class="table-responsive" style="max-height: 150px;">
                                        <table class="table table-sm table-hover small mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Item (@campoMineracaoNome)</th>
                                                    <th class="text-end">Valor (@campoMineracaoValorAbc)</th>
