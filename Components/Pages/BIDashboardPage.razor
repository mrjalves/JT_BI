    private async Task PrevisualizarKMeansAsync()
    {
        previewCurvaAbc = null;
        var registros = await ObterRegistrosMineracaoAsync(
            new[] { campoMineracaoNome, campoMineracaoValor1, campoMineracaoValor2 });

        if (registros.Count < 2)
        {
            mensagemMineracaoModal = "São necessários ao menos 2 registros na fonte vinculada para executar o K-Means.";
            classeMensagemMineracaoModal = "alert-warning";
            return;
        }

        previewKMeans = DataMiningService.ExecutarKMeans(
            registros, campoMineracaoNome, campoMineracaoValor1, campoMineracaoValor2, kMeansK);
        mensagemMineracaoModal = previewKMeans.ResumoExecutivo;
        classeMensagemMineracaoModal = "alert-success";
    }

    private async Task PrevisualizarCurvaAbcAsync()
    {
        previewKMeans = null;
        var registros = await ObterRegistrosMineracaoAsync(
            new[] { campoMineracaoNome, campoMineracaoValorAbc });

        if (registros.Count == 0)
        {
            mensagemMineracaoModal = "Nenhum registro disponível na fonte vinculada para calcular a Curva ABC.";
            classeMensagemMineracaoModal = "alert-warning";
            return;
        }

        previewCurvaAbc = DataMiningService.CalcularCurvaAbc(
            registros, campoMineracaoNome, campoMineracaoValorAbc);
        mensagemMineracaoModal = $"Curva ABC calculada: {previewCurvaAbc.QtdClasseA} item(ns) na Classe A (80% do volume).";
        classeMensagemMineracaoModal = "alert-success";
    }

    private async Task ExecutarKMeansNoCanvasAsync()
    {
        if (DashboardAtivo == null) return;

        var registros = await ObterRegistrosMineracaoAsync(
            new[] { campoMineracaoNome, campoMineracaoValor1, campoMineracaoValor2 });

        if (registros.Count < 2) return;

        var resultado = DataMiningService.ExecutarKMeans(
            registros, campoMineracaoNome, campoMineracaoValor1, campoMineracaoValor2, kMeansK);
        var widgets = DataMiningService.GerarWidgetsMinacao(resultado);

        foreach (var w in widgets)
        {
            DashboardAtivo.Widgets.Add(w);
        }

        isDataMiningModalOpen = false;
        await SalvarDashboardAtualAsync();
        ExibirFeedback(resultado.ResumoExecutivo, "alert-success");
    }

    private async Task ExecutarCurvaAbcNoCanvasAsync()
    {
        if (DashboardAtivo == null) return;

        var registros = await ObterRegistrosMineracaoAsync(
            new[] { campoMineracaoNome, campoMineracaoValorAbc });

        if (registros.Count == 0) return;

        var resultado = DataMiningService.CalcularCurvaAbc(
            registros, campoMineracaoNome, campoMineracaoValorAbc);
        var widgets = DataMiningService.GerarWidgetsCurvaAbc(resultado);

        foreach (var w in widgets)
        {
            DashboardAtivo.Widgets.Add(w);
        }

        isDataMiningModalOpen = false;
        await SalvarDashboardAtualAsync();
        ExibirFeedback($"Curva ABC calculada: {resultado.QtdClasseA} itens na Classe A (80% da receita).", "alert-success");
    }

    private async Task<List<Dictionary<string, string>>> ObterRegistrosMineracaoAsync(IEnumerable<string> colunas)
    {
        var listaColunas = colunas
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (string.IsNullOrWhiteSpace(fonteMineracaoSelecionadaId))
        {
            ExibirFeedback("Selecione uma fonte de dados vinculada para executar a mineração.", "alert-warning");
            return new List<Dictionary<string, string>>();
        }

        if (listaColunas.Count == 0)
        {
            ExibirFeedback("Selecione os campos usados pela mineração.", "alert-warning");
            return new List<Dictionary<string, string>>();
        }

        var registros = await DataSourceService.ObterAmostraPorFonteAsync(
            fonteMineracaoSelecionadaId, listaColunas, datasetsDisponiveis, 5000);

        if (registros.Count == 0)
        {
            mensagemMineracaoModal = "Nenhum registro retornado pela fonte selecionada. Sincronize a tabela do servidor ou selecione outra fonte.";
            classeMensagemMineracaoModal = "alert-warning";
            ExibirFeedback(mensagemMineracaoModal, "alert-warning");
            return new List<Dictionary<string, string>>();
        }

        return registros;
    }

    private Task AbrirImportacaoAsync()
        => ImportUi.AbrirAsync(
            callback: async dash =>
            {
                await TratarDashboardCriadoAsync(dash);
                await InvokeAsync(StateHasChanged);
            },
            callbackFonte: async fonte =>
            {
                var contexto = BIUsuarioContexto.De(UserState);
                datasetsDisponiveis = await DashboardService.ObterDatasetsVisiveisAsync(contexto);
                fontesMineracao = await DataSourceService.ObterFontesDisponiveisAsync(datasetsDisponiveis);
                fonteMineracaoSelecionadaId = fonte.Id;
                isFontesModalOpen = true;
                ExibirFeedback($"Fonte de dados '{fonte.Nome}' ({fonte.LinhasCarregadas} linhas) salva! Gerencie colunas, amostra e sincronização na tela de Fontes de Dados.", "alert-success");
                await InvokeAsync(StateHasChanged);
            });

    private async Task TratarDashboardCriadoAsync(BIDashboard novo)
    {
        var contexto = BIUsuarioContexto.De(UserState);
        datasetsDisponiveis = await DashboardService.ObterDatasetsVisiveisAsync(contexto);
        if (novo.DatasetsVinculadosIds.Count > 0)
        {
            var vinculados = await DashboardService.ObterDatasetsPorIdsAsync(novo.DatasetsVinculadosIds);
            foreach (var ds in vinculados.Where(d => datasetsDisponiveis.All(x => x.Id != d.Id)))
            {
                datasetsDisponiveis.Add(ds);
            }
        }

        fontesMineracao = await DataSourceService.ObterFontesDisponiveisAsync(datasetsDisponiveis);
        ListaDashboards.RemoveAll(d => d.Id == novo.Id);
        ListaDashboards.Insert(0, novo);
        DashboardAtivo = novo;
        WidgetSelecionado = null;
        ExibirFeedback($"Fonte e Dashboard '{novo.Nome}' criados com sucesso!", "alert-success");
    }

