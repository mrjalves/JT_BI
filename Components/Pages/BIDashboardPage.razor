@page "/"
@page "/bi"
@page "/bidashboard"
@rendermode InteractiveServer

@using JT_BI.Models
@using JT_BI.Services
@using JT_BI.Components.BI
@using JT_Aplicacao.Classes
@using JT_Classes.Acessos
@using JT_Servicos.Gestao
@using JT_UserInterface.Shared
@using JT_UserInterface.Shared.Components.Acessos
@using JT_UserInterface.Shared.Services.Interfaces.Acessos
@using JT_UserInterface.Shared.Services.Comum

@inject MGestaoConfiguracaoService GestaoConfigService
@inject IAcessoService AcessoService
@inject CurrentUserState UserState
@inject IBIDashboardService DashboardService
@inject IBIDataSourceService DataSourceService
@inject IBIImportService ImportService
@inject IBIDataMiningService DataMiningService
@inject ToastService ToastService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>JT_BI - Painel Central de Inteligência</PageTitle>

@* ========================================================================= *@
@* FASE 1: VALIDAÇÃO DE SEGURANÇA E ACESSO AUTORIZADO                       *@
@* ========================================================================= *@
<AcessoAutorizado Modulo="eModuloSistema.Gestao" Acao="eAcaoPermissao.Ler">
    <ChildContent>
        <div class="bi-spa-wrapper d-flex flex-column h-100">
            <!-- Barra Superior Executiva SPA -->
            <header class="bi-header card border-0 shadow-sm rounded-4 mb-3 overflow-hidden bg-white">
                <div class="card-body py-2 px-3">
                    <div class="row g-2 align-items-center justify-content-between">
                        <!-- Identificação do Módulo e Dashboard Ativo -->
                        <div class="col-12 col-md-3 d-flex align-items-center gap-2">
                            <div class="bi-brand-icon p-2 bg-gradient text-white rounded-3 shadow-sm d-flex align-items-center justify-content-center"
                                 style="background: linear-gradient(135deg, #2563eb, #3b82f6); width: 38px; height: 38px;">
                                <i class="bi bi-pie-chart-fill fs-5"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h5 class="fw-bold mb-0 text-dark" style="letter-spacing: -0.3px;">JT_BI Studio</h5>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small">SPA v2.0</span>
                                </div>
                                <small class="text-muted d-block text-truncate" style="max-width: 220px;">
                                    @(DashboardAtivo?.Nome ?? "Carregando ambiente analítico...")
                                </small>
                            </div>
                        </div>

                        <!-- Seletor de Painel / Ações Rápidas -->
                        <div class="col-12 col-md-5 d-flex align-items-center justify-content-center gap-2 flex-wrap">
                            @if (ListaDashboards.Any())
                            {
                                <select class="form-select form-select-sm border-0 bg-light rounded-3 fw-semibold text-secondary"
                                        style="max-width: 190px;"
                                        value="@DashboardAtivo?.Id"
                                        @onchange="TrocarDashboardAsync">
                                    @foreach (var dash in ListaDashboards)
                                    {
                                        <option value="@dash.Id">@dash.Nome</option>
                                    }
                                </select>
                            }
                            <button class="btn btn-sm btn-outline-primary rounded-3 px-2 shadow-xs d-flex align-items-center gap-1"
                                    @onclick="NovoDashboardAsync" title="Criar Novo Painel">
                                <i class="bi bi-plus-circle"></i>
                                <span class="d-none d-sm-inline">Novo</span>
                            </button>

                            <!-- Botão Templates Rápidos (Fase 2) -->
                            <button class="btn btn-sm btn-outline-secondary rounded-3 px-2 shadow-xs d-flex align-items-center gap-1"
                                    @onclick="() => isTemplatesModalOpen = true" title="Escolher Template de Painel">
                                <i class="bi bi-layout-wtf text-primary"></i>
                                <span class="d-none d-md-inline">Templates</span>
                            </button>

                            <!-- Botão Importar Dados (Fase 3) -->
                            <button class="btn btn-sm btn-outline-secondary rounded-3 px-2 shadow-xs d-flex align-items-center gap-1"
                                    @onclick="() => isImportModalOpen = true" title="Importar CSV / JSON">
                                <i class="bi bi-file-earmark-arrow-up text-success"></i>
                                <span class="d-none d-md-inline">Importar</span>
                            </button>

                            <!-- Botão Mineração IA (Fase 3) -->
                            <button class="btn btn-sm btn-outline-secondary rounded-3 px-2 shadow-xs d-flex align-items-center gap-1"
                                    @onclick="() => isDataMiningModalOpen = true" title="Mineração de Dados (K-Means / Curva ABC)">
                                <i class="bi bi-cpu text-warning"></i>
                                <span class="d-none d-md-inline">Mineração</span>
                            </button>

                            <!-- Botão Compartilhar (Fase 5) -->
                            <button class="btn btn-sm btn-outline-secondary rounded-3 px-2 shadow-xs d-flex align-items-center gap-1"
                                    @onclick="() => isShareModalOpen = true" title="Compartilhar Link Público">
                                <i class="bi bi-share text-info"></i>
                            </button>

                            <a href="/dashboards" class="btn btn-sm btn-outline-secondary rounded-3 px-2 shadow-xs" title="Ver Hub de Todos os Painéis">
                                <i class="bi bi-grid-3x3-gap"></i>
                            </a>
                        </div>

                        <!-- Status de Usuário & Controle do Painel -->
                        <div class="col-12 col-md-4 d-flex align-items-center justify-content-end gap-2">
                            <button class="btn btn-sm btn-outline-secondary rounded-3 px-2" @onclick="ExportarJsonDashboard" title="Exportar Definições JSON">
                                <i class="bi bi-download me-1"></i> Exportar
                            </button>

                            <button class="btn btn-sm btn-success rounded-3 px-3 fw-semibold shadow-sm d-flex align-items-center gap-1"
                                    @onclick="SalvarDashboardAtualAsync" disabled="@IsSalvando" title="Salvar Alterações">
                                @if (IsSalvando)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>Salvando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-cloud-check-fill"></i>
                                    <span>Salvar</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Feedback de Alerta -->
            @if (!string.IsNullOrEmpty(MensagemFeedback))
            {
                <div class="alert @ClasseFeedback alert-dismissible fade show mb-3 py-2 px-3 shadow-sm rounded-3 border-0 d-flex align-items-center justify-content-between" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @(ClasseFeedback.Contains("success") ? "bi-check-circle-fill text-success" : (ClasseFeedback.Contains("info") ? "bi-info-circle-fill text-info" : "bi-exclamation-triangle-fill text-danger")) fs-5"></i>
                        <span class="small fw-semibold">@MensagemFeedback</span>
                    </div>
                    <button type="button" class="btn-close btn-close-sm" @onclick="() => MensagemFeedback = null"></button>
                </div>
            }

            <!-- Área Central SPA Tripartite -->
            <div class="row g-3 flex-grow-1 overflow-hidden" style="min-height: calc(100vh - 180px);">
                <!-- COLUNA ESQUERDA: Barra de Ferramentas / Widgets & Datasets (Fase 2 Drag & Drop) -->
                <aside class="col-12 col-lg-2 d-flex flex-column">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden">
                        <div class="card-header bg-white border-bottom py-2 px-3 d-flex align-items-center justify-content-between">
                            <span class="fw-bold small text-uppercase text-secondary" style="letter-spacing: 0.5px;">
                                <i class="bi bi-tools me-1 text-primary"></i> Widgets
                            </span>
                            <span class="badge bg-light text-secondary rounded-pill">Drag & Drop</span>
                        </div>
                        <div class="card-body p-2 overflow-y-auto">
                            <p class="text-muted small px-1 mb-2" style="font-size: 0.72rem;">
                                Arraste ou clique para adicionar componentes ao Canvas Central:
                            </p>
                            <div class="d-flex flex-column gap-2">
                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-grab hover-shadow transition-all"
                                     draggable="true"
                                     @ondragstart="@(() => IniciarArrasto(BIWidgetTipo.CardKpi))"
                                     @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.CardKpi)"
                                     title="Arraste para o Canvas ou clique para inserir">
                                    <div class="p-2 bg-primary-subtle text-primary rounded-3"><i class="bi bi-123"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Card Indicador (KPI)</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Métricas e Totais</small>
                                    </div>
                                </div>

                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-grab hover-shadow transition-all"
                                     draggable="true"
                                     @ondragstart="@(() => IniciarArrasto(BIWidgetTipo.GraficoBarras))"
                                     @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.GraficoBarras)"
                                     title="Arraste para o Canvas ou clique para inserir">
                                    <div class="p-2 bg-info-subtle text-info rounded-3"><i class="bi bi-bar-chart-fill"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Gráfico de Barras</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Comparações por Categoria</small>
                                    </div>
                                </div>

                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-grab hover-shadow transition-all"
                                     draggable="true"
                                     @ondragstart="@(() => IniciarArrasto(BIWidgetTipo.GraficoLinhas))"
                                     @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.GraficoLinhas)"
                                     title="Arraste para o Canvas ou clique para inserir">
                                    <div class="p-2 bg-success-subtle text-success rounded-3"><i class="bi bi-graph-up"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Gráfico de Linhas</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Evolução Temporal</small>
                                    </div>
                                </div>

                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-grab hover-shadow transition-all"
                                     draggable="true"
                                     @ondragstart="@(() => IniciarArrasto(BIWidgetTipo.GraficoPizza))"
                                     @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.GraficoPizza)"
                                     title="Arraste para o Canvas ou clique para inserir">
                                    <div class="p-2 bg-warning-subtle text-warning rounded-3"><i class="bi bi-pie-chart-fill"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Gráfico de Pizza</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Distribuição Percentual</small>
                                    </div>
                                </div>

                                <div class="widget-tool-card p-2 rounded-3 border border-dashed text-dark bg-light d-flex align-items-center gap-2 cursor-grab hover-shadow transition-all"
                                     draggable="true"
                                     @ondragstart="@(() => IniciarArrasto(BIWidgetTipo.Tabela))"
                                     @onclick="() => AdicionarWidgetRapido(BIWidgetTipo.Tabela)"
                                     title="Arraste para o Canvas ou clique para inserir">
                                    <div class="p-2 bg-secondary-subtle text-secondary rounded-3"><i class="bi bi-table"></i></div>
                                    <div class="lh-sm">
                                        <span class="d-block fw-semibold small">Tabela Analítica</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Grid com paginação</small>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-3 text-muted opacity-25" />

                            <div class="px-1">
                                <span class="fw-bold small text-uppercase text-secondary d-block mb-2" style="font-size: 0.72rem;">
                                    <i class="bi bi-database-check me-1 text-success"></i> Fontes Conectadas
                                </span>
                                <div class="d-flex flex-column gap-1 small">
                                    <div class="d-flex justify-content-between align-items-center text-muted">
                                        <span><i class="bi bi-cash-coin me-1 text-success"></i> Financeiro</span>
                                        <span class="badge bg-success-subtle text-success">OK</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center text-muted">
                                        <span><i class="bi bi-cup-straw me-1 text-warning"></i> Food</span>
                                        <span class="badge bg-success-subtle text-success">OK</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center text-muted">
                                        <span><i class="bi bi-box-seam me-1 text-info"></i> Estoque</span>
                                        <span class="badge bg-success-subtle text-success">OK</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center text-muted">
                                        <span><i class="bi bi-cart me-1 text-primary"></i> Vendas</span>
                                        <span class="badge bg-success-subtle text-success">OK</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>

                <!-- COLUNA CENTRAL: Canvas Interativo do BI (Drag-and-Drop Dropzone) -->
                <main class="col-12 col-lg-7 d-flex flex-column">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden d-flex flex-column">
                        <div class="card-header bg-white border-bottom py-2 px-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary text-white rounded-pill px-3 py-1 fw-semibold">
                                    <i class="bi bi-bounding-box-circles me-1"></i> Canvas Central
                                </span>
                                <span class="text-muted small">
                                    @((DashboardAtivo?.Widgets?.Count ?? 0) == 0 ? "Nenhum widget ativo" : $"{DashboardAtivo?.Widgets?.Count} widgets no painel")
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <button class="btn btn-xs btn-outline-primary rounded-3 py-1 px-2 border-0"
                                        @onclick="() => isTemplatesModalOpen = true" title="Modelos Prontos de Dashboard">
                                    <i class="bi bi-magic me-1"></i> Templates
                                </button>
                                <button class="btn btn-xs btn-outline-danger rounded-3 py-1 px-2 border-0"
                                        @onclick="LimparCanvas" title="Limpar Widgets">
                                    <i class="bi bi-trash3 me-1"></i> Limpar
                                </button>
                            </div>
                        </div>

                        <!-- Área de Montagem do Canvas (Zona de Drop HTML5/Blazor) -->
                        <div class="card-body p-3 bg-light overflow-y-auto flex-grow-1 position-relative transition-all @(IsDragOverCanvas ? "border border-primary border-3 bg-primary-subtle" : "")"
                             id="biCanvasArea"
                             style="min-height: 480px;"
                             @ondragover="TratarDragOver"
                             @ondragover:preventDefault="true"
                             @ondrop="TratarDrop">

                            @if (IsDragOverCanvas)
                            {
                                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-white bg-opacity-75 z-3">
                                    <div class="p-3 bg-primary text-white rounded-4 shadow-lg text-center animate-bounce">
                                        <i class="bi bi-plus-circle fs-1 d-block mb-1"></i>
                                        <span class="fw-bold">Solte aqui para inserir no Canvas!</span>
                                    </div>
                                </div>
                            }

                            @if (IsCarregando)
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 p-5 text-muted">
                                    <div class="spinner-border text-primary mb-3" role="status"></div>
                                    <p class="fw-semibold mb-0">Carregando painel e configurações analíticas...</p>
                                </div>
                            }
                            else if (DashboardAtivo == null || !DashboardAtivo.Widgets.Any())
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 p-5 text-center text-muted border border-2 border-dashed rounded-4 bg-white m-2">
                                    <div class="display-3 text-primary opacity-25 mb-3">
                                        <i class="bi bi-grid-1x2"></i>
                                    </div>
                                    <h5 class="fw-bold text-dark">Canvas Vazio</h5>
                                    <p class="small text-muted mb-3" style="max-width: 440px;">
                                        Arraste um componente da barra esquerda, aplique um template pronto ou utilize o Agente de IA para gerar seus gráficos automaticamente.
                                    </p>
                                    <div class="d-flex gap-2 flex-wrap justify-content-center">
                                        <button class="btn btn-sm btn-primary rounded-3 px-3 shadow-sm" @onclick="() => AplicarTemplateAsync(1)">
                                            <i class="bi bi-speedometer2 me-1"></i> Template Executivo
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary rounded-3 px-3" @onclick="() => AplicarTemplateAsync(2)">
                                            <i class="bi bi-bar-chart-line me-1"></i> Template Operacional
                                        </button>
                                        <button class="btn btn-sm btn-outline-warning rounded-3 px-3 text-dark fw-semibold" @onclick="() => AplicarTemplateAsync(3)">
                                            <i class="bi bi-cpu me-1"></i> Template Mineração IA
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">
                                    @foreach (var widget in DashboardAtivo.Widgets)
                                    {
                                        <div class="@ObterClasseGridWidget(widget.LarguraColunas) transition-all" key="@widget.Id">
                                            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden widget-canvas-card bg-white position-relative hover-shadow @(WidgetSelecionado?.Id == widget.Id ? "ring-2 border-primary" : "")">
                                                <div class="card-header bg-white border-bottom py-2 px-3 d-flex align-items-center justify-content-between">
                                                    <div class="d-flex align-items-center gap-2 cursor-pointer" @onclick="() => SelecionarWidget(widget)">
                                                        <i class="bi bi-grip-vertical text-muted cursor-grab" title="Arrastar"></i>
                                                        <span class="fw-bold small text-dark">@widget.Titulo</span>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-1">
                                                        <button class="btn btn-xs btn-link text-muted p-0 me-1" @onclick="() => SelecionarWidget(widget)" title="Configurar Propriedades">
                                                            <i class="bi bi-gear-fill"></i>
                                                        </button>
                                                        <button class="btn btn-xs btn-link text-danger p-0" @onclick="() => RemoverWidget(widget.Id)" title="Excluir do Canvas">
                                                            <i class="bi bi-x-circle-fill"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="card-body p-3" style="min-height: 220px;" @onclick="() => SelecionarWidget(widget)">
                                                    <BIWidgetView Widget="widget" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </main>

                <!-- COLUNA DIREITA: Inspetor de Propriedades & Agente IA (Fase 4) -->
                <aside class="col-12 col-lg-3 d-flex flex-column">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden d-flex flex-column">
                        <div class="card-header bg-white border-bottom py-2 px-3 d-flex align-items-center justify-content-between">
                            <ul class="nav nav-pills card-header-pills gap-1">
                                <li class="nav-item">
                                    <button class="nav-link py-1 px-3 small rounded-3 @(AbaDireitaAtiva == "ia" ? "active" : "")"
                                            @onclick='() => AbaDireitaAtiva = "ia"'>
                                        <i class="bi bi-stars me-1 text-warning"></i> Consultor IA
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link py-1 px-3 small rounded-3 @(AbaDireitaAtiva == "propriedades" ? "active" : "")"
                                            @onclick='() => AbaDireitaAtiva = "propriedades"'>
                                        <i class="bi bi-sliders me-1"></i> Inspector
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <div class="card-body p-3 flex-grow-1 overflow-y-auto d-flex flex-column justify-content-between">
                            @if (AbaDireitaAtiva == "ia")
                            {
                                <!-- Painel do Agente de IA do BI (Fase 4 Conversacional) -->
                                <div class="d-flex flex-column h-100 justify-content-between">
                                    <div class="overflow-y-auto mb-2 flex-grow-1 pe-1" style="max-height: calc(100vh - 350px);">
                                        <div class="p-2 bg-gradient rounded-3 text-white mb-2"
                                             style="background: linear-gradient(135deg, #1e293b, #334155);">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="bi bi-robot fs-5 text-warning"></i>
                                                <span class="fw-bold small">Consultor Executivo BI</span>
                                            </div>
                                            <p class="small text-white-50 mb-0" style="font-size: 0.72rem;">
                                                Peça análises de dados, mineração K-Means, previsões ou comandos para criar gráficos no Canvas.
                                            </p>
                                        </div>

                                        <!-- Histórico do Chat -->
                                        <div class="d-flex flex-column gap-2 mb-2">
                                            @foreach (var msg in HistoricoChat)
                                            {
                                                <div class="p-2 rounded-3 small @(msg.Remetente == "Usuario" ? "bg-primary text-white ms-auto text-end" : "bg-light border text-dark me-auto")"
                                                     style="max-width: 90%; font-size: 0.78rem;">
                                                    <span class="d-block fw-bold mb-1" style="font-size: 0.68rem; opacity: 0.8;">
                                                        @(msg.Remetente == "Usuario" ? "Você" : "Consultor IA") • @msg.Horario.ToString("HH:mm")
                                                    </span>
                                                    <span>@msg.Texto</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Sugestões Rápidas de Comandos -->
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        <button class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.7rem;"
                                                @onclick='() => ExecutarPromptRapido("Crie um resumo executivo com KPIs de faturamento")'>
                                            + KPIs Vendas
                                        </button>
                                        <button class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.7rem;"
                                                @onclick='() => ExecutarPromptRapido("Execute clusterização K-Means dos clientes")'>
                                            + K-Means
                                        </button>
                                        <button class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.7rem;"
                                                @onclick='() => ExecutarPromptRapido("Calcule a curva ABC dos itens mais vendidos")'>
                                            + Curva ABC
                                        </button>
                                    </div>

                                    <!-- Campo de Entrada do Chat -->
                                    <div class="pt-2 border-top">
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control rounded-start-3"
                                                   placeholder="Instrua o Consultor de IA..."
                                                   @bind="PromptIaRapido"
                                                   @onkeyup="TratarEnterPromptIa" />
                                            <button class="btn btn-primary rounded-end-3 px-3" @onclick="EnviarInstrucaoIaAsync">
                                                <i class="bi bi-send-fill"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Painel de Propriedades do Widget Selecionado (Inspector) -->
                                @if (WidgetSelecionado == null)
                                {
                                    <div class="text-center text-muted p-4">
                                        <i class="bi bi-cursor fs-1 opacity-25 d-block mb-2"></i>
