@page "/configuracoes"
@using JT_Classes.Comum
@using JT_Classes.IA
@using JT_Classes.Gestao
@using JT_Classes.Portfolio
@using JT_Classes.Acessos
@using JT_UserInterface.Shared.Components.Core
@using JT_UserInterface.Shared.Components.IA
@using Microsoft.JSInterop
@inherits JT_UserInterface.Shared.Pages.Comum.ConfiguracoesBase

<div data-tutorial="configuracoes-pagina">
    @RenderizarFormularioConfiguracoes()
</div>

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    public override string ObterTituloPagina() => "Configurações do Sistema & BI";

    protected override async Task CarregarConfiguracoes()
    {
        Configuracao? configuracaoUsuario = null;
        if (UserState != null && UserState.Autenticado && UserState.UsuarioID > 0)
        {
            try
            {
                configuracaoUsuario = await ConfiguracaoServiceBase.GetByUsuarioIdAsync(UserState.UsuarioID);
            }
            catch (HttpRequestException ex)
            {
                Console.WriteLine($"[Configuracoes] Aviso: API retornou {(int?)ex.StatusCode} ao buscar configurações do usuário {UserState.UsuarioID}. Utilizando configuração padrão.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Configuracoes] Erro ao carregar configurações remotas do usuário: {ex.Message}");
            }
        }

        configuracaoAtual = configuracaoUsuario ?? CriarNovaConfiguracao();

        if (UserState != null && UserState.UsuarioID > 0)
        {
            configuracaoAtual.IdUsuario = UserState.UsuarioID;
        }

        await CarregarConfiguracoesModularesAsync();
    }

    protected override async Task<bool> SalvarConfiguracao(Configuracao configuracao)
    {
        try
        {
            return await base.SalvarConfiguracao(configuracao);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden || ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Console.WriteLine($"[Configuracoes] Aviso: Usuário sem permissão para persistir configuração comum global ({ex.StatusCode}). Prosseguindo com módulos específicos.");
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Configuracoes] Erro ao salvar configuração: {ex.Message}");
            return false;
        }
    }

    public override async Task HandleSalvarConfiguracoes()
    {
        if (configuracaoAtual == null) return;

        bool salvouAlgo = false;
        var erros = new List<string>();

        try
        {
            // 1. Tenta salvar a configuração base
            try
            {
                var okComum = await SalvarConfiguracao(configuracaoAtual);
                if (okComum) salvouAlgo = true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Configuracoes] Aviso ao salvar configuração comum: {ex.Message}");
            }

            // 2. Salva configurações modulares com isolamento por módulo
            foreach (var (modulo, configuracao) in ModuloState.Configuracoes)
            {
                if (modulo == JT_Aplicacao.Classes.eModuloSistema.Comum)
                    continue;

                try
                {
                    bool okModulo = false;
                    switch (modulo)
                    {
                        case JT_Aplicacao.Classes.eModuloSistema.IA:
                            var iaConfig = (ConfiguracaoIA)configuracao;
                            var iaService = ServiceProvider.GetRequiredService<JT_Servicos.IA.ConfiguracaoIAService>();
                            okModulo = await iaService.Save(iaConfig);

                            // Sincroniza também no localStorage para disponibilidade imediata e offline-first
                            try
                            {
                                if (!string.IsNullOrWhiteSpace(iaConfig.ApiKey))
                                {
                                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "jt_gemini_api_key", iaConfig.ApiKey);
                                }
                                if (!string.IsNullOrWhiteSpace(iaConfig.Modelo))
                                {
                                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "jt_gemini_model", iaConfig.Modelo);
                                }
                            }
                            catch { }
                            break;

                        case JT_Aplicacao.Classes.eModuloSistema.Hotkeys:
                            var hotkeysService = ServiceProvider.GetService<JT_Servicos.Comum.ConfiguracaoHotkeysService>();
                            if (hotkeysService != null)
                                okModulo = await hotkeysService.Save((ConfiguracaoHotkeys)configuracao);
                            break;

                        case JT_Aplicacao.Classes.eModuloSistema.Gestao:
                            var gestaoService = ServiceProvider.GetService<JT_Servicos.Interfaces.IMGestaoConfiguracaoService>();
                            if (gestaoService != null)
                                okModulo = await gestaoService.Save((MGestaoConfiguracao)configuracao);
                            break;

                        case JT_Aplicacao.Classes.eModuloSistema.Portfolio:
                            var portService = ServiceProvider.GetService<JT_Servicos.Interfaces.IMPortfolioConfiguracaoService>();
                            if (portService != null)
                                okModulo = await portService.Save((MPortfolioConfiguracoes)configuracao);
                            break;

                        case JT_Aplicacao.Classes.eModuloSistema.Acessos:
                            var acessosService = ServiceProvider.GetService<JT_Servicos.Interfaces.IMAcessosConfiguracaoService>();
                            if (acessosService != null)
                                okModulo = await acessosService.Save((MAcessosConfiguracao)configuracao);
                            break;

                        default:
                            okModulo = true;
                            break;
                    }

                    if (okModulo) salvouAlgo = true;
                }
                catch (HttpRequestException ex)
                {
                    Console.WriteLine($"[Configuracoes] Aviso: API retornou {(int?)ex.StatusCode} para o módulo {modulo}: {ex.Message}");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Configuracoes] Falha ao salvar módulo {modulo}: {ex.Message}");
                    erros.Add($"{modulo}: {ex.Message}");
                }
            }

            // 3. Executa delegates adicionais (se houver)
            await DispararSalvarConfiguracoesAdicionaisAsync();

            if (salvouAlgo || erros.Count == 0)
            {
                ToastService.ShowSuccess("Configurações Salvas!", "As suas configurações foram atualizadas com sucesso.");
            }
            else
            {
                ToastService.ShowError("Erro ao Salvar", "Não foi possível persistir algumas configurações no servidor.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro Inesperado!", $"Ocorreu um problema ao salvar: {ex.Message}");
        }
    }

    public override RenderFragment? TabsAdicionais => builder =>
    {
        // Fallback defensivo: se a aba de IA padrão não constar entre as abas injetadas, renderiza-a diretamente
        if (InjectedTabs == null || !InjectedTabs.Any(t => t.Modulo == JT_Aplicacao.Classes.eModuloSistema.IA))
        {
            builder.OpenComponent<TabPage>(0);
            builder.AddAttribute(1, "Title", "Inteligência Artificial (Gemini)");
            builder.AddAttribute(2, "ChildContent", (RenderFragment)(content =>
            {
                content.OpenComponent<IAConfigTab>(10);
                content.CloseComponent();
            }));
            builder.CloseComponent();
        }
    };
}

