<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CDN & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Estilos do Ecossistema Compartilhado JT_UserInterface.Shared -->
    <link rel="stylesheet" href="_content/JT_UserInterface.Shared/app.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="JT_BI.styles.css" />

    <style>
        .hover-shadow:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
        }
        .transition-all {
            transition: all 0.2s ease-in-out;
        }
        .spin {
            animation: spin 3s linear infinite;
        }
        @@keyframes spin {
            100% { transform: rotate(360deg); }
        }
    </style>
    <ImportMap />
    <link rel="icon" type="image/png" href="_content/JT_UserInterface.Shared/favicon.png" />
    <HeadOutlet />
</head>

<body>
    <JT_BI.Components.Routes @rendermode="InteractiveServer" />
    <ReconnectModal />

    <script>
        // Suprime ruídos de promessas rejeitadas de extensões do navegador (ex: Cuponomia, extensões de cupons/cashback)
        // que fecham portas de comunicação em background e emitem 'A listener indicated an asynchronous response...'
        window.addEventListener('unhandledrejection', function (event) {
            var msg = event && event.reason && (event.reason.message || event.reason.toString());
            if (typeof msg === 'string' && (
                msg.includes('message channel closed') ||
                msg.includes('A listener indicated an asynchronous response') ||
                msg.includes('cuponomia')
            )) {
                event.preventDefault();
            }
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_content/JT_UserInterface.Shared/js/blazorInterop.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>