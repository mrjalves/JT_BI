@inherits LayoutComponentBase
@using JT_BI.Services
@using JT_Classes.Acessos
@inject PublicViewState ViewState
@inject CurrentUserState CurrentUserState
@inject NavigationManager Nav
@implements IDisposable

<div class="public-shell @(ViewState.IsModoEscuro ? "theme-dark bg-dark text-white" : "theme-light bg-light text-dark")" data-bs-theme="@(ViewState.IsModoEscuro ? "dark" : "light")" style="height: 100vh; height: 100dvh; max-height: 100vh; max-height: 100dvh; overflow-y: auto !important; overflow-x: hidden !important; -webkit-overflow-scrolling: touch;">
    <div class="public-layout @(ViewState.ExibirMenu ? "has-sidebar" : "no-sidebar")">
        @if (ViewState.ExibirMenu)
        {
            <aside class="public-sidebar @(menuMobileAberto ? "mobile-open" : "")">
                <NavMenu />
            </aside>
            @if (menuMobileAberto)
            {
                <div class="sidebar-backdrop d-md-none" @onclick="ToggleMobileMenu"></div>
            }
        }

        <div class="public-main-content">
            <!-- Header padrão da User Interface com identidade visual, tema e botão de login -->
            <header class="public-header @(ViewState.IsModoEscuro ? "bg-dark-header border-secondary-subtle" : "bg-white border-light-subtle")">
                <div class="public-header-start d-flex align-items-center gap-2 gap-sm-3">
                    @if (ViewState.ExibirMenu)
                    {
                        <button class="btn btn-sm btn-outline-secondary d-md-none rounded-3 px-2 py-1" type="button" @onclick="ToggleMobileMenu" title="Menu de Navegação">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                    }

                    <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
                        <div class="p-2 bg-gradient bg-primary text-white rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px;">
                            <i class="bi @ViewState.Icone"></i>
                        </div>
                        <span class="fw-bold fs-6 d-none d-sm-inline @(ViewState.IsModoEscuro ? "text-white" : "text-dark")">JT_BI</span>
                    </a>

                    <div class="vr d-none d-sm-block opacity-25" style="height: 22px;"></div>

                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small d-none d-md-inline-flex align-items-center gap-1">
                            <i class="bi bi-share-fill"></i> Painel Compartilhado
                        </span>
                        <h6 class="mb-0 fw-bold text-truncate @(ViewState.IsModoEscuro ? "text-white" : "text-dark")" style="max-width: clamp(120px, 40vw, 360px);" title="@ViewState.Titulo">
                            @ViewState.Titulo
                        </h6>
                    </div>
                </div>

                <div class="public-header-end d-flex align-items-center gap-2 ms-auto">
                    @if (ViewState.AutoRefreshSegundos > 0)
                    {
                        <span class="badge @(ViewState.IsModoEscuro ? "bg-secondary text-light" : "bg-light text-dark border") rounded-pill px-2 py-1 small d-none d-md-inline-flex align-items-center gap-1" title="Atualização automática em andamento">
                            <i class="bi bi-arrow-repeat spin"></i> @ViewState.ContadorRefresh s
                        </span>
                    }

                    <!-- Alternador de Tema Claro / Escuro -->
                    <button type="button" class="btn btn-sm @(ViewState.IsModoEscuro ? "btn-outline-light" : "btn-outline-secondary") rounded-3 px-2 py-1" @onclick="ViewState.AlternarTema" title="@(ViewState.IsModoEscuro ? "Mudar para Modo Claro" : "Mudar para Modo Escuro")">
                        <i class="bi @(ViewState.IsModoEscuro ? "bi-sun-fill text-warning" : "bi-moon-stars-fill")"></i>
                    </button>

                    <!-- Botão de Login substituindo o antigo link 'About' -->
                    @if (CurrentUserState.Autenticado)
                    {
                        <div class="d-flex align-items-center gap-2 ps-2 border-start @(ViewState.IsModoEscuro ? "border-secondary" : "border-light")">
                            <div class="d-none d-lg-flex flex-column text-end lh-1">
                                <span class="fw-semibold small @(ViewState.IsModoEscuro ? "text-white" : "text-dark")">@CurrentUserState.UsuarioName</span>
                                <small class="text-muted" style="font-size: 0.7rem;">Autenticado</small>
                            </div>
                            <a href="/dashboards" class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center gap-1 text-decoration-none" title="Ir para o Hub de Dashboards">
                                <i class="bi bi-grid-fill"></i>
                                <span class="d-none d-sm-inline">Central</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <a href="@ObterUrlLogin()" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1 text-decoration-none" title="Acessar com credenciais de usuário">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span class="fw-semibold">Entrar</span>
                        </a>
                    }
                </div>
            </header>

            <!-- Conteúdo da Página Compartilhada -->
            <main class="public-content">
                @Body
            </main>
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">×</span>
</div>

@code {
    private bool menuMobileAberto = false;

    protected override void OnInitialized()
    {
        ViewState.OnChange += AtualizarLayout;
    }

    private void AtualizarLayout()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMobileMenu()
    {
        menuMobileAberto = !menuMobileAberto;
    }

    private string ObterUrlLogin()
    {
        var uriAtual = Nav.Uri;
        var relative = Nav.ToBaseRelativePath(uriAtual);
        if (string.IsNullOrWhiteSpace(relative))
            return "/login";

        return $"/login?returnUrl={Uri.EscapeDataString("/" + relative)}";
    }

    public void Dispose()
    {
        ViewState.OnChange -= AtualizarLayout;
    }
}
